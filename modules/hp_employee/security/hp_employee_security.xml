<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- Security Groups -->
        <record id="group_hr_team_manager" model="res.groups">
            <field name="name">HR Team Manager</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

        <record id="group_hr_director" model="res.groups">
            <field name="name">HR Director</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_team_manager'))]"/>
        </record>

        <!-- Record Rule: HR Directors - Full access to employees in their branch -->
        <record id="hr_employee_hr_director_own_branch_rule" model="ir.rule">
            <field name="name">HR Directors: Full Access to Employees in Own Branch</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">[('department_id.branch_id', '=', user.employee_id.department_id.branch_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_director'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Record Rule: HR Team Managers - Full access to employees in their branch -->
        <record id="hr_employee_hr_team_manager_own_branch_rule" model="ir.rule">
            <field name="name">HR Team Managers: Full Access to Employees in Own Branch</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">[('department_id.branch_id', '=', user.employee_id.department_id.branch_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_team_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Record Rule: HR Members - Manage employees in their branch -->
        <record id="hr_employee_hr_user_own_branch_rule" model="ir.rule">
            <field name="name">HR Users: Manage Employees in Own Branch</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">[('department_id.branch_id', '=', user.employee_id.department_id.branch_id.id)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Record Rule: All users can read employees from other branches -->
        <record id="hr_employee_all_users_other_branches_rule" model="ir.rule">
            <field name="name">All Users: Read Employees from Other Branches</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">['|', ('department_id.branch_id', '=', False), ('department_id.branch_id', '!=', user.employee_id.department_id.branch_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>
