<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="dep_sales_hn" model="hr.department">
            <field name="name">Sales HN</field>
            <field name="color" eval="5"/>
            <field name="branch_id" ref="branch_hn" />
            <field name="department_type_id" ref="hp_components.department_type_sale" />
            <field name="manager_id" ref="emp_dos_hn" />
        </record>

        <record id="user_dos_hn" model="res.users">
            <field name="name">DOS HN</field>
            <field name="login">dos_hn@test.com</field>
            <field name="password">123456</field>
            <field name="groups_id" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        </record>
        <record id="emp_dos_hn" model="hr.employee">
            <field name="name">DOS HN</field>
            <field name="job_title">Sale Director HN</field>
            <field name="user_id" ref="user_dos_hn"/>
            <field name="work_email">dos_hn@test.com</field>
            <field name="department_id" ref="dep_sales_hn" />
        </record>

        <record forcecreate="True" id="user_sm1_hn" model="res.users">
            <field name="name">Sale member 1 HN</field>
            <field name="login">sm1_hn@test.com</field>
            <field name="password">123456</field>
            <field name="groups_id" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>
        <record id="emp_sm1_hn" model="hr.employee">
            <field name="name">Sale member 1 HN</field>
            <field name="job_title">Sale</field>
            <field name="user_id" ref="user_sm1_hn"/>
            <field name="parent_id" ref="emp_dos_hn"/>
            <field name="coach_id" ref="emp_dos_hn"/>
            <field name="work_email">sm1_hn@test.com</field>
            <field name="department_id" ref="dep_sales_hn" />
        </record>

        <record forcecreate="True" id="user_sm2_hn" model="res.users">
            <field name="name">Sale member 2 HN</field>
            <field name="login">sm2_hn@test.com</field>
            <field name="password">123456</field>
            <field name="groups_id" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>
        <record id="emp_sm2_hn" model="hr.employee">
            <field name="name">Sale member 2</field>
            <field name="job_title">Sale</field>
            <field name="user_id" ref="user_sm2_hn"/>
            <field name="parent_id" ref="emp_dos_hn"/>
            <field name="coach_id" ref="emp_dos_hn"/>
            <field name="work_email">sm2@test.com</field>
            <field name="department_id" ref="dep_sales_hn" />
        </record>

    </data>
</odoo>
