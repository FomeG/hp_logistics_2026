<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="add_department_type_to_view_department_form" model="ir.ui.view">
        <field name="name">add.department.type.to.view.department.form</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form" />
        <field name="arch" type="xml">
            <xpath expr="//group/group/field[@name='name']" position="replace">
                <field name="department_type_id" required="1" />
            </xpath>
            <xpath expr="//group/group/field[@name='manager_id']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//group/group/field[@name='department_type_id']" position="after">
                <field name="branch_id" required="1" options="{'no_create': True, 'no_edit': True}" />
            </xpath>
        </field>
    </record>

    <record id="add_department_type_to_view_department_list" model="ir.ui.view">
        <field name="name">add.department.type.to.view.department.list</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_tree" />
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='name']" position="after">
                <field name="department_type_id"/>
            </xpath>
        </field>
    </record>

    <record id="add_department_type_to_view_department_kanban" model="ir.ui.view">
        <field name="name">add.department.type.to.view.department.kanban</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.hr_department_view_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='card']/a/field[@name='name']" position="after">
                <field name="department_type_id" class="text-muted small ms-2" />
            </xpath>
        </field>
    </record>

    <record id="add_department_type_to_view_department_filter" model="ir.ui.view">
        <field name="name">add.department.type.to.view.department.filter</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_filter" />
        <field name="arch" type="xml">
            <xpath expr="//search/filter[@name='inactive']" position="after">
                <filter string="Sale" name="sale"
                    domain="[('department_type_id.code','=','sale')]" />
                <filter string="Pricing" name="pricing"
                    domain="[('department_type_id.code','=','pricing')]" />
                <filter string="Trucking" name="trucking"
                    domain="[('department_type_id.code','=','trucking')]" />
                <filter string="Customer Service" name="cs"
                    domain="[('department_type_id.code','=','cs')]" />
            </xpath>
        </field>
    </record>
</odoo>