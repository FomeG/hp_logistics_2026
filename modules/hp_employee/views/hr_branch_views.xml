<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_branch_tree_view" model="ir.ui.view">
        <field name="name">hr.branch.tree</field>
        <field name="model">hr.branch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="branch_prefix" />
                <field name="create_date" />
            </list>
        </field>
    </record>
    <record id="hr_branch_form_view" model="ir.ui.view">
        <field name="name">hr.branch</field>
        <field name="model">hr.branch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="branch_prefix" />
                    </group>
                    <notebook>
                        <page string="Departments" invisible="not id">
                            <field name="department_ids" readonly="1" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="hr_branch_form_search" model="ir.ui.view">
        <field name="name">hr.branch.search</field>
        <field name="model">hr.branch</field>
        <field name="arch" type="xml">
            <search string="List Branchs">
                <field name="name" />
                <field name="branch_prefix" />
            </search>
        </field>
    </record>

    <record id="hr_branch_action" model="ir.actions.act_window">
        <field name="name">branches</field>
        <field name="res_model">hr.branch</field>
        <field name="search_view_id" ref="hr_branch_form_search" />
        <field name="view_mode">list,form</field>
    </record>
</odoo>