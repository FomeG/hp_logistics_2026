<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hr_employee_action_create_user_full" model="ir.ui.view">
        <field name="name">hr.employee.action.create.user.full</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='hr_settings']/group/group[@name='active_group']/div" position="replace">
                <div class="o_row">
                    <field name="user_id"
                        string="Related User"
                        help=""
                        domain="[('company_ids', 'in', company_id), ('share', '=', False)]"
                        context="{'default_create_employee_id': id}"
                        widget="many2one_avatar_user" />
                    <button string="Create User"
                        class="btn btn-link"
                        type="object"
                        name="action_create_user_full"
                        invisible="user_id" />
                </div>
            </xpath>
            <xpath expr="//group/field[@name='coach_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group/field[@name='parent_id']" position="replace">
                <field name="dept_manager_id" readonly="1" />
            </xpath>

            <!-- Restrict department selection to same branch as current user -->
            <xpath expr="//field[@name='department_id']" position="before">
                <field name="current_user_branch_id" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='department_id']" position="attributes">
                <attribute name="domain">[('branch_id', '=', current_user_branch_id)]</attribute>
                <attribute name="groups">!base.group_system</attribute> 
            </xpath>
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="department_id" 
                    string="Department" 
                    groups="base.group_system"/>
            </xpath>

        </field>
    </record>
</odoo>