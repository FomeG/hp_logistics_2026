<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_active_employee" model="ir.actions.server">
        <field name="name">Active</field>
        <field name="model_id" ref="model_hr_employee" />
        <field name="binding_model_id" ref="hr.model_hr_employee" />
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">model.action_active()</field>
    </record>
    <record id="action_inactive_employee" model="ir.actions.server">
        <field name="name">Inactive</field>
        <field name="model_id" ref="model_hr_employee" />
        <field name="binding_model_id" ref="hr.model_hr_employee" />
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">model.action_inactive()</field>
    </record>
</odoo>