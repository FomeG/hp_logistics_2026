<odoo>
    <!-- Inherit Search View for Users - Add Department Filter -->
    <record id="view_res_users_search_inherit_team" model="ir.ui.view">
        <field name="name">res.users.search.inherit.team</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_search"/>
        <field name="arch" type="xml">
            <search position="inside">
                <filter name="team_department"
                        string="Team Department"
                        domain="[('employee_ids.department_id', '=', context.get('team_department_id'))]"/>
            </search>
        </field>
    </record>

    <!-- List View -->
    <record id="view_hr_team_list" model="ir.ui.view">
        <field name="name">hr.team.list</field>
        <field name="model">hr.team</field>
        <field name="arch" type="xml">
            <list string="Teams">
                <field name="name"/>
                <field name="department_id"/>
                 <!-- <field name="region_id"/> -->
                <field name="user_ids" widget="many2many_tags"/>
                <field name="location_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hr_team_form" model="ir.ui.view">
        <field name="name">hr.team.form</field>
        <field name="model">hr.team</field>
        <field name="arch" type="xml">
            <form string="Team">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="is_department_required" invisible="True"/>
                        <field name="allowed_department_ids" invisible="True"/>
                        <field name="department_id"
                               domain="[('id', 'in', allowed_department_ids)]"
                               options="{'no_create': True}"
                               required="is_department_required"
                               readonly="id"/>
                        <!-- <field name="region_id"/> -->
                    </group>

                    <notebook>
                        <page string="Users" invisible="not id">
                            <field name="user_ids"
                                   context="{'team_department_id': department_id, 'search_default_team_department': 1}">
                                <list string="Members">
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="user_department_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ports" invisible="department_type_code != 'sale' or not region_id">
                            <field name="location_ids"
                                   domain="[('type', '=', 'port'), ('country_id.region_id', '=', region_id)]">
                                <list string="Ports">
                                    <field name="name"/>
                                    <field name="country_id"/>
                                    <!-- <field name="region_id"/> -->
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hr_team_search" model="ir.ui.view">
        <field name="name">hr.team.search</field>
        <field name="model">hr.team</field>
        <field name="arch" type="xml">
            <search string="Search HR Teams">
                <field name="name" string="Team Name"/>
                <field name="department_id" string="Department"/>
                <filter name="department_type_sale"
                    string="Sale"
                    domain="[('department_id.department_type_id.code', '=', 'sale')]"/>

                <group expand="0" string="Group By">
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_region" string="Region" context="{'group_by': 'region_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="hr_team_action" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">hr.team</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('department_id.department_type_id.code', '=', 'sale')]</field>
        <field name="search_view_id" ref="view_hr_team_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_hr_team_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_hr_team_form')})]"/>
    </record>
</odoo>
