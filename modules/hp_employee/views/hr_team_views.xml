<odoo>
    <!-- List View -->
    <record id="view_hr_team_list" model="ir.ui.view">
        <field name="name">hr.team.list</field>
        <field name="model">hr.team</field>
        <field name="arch" type="xml">
            <list string="Teams">
                <field name="name"/>
                <field name="department_id"/>
                <field name="user_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hr_team_form" model="ir.ui.view">
        <field name="name">hr.team.form</field>
        <field name="model">hr.team</field>
        <field name="arch" type="xml">
            <form string="Team">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="department_id"/>
                    </group>
                    <group>
                        <field name="user_ids"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hr_team_search" model="ir.ui.view">
        <field name="name">hr.team.search</field>
        <field name="model">hr.team</field>
        <field name="arch" type="xml">
            <search string="Search HR Teams">
                <field name="name" string="Team Name"/>
                <field name="department_id" string="Department"/>
                <filter name="department_type_sale"
                    string="Sale"
                    domain="[('department_id.department_type_id.code', '=', 'sale')]"/>

                <filter name="group_department" string="By Department" context="{'group_by':'department_id'}"/>
                <group expand="0" string="Group By">
                    <filter name="group_department_2" string="Department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="hr_team_action" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">hr.team</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_team_search"/>
    </record>
</odoo>
