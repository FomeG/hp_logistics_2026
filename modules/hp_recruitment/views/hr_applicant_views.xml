<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_candidate_view_form_inherit_attachments" model="ir.ui.view">
        <field name="name">hr.candidate.view.form.inherit.attachments</field>
        <field name="model">hr.candidate</field>
        <field name="inherit_id" ref="hr_recruitment.hr_candidate_view_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Attachments" name="attachments">
                    <field name="attachment_ids" widget="many2many_binary" nolabel="1" />
                </page>
            </notebook>

            <xpath expr="//chatter" position="replace">
                <chatter />
            </xpath>
        </field>
    </record>
</odoo>