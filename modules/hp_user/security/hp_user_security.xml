<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_category_hp_user_root" model="ir.module.category">
        <field name="name">User Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_hp_user_admin" model="res.groups">
        <field name="name">Administration</field>
        <field name="category_id" ref="group_category_hp_user_root" />
    </record>

    <record id="group_hp_user_normal" model="res.groups">
        <field name="name">Normal User</field>
        <field name="category_id" ref="group_category_hp_user_root" />
        <field name="implied_ids" eval="[(4, ref('group_hp_user_admin'))]" />
    </record>
</odoo>