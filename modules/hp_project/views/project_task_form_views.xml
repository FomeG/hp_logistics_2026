<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_task_form_inherit_hide_sale_line" model="ir.ui.view">
        <field name="name">project.task.form.inherit.hide.sale.line</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="sale_project.view_sale_project_inherit_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_line_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='sale_line_div']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='sale_line_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="hp_project_task_form_view_inherit" model="ir.ui.view">
        <field name="name">project.task.view.task.form.inherit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath expr="//group/field[@name='user_ids']" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_user_ids)]</attribute>
            </xpath>
            <xpath expr="//notebook/page[@name='task_dependencies']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//notebook/page[@name='extra_info']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//notebook/page[@name='sub_tasks_page']" position="attributes">
                <attribute name="invisible">is_project_pricing == True</attribute>
            </xpath>
            <xpath expr="//group/field[@name='tag_ids']" position="after">
                <field name="start_time" />
            </xpath>
            <xpath expr="//group/field[@name='tag_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group/field[@name='milestone_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group/field[@name='active']" position="after">
                <field name="date_assign" />
            </xpath>
            <xpath expr="//group/field[@name='allocated_hours']" position="after">
                <field name="end_time" />
            </xpath>
            <xpath expr="//h1/div/field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='task_properties']" position="after">
                <!-- Group request create product with POD/POL -->
                <group string='POD/POL Request' name="pod_pol_request_group" invisible="project_type != 'request_product'">
                    <group>
                        <label for="sale_order_id" />
                        <div class="o_row">
                            <field name="sale_order_id" string="Quotation"
                                domain="[('state', '=', 'draft')]" readonly="1" />
                            <button name="action_show_sale_order_detail"
                                string="Show Detail"
                                type="object"
                                class="btn btn-link"
                                invisible="not sale_order_id" />
                        </div>
                        <field name="pod_name_request" string="POD Name" />
                        <field name="pol_name_request" string="POL Name" />
                        <field name="container_type_id" string="Container Type" readonly="1" />
                        <button name="action_approve_pod_pol"
                            type="object"
                            string="Approve POD/POL"
                            class="btn btn-success"
                            style="width: 160px;"
                            invisible="is_done" />
                    </group>
                    <group>
                        <field name="etd" string="ETD" />
                        <field name="region_pod_id" string="Region POD" />
                        <field name="region_pol_id" string="Region POL" />
                    </group>
                    <h3 class="text-success" invisible="not is_done">
                        <i class="fa fa-check" />Approved POD/POL </h3>
                </group>

                <!-- Group request price for product -->
                <group string='Price' name="price_request_group" invisible="project_type != 'request_price'">
                    <label for="sale_order_id" />
                    <div class="o_row">
                        <field name="sale_order_id" string="Sale Quotation" readonly="1" />
                        <button name="action_show_sale_order_detail"
                            string="Show Detail"
                            type="object"
                            class="btn btn-link"
                            invisible="not sale_order_id" />
                    </div>
                    <label for="product_template_id" />
                    <div class="o_row">
                        <field name="product_template_id" string="Product" readonly="1" />
                        <button name="action_show_product_detail"
                            string="Show Detail"
                            type="object"
                            class="btn btn-link"
                            invisible="not product_template_id" />
                    </div>
                    <field name="container_type_id" string="Container Type" readonly="1" />
                    <field name="etd" string="ETD" />
                    <label for="quotation_id" />
                    <div class="o_row">
                        <field name="quotation_id"
                            string="Pricing Quotation"
                            help=""
                            domain="[('create_uid', '=', uid)]"
                            context="{'default_project_task_id': id}"
                            readonly="1"
                        />
                        <button string="Create New"
                            class="btn btn-link"
                            type="object"
                            name="action_create_pricing_quotation"
                            invisible="quotation_id" />

                        <button name="action_pricing_quotation_detail"
                            string="Show Detail"
                            type="object"
                            class="btn btn-link"
                            invisible="not quotation_id" />
                    </div>

                    <button name="action_approve_price"
                        type="object"
                        string="Approve Price"
                        class="btn btn-success"
                        invisible="is_done" />

                    <h3 class="text-success" invisible="not is_done">
                        <i class="fa fa-check" /> Approved Price </h3>
                </group>

                <!-- Group for Approval Tasks for Sale Leader -->
                <group string='Quotation Approval' name="quotation_approval_group" invisible="project_type != 'approve_quotation'">
                    <label for="sale_order_id" />
                    <div class="o_row">
                        <field name="sale_order_id" string="Sale Quotation" readonly="1" />
                        <button name="action_show_sale_order_detail"
                            string="Show Detail"
                            type="object"
                            class="btn btn-link"
                            invisible="not sale_order_id" />
                    </div>
                    <field name="rejection_reason" placeholder="Enter reason if not approving..."
                        invisible="is_done" />
                    <div>
                        <button name="action_sale_leader_approve"
                            type="object"
                            string="Approve"
                            class="btn btn-success p-2"
                            invisible="is_done" />
                        <button name="action_sale_leader_reject"
                            type="object"
                            string="Reject"
                            class="btn btn-danger p-2"
                            invisible="is_done" />
                        <h3 class="text-success"
                            invisible="not is_done">
                            <i class="fa fa-check" /> Approved Quotation </h3>
                    </div>
                </group>

                <!-- Group assign booking for Pricing Leader-->
                <group string='Assign Booking' name="assign_booking_group" invisible="project_type != 'assign_booking'">
                    <label for="sale_order_id" />
                    <div class="o_row">
                        <field name="sale_order_id" string="Sale Quotation" readonly="1" />
                        <button name="action_show_sale_order_detail"
                            string="Show Detail"
                            type="object"
                            class="btn btn-link"
                            invisible="not sale_order_id" />
                    </div>
                    <label for="sale_line_id" />
                    <div class="o_row">
                        <field name="sale_line_id" readonly="1" />
                        <button name="action_show_sale_order_line_detail"
                            string="Show Detail"
                            type="object"
                            class="btn btn-link"
                            invisible="not sale_line_id" />
                    </div>
                    <field name="container_type_id" string="Container Type" readonly="1" />
                    <label for="quotation_id" />
                    <div class="o_row">
                        <field name="quotation_id" string="Pricing Quotation" readonly="1" />
                        <button name="action_pricing_quotation_detail"
                            string="Show Detail"
                            type="object"
                            class="btn btn-link"
                            invisible="not quotation_id" />
                    </div>
                    <label for="booking_id" />
                    <div class="o_row">
                        <field name="booking_id"
                            string="Pricing Booking"
                            help=""
                            context="{'default_project_task_id': id}"
                            readonly="1"
                        />
                        <button string="Create New"
                            class="btn btn-link"
                            type="object"
                            name="action_create_pricing_booking"
                            invisible="booking_id" />

                        <button string="Show Detail"
                            class="btn btn-link"
                            type="object"
                            name="action_show_pricing_booking"
                            invisible="not booking_id" />
                        
                    </div>
                    <div>
                        <button name="action_pricing_assign_booking"
                            type="object"
                            string="Approve"
                            class="btn btn-success"
                            invisible="is_done" />
                        <h3 class="text-success"
                            invisible="not is_done">
                            <i class="fa fa-check" /> Assigned Booking </h3>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>