<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

    <record id="view_partner_shipping_line_form" model="ir.ui.view">
        <field name="name">res.partner.shipping.line.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

    <!-- Ẩn toàn bộ group gốc khi là Shipping Line -->
            <xpath expr="//sheet/group" position="attributes">
                <attribute name="invisible">is_shipping_line</attribute>
            </xpath>
            <xpath expr="//sheet/notebook" position="attributes">
                <attribute name="invisible">is_shipping_line</attribute>
            </xpath>
            <xpath expr="//div[hasclass('oe_title') and hasclass('mb24')]" position="attributes">
                <attribute name="invisible">is_shipping_line</attribute>
            </xpath>

            <!-- Thêm group riêng cho Shipping Line -->
            <xpath expr="//sheet" position="inside">
                <group name="shipping_line_info" invisible="not is_shipping_line" string="Shipping Line Information">                    
                    <field name="name" string="Shipping Line Name" placeholder="e.g. Global Shipping Co." required="1"/>
                    <field name="email" string="Shipping Line Email" widget="email" placeholder="e.g. contact@shippingline.com" required="1"/>
                    <field name="partner_main_type_id" invisible="1"/>
                </group>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="replace">
                <div class="oe_button_box" name="button_box">
                    <!-- add your custom buttons here -->
                </div>
            </xpath>
        </field>
    </record>
        <!-- Shipping Line List View -->
    <record id="hp_components_shipping_line_list_view" model="ir.ui.view">
        <field name="name">hp.components.shipping.line.list</field>
        <field name="model">res.partner</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Shipping Lines">
                <field name="name" string="Shipping Line Name"/>
                <field name="email" string="Shipping Line Email"/>
                <field name="phone" string="Phone"/>
                <field name="website" string="Website"/>
                <field name="create_date" string="Created Date"/>
            </list>
        </field>
    </record>

    <!-- Shipping Line Search View -->
    <record id="hp_components_shipping_line_search_view" model="ir.ui.view">
        <field name="name">hp.components.shipping.line.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Shipping Lines">
                <field name="name" string="Shipping Line Name"/>
                <field name="email" string="Shipping Line Email"/>
                <field name="phone" string="Phone"/>

                <!-- Group By -->
                <separator string="Group By"/>
                <group expand="1" string="Group By">
                    <filter string="Created Date" name="group_by_created"
                            context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Shipping Line Action -->
    <record id="hp_components_shipping_line_action" model="ir.actions.act_window">
        <field name="name">Shipping Lines</field>
        <field name="view_mode">list,form</field>
        <field name="res_model">res.partner</field>
        <field name="domain">[('partner_main_type_id.code', '=', 'shipping_line')]</field>
        <field name="context" eval="{'default_partner_main_type_id': ref('hp_components.partner_main_type_shipping_line'), 'default_is_company': True}"/>
        <field name="search_view_id" ref="hp_components_shipping_line_search_view"/>
        <field name="views" eval="[
            (ref('hp_components_shipping_line_list_view'), 'list'),
            (ref('view_partner_shipping_line_form'), 'form'),
        ]"/>
    </record>

    </data>
</odoo>