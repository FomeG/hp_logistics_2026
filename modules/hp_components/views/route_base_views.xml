<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="route_base_form_view" model="ir.ui.view">
        <field name="name">route.base.form</field>
        <field name="model">route.base</field>
        <field name="arch" type="xml">
            <form string="Route">
                <sheet>
                    <group>
                        <field name="name" required="1" />
                        <field name="from_location_id" required="1"
                            widget="many2one_new_tab" />
                        <field name="to_location_id" required="1" invisible="not from_location_id"
                            widget="many2one_new_tab" />
                        <field name="direction" required="1" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="route_base_list_view" model="ir.ui.view">
        <field name="name">route.base.list</field>
        <field name="model">route.base</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="List Routes">
                <field name="name" />
                <field name="from_location_id" />
                <field name="to_location_id" />
            </list>
        </field>
    </record>

    <record id="route_base_search_view" model="ir.ui.view">
        <field name="name">route.base.search</field>
        <field name="model">route.base</field>
        <field name="arch" type="xml">
            <search string="List Routes">
                <field name="name" />
                <field name="from_location_id" />
                <field name="to_location_id" />
                <!-- Group By -->
                <separator string="Group By"/>
                <group expand="1" string="Group By">
                    <filter string="POL" name="group_by_pol" context="{'group_by': 'from_location_id'}"/>
                    <filter string="POD" name="group_by_pod" context="{'group_by': 'to_location_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_route_base" model="ir.actions.act_window">
        <field name="name">Route</field>
        <field name="res_model">route.base</field>
        <field name="search_view_id" ref="route_base_search_view" />
        <field name="view_id" ref="route_base_list_view" />
        <field name="view_mode">list,form</field>
    </record>
</odoo>