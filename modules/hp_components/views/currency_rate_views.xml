<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_currency_rate_list" model="ir.ui.view">
        <field name="name">currency.rate.list</field>
        <field name="model">currency.rate</field>
        <field name="arch" type="xml">
            <list string="Exchange Rates" editable="bottom">
                <field name="date"/>
                <field name="currency_id"/>
                <field name="rate"/>
                <field name="inverse_rate"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <!-- Currency Rate Form View -->
    <record id="view_currency_rate_form" model="ir.ui.view">
        <field name="name">currency.rate.form</field>
        <field name="model">currency.rate</field>
        <field name="arch" type="xml">
            <form string="Exchange Rate">
                <sheet>
                    <group>
                        <group>
                            <field name="currency_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="rate"/>
                            <field name="inverse_rate"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Additional notes about this rate..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Currency Rate Search View -->
    <record id="view_currency_rate_search" model="ir.ui.view">
        <field name="name">currency.rate.search</field>
        <field name="model">currency.rate</field>
        <field name="arch" type="xml">
            <search string="Search Exchange Rates">
                <field name="currency_id"/>

                <field name="date"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Today" name="today"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Currency" name="group_currency" context="{'group_by': 'currency_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_currency_rate" model="ir.actions.act_window">
        <field name="name">Exchange Rates</field>
        <field name="res_model">currency.rate</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_this_month': 1}</field>
    </record>
</odoo>