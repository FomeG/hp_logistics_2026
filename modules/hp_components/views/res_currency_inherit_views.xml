<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_currency_tree_inherit_hpl" model="ir.ui.view">
        <field name="name">res.currency.tree.inherit.hpl</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='active']" position="after">
                <field name="is_base_currency"/>
            </xpath>
        </field>
    </record>

    <record id="view_currency_form_inherit_hpl" model="ir.ui.view">
        <field name="name">res.currency.form.inherit.hpl</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                 <field name="is_base_currency"/>
            </xpath>
        </field>
    </record>
</odoo>