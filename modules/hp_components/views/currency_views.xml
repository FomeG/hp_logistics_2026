<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Currency List View -->
    <record id="view_currency_list" model="ir.ui.view">
        <field name="name">currency.list</field>
        <field name="model">currency</field>
        <field name="arch" type="xml">
            <list string="Currencies">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="symbol"/>
                <field name="is_base_currency"/>
                <field name="current_rate" string="Current Rate"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Currency Form View -->
    <record id="view_currency_form" model="ir.ui.view">
        <field name="name">currency.form</field>
        <field name="model">currency</field>
        <field name="arch" type="xml">
            <form string="Currency">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g., US Dollar"/>
                            <field name="code" placeholder="e.g., USD"/>
                            <field name="symbol" placeholder="e.g., $"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="is_base_currency"/>
                            <field name="current_rate"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Exchange Rates" name="rates">
                            <field name="rate_ids" context="{'default_currency_id': id}">
                                <list delete="1">
                                    <field name="date"/>
                                    <field name="rate"/>
                                    <field name="inverse_rate"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

   <!-- Currency Search View -->
    <record id="view_currency_search" model="ir.ui.view">
        <field name="name">currency.search</field>
        <field name="model">currency</field>
        <field name="arch" type="xml">
            <search string="Search Currencies">
                <field name="name"/>
                <field name="code"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Base Currency" name="base" domain="[('is_base_currency', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Active" name="group_active" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_currency" model="ir.actions.act_window">
        <field name="name">Currencies</field>
        <field name="res_model">currency</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>