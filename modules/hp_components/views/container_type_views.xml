<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="container_type_form_view" model="ir.ui.view">
        <field name="name">container.type.form</field>
        <field name="model">container.type</field>
        <field name="arch" type="xml">
            <form string="Container Types">
                <sheet>
                    <group>
                        <field name="name" required="1" />
                        <field name="teu" required="1"/>
                        <field name="is_active" required="1" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="container_type_list_view" model="ir.ui.view">
        <field name="name">container.type.list</field>
        <field name="model">container.type</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="List Container Types">
                <field name="code" />
                <field name="name" />
                <field name="teu" />
                <field name="is_active" />
                <field name="create_date" />
            </list>
        </field>
    </record>

    <record id="container_type_action" model="ir.actions.act_window">
        <field name="name">Container Types</field>
        <field name="res_model">container.type</field>
        <field name="view_id" ref="container_type_list_view" />
        <field name="view_mode">list,form</field>
    </record>

</odoo>