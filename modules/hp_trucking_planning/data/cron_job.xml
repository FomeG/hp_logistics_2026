<odoo>
    <data noupdate="1">
        <record id="ir_cron_cancel_incative_trip" model="ir.cron">
            <field name="name">Cancel Inactive Trip</field>
            <field name="model_id" ref="model_trucking_planning_trip" />
            <field name="state">code</field>
            <field name="code">model._cancel_inactive_trip()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True" />
        </record>

        <record id="ir_cron_close_done_trip" model="ir.cron">
            <field name="name">Close Done Trip</field>
            <field name="model_id" ref="model_trucking_planning_trip" />
            <field name="state">code</field>
            <field name="code">model._close_done_trip()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True" />
        </record>

        <record id="ir_cron_update_eta_near_status" model="ir.cron">
            <field name="name">Update ETA Near Status</field>
            <field name="model_id" ref="model_trucking_planning_trip" />
            <field name="state">code</field>
            <field name="code">model.recompute_eta_near_status()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True" />
        </record>
    </data>
</odoo>