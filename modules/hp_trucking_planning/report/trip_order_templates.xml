<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Custom external layout without header and logo - inherits from standard layout -->
    <template id="external_layout_no_logo" inherit_id="web.external_layout_standard">
        <xpath expr="//div[@t-attf-class='header o_company_#{company.id}_layout']" position="replace">
            <!-- Header completely removed for this template -->
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'article')]" position="attributes">
            <attribute name="style">margin-top: 0; padding-top: 0;</attribute>
        </xpath>
    </template>

    <!-- Custom external layout that ensures company variable is set -->
    <template id="external_layout_no_logo_wrapper">
        <t t-if="not o" t-set="o" t-value="doc"/>

        <t t-if="not company">
            <!-- Multicompany -->
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="else">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>

        <t t-call="hp_trucking_planning.external_layout_no_logo">
            <t t-out="0"/>
        </t>
    </template>

    <template id="report_trip_order">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="trip">
                <t t-call="hp_trucking_planning.report_trip_order_document"/>
            </t>
        </t>
    </template>

