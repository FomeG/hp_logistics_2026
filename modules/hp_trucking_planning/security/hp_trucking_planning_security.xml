<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record model="ir.module.category" id="module_category_hp_trucking_planning">
            <field name="name">Trucking Planning</field>
            <field name="description">Trucking Planning Department</field>
            <field name="sequence">6</field>
        </record>

        <!-- Member -->
        <record id="group_hp_trucking_planning_member" model="res.groups">
            <field name="name">Member</field>
            <field name="category_id" ref="module_category_hp_trucking_planning" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>

        <!-- Leader -->
        <record id="group_hp_trucking_planning_lead" model="res.groups">
            <field name="name">Leader</field>
            <field name="category_id" ref="module_category_hp_trucking_planning" />
            <field name="implied_ids" eval="[(4, ref('group_hp_trucking_planning_member'))]" />
        </record>

        <!-- Director -->
        <record id="group_hp_trucking_planning_director" model="res.groups">
            <field name="name">Director</field>
            <field name="category_id" ref="module_category_hp_trucking_planning" />
            <field name="implied_ids" eval="[(4, ref('group_hp_trucking_planning_lead'))]" />
        </record>

        <!-- Administrator -->
        <record id="group_hp_trucking_planning_administrator" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_hp_trucking_planning" />
            <field name="implied_ids" eval="[(4, ref('group_hp_trucking_planning_director'))]" />
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
        </record>

        <!-- RULES -->

        <!-- Rule branch cho Member -->
        <record id="trucking_plan_branch_rule_member" model="ir.rule">
            <field name="name">Branch: Member see only their branches</field>
            <field name="model_id" ref="model_trucking_planning_branch" />
            <field name="groups" eval="[(4, ref('group_hp_trucking_planning_member'))]" />
            <field name="domain_force">[('user_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="0" />
            <field name="perm_create" eval="0" />
            <field name="perm_unlink" eval="0" />
        </record>

        <!-- Rule branch director -->
        <record id="trucking_plan_branch_rule_director" model="ir.rule">
            <field name="name">Branch: Director see all</field>
            <field name="model_id" ref="model_trucking_planning_branch" />
            <field name="groups" eval="[(4, ref('group_hp_trucking_planning_director'))]" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_create" eval="1" />
            <field name="perm_unlink" eval="1" />
        </record>

        <!-- Rule client Member -->
        <record id="trucking_plan_client_rule_member" model="ir.rule">
            <field name="name">Client: Member see only their client</field>
            <field name="model_id" ref="model_trucking_planning_client" />
            <field name="groups" eval="[(4, ref('group_hp_trucking_planning_member'))]" />
            <field name="domain_force">[('assign_user_id', '=', user.id)]</field>
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_create" eval="1" />
            <field name="perm_unlink" eval="1" />
        </record>

        <!-- Rule client Leader -->
        <record id="trucking_plan_client_rule_lead" model="ir.rule">
            <field name="name">Client: Lead see all of your branch</field>
            <field name="model_id" ref="model_trucking_planning_client" />
            <field name="groups" eval="[(4, ref('group_hp_trucking_planning_lead'))]" />
            <field name="domain_force">[('branch_id.user_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_create" eval="1" />
            <field name="perm_unlink" eval="1" />
        </record>

        <!-- Rule client director -->
        <record id="trucking_plan_client_rule_director" model="ir.rule">
            <field name="name">Client: Director see all</field>
            <field name="model_id" ref="model_trucking_planning_client" />
            <field name="groups" eval="[(4, ref('group_hp_trucking_planning_director'))]" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_create" eval="1" />
            <field name="perm_unlink" eval="1" />
        </record>

        <!-- TRIP RULES -->

        <!-- Rule trip Lead - can access trips from their branch (includes Member via inheritance) -->
        <record id="trucking_plan_trip_rule_lead" model="ir.rule">
            <field name="name">Trip: Lead can access trips from their branch</field>
            <field name="model_id" ref="model_trucking_planning_trip" />
            <field name="groups" eval="[(4, ref('group_hp_trucking_planning_member'))]" />
            <field name="domain_force">[('plan_line_id.plan_id.branch_id.user_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_create" eval="1" />
            <field name="perm_unlink" eval="0" />
        </record>

        <!-- Rule trip Director - can access all trips -->
        <record id="trucking_plan_trip_rule_director" model="ir.rule">
            <field name="name">Trip: Director can access all trips</field>
            <field name="model_id" ref="model_trucking_planning_trip" />
            <field name="groups" eval="[(4, ref('group_hp_trucking_planning_director'))]" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_create" eval="1" />
            <field name="perm_unlink" eval="1" />
        </record>

        <!-- PLAN RULES -->

        <!-- Rule plan Lead - can access plans from their branch (includes Member via inheritance) -->
        <record id="trucking_plan_plan_rule_lead" model="ir.rule">
            <field name="name">Plan: Lead can access plans from their branch</field>
            <field name="model_id" ref="model_trucking_planning_plan" />
            <field name="groups" eval="[(4, ref('group_hp_trucking_planning_member'))]" />
            <field name="domain_force">[('branch_id.user_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_create" eval="1" />
            <field name="perm_unlink" eval="0" />
        </record>

        <!-- Rule plan Director - can access all plans -->
        <record id="trucking_plan_plan_rule_director" model="ir.rule">
            <field name="name">Plan: Director can access all plans</field>
            <field name="model_id" ref="model_trucking_planning_plan" />
            <field name="groups" eval="[(4, ref('group_hp_trucking_planning_director'))]" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_create" eval="1" />
            <field name="perm_unlink" eval="1" />
        </record>

        <!-- PLAN LINE RULES -->

        <!-- Rule plan line Lead - can access plan lines from their branch (includes Member via inheritance) -->
        <record id="trucking_plan_plan_line_rule_lead" model="ir.rule">
            <field name="name">Plan Line: Lead can access plan lines from their branch</field>
            <field name="model_id" ref="model_trucking_planning_plan_line" />
            <field name="groups" eval="[(4, ref('group_hp_trucking_planning_member'))]" />
            <field name="domain_force">[('plan_id.branch_id.user_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_create" eval="1" />
            <field name="perm_unlink" eval="0" />
        </record>

        <!-- Rule plan line Director - can access all plan lines -->
        <record id="trucking_plan_plan_line_rule_director" model="ir.rule">
            <field name="name">Plan Line: Director can access all plan lines</field>
            <field name="model_id" ref="model_trucking_planning_plan_line" />
            <field name="groups" eval="[(4, ref('group_hp_trucking_planning_director'))]" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_create" eval="1" />
            <field name="perm_unlink" eval="1" />
        </record>


    </data>
</odoo>