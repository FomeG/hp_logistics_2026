<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_shipping_line_tree" model="ir.ui.view">
        <field name="name">partner.shipping.line.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Shipping Lines">
                <field name="name" string="Shipping Line Name" />
                <field name="email" string="Shipping Line Email" />
                <field name="create_date" groups="base.group_system" />
            </list>
        </field>
    </record>
    <record id="view_shipping_line_form" model="ir.ui.view">
        <field name="name">partner.shipping.line.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string="Shipping Line Name" required="1" />
                        <field name="email" string="Shipping Line Email" required="1" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="shipping_line_form_search" model="ir.ui.view">
        <field name="name">partner.shipping.line.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="List Shipping Lines">
                <field name="name" />
                <field name="email" />
            </search>
        </field>
    </record>

    <record id="action_shipping_line" model="ir.actions.act_window">
        <field name="name">Shipping Lines</field>
        <field name="res_model">res.partner</field>
        <field name="search_view_id" ref="shipping_line_form_search" />
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_shipping_line_tree" />
        <field name="domain">[('partner_main_type_id.code', '=', 'shipping_line')]</field>
        <field name="context"
            eval="{
                'form_view_ref': 'hp_trucking_planning.view_shipping_line_form',
                'default_partner_main_type_id': ref('hp_freight_purchase.partner_main_type_shipping_line'),
            }" />
    </record>
</odoo>