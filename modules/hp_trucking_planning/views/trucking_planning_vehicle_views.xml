<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_vehicle_list" model="ir.ui.view">
        <field name="name">trucking_planning.vehicle.list</field>
        <field name="model">trucking_planning.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehicles">
                <field name="name" string="License Plate"/>
                <field name="type" string="Vehicle Type"/>
                <field name="engine_type" string="Engine Size" invisible="type == 'trailer'"/>
                <field name="trailer_id" string="Assigned Trailer" invisible="type == 'trailer'"/>
                <field name="primary_driver_id" string="Driver" invisible="type == 'trailer'"/>
                <field name="fuel_rate_inferior_20" string="Light" invisible="type == 'trailer'"/>
                <field name="fuel_rate_superior_20" string="Heavy" invisible="type == 'trailer'"/>
                <field name="fuel_rate_mix" string="Kẹp" invisible="type == 'trailer'"/>
                <field name="is_rented" string="Rented"/>
                <field name="registration_date" string="Reg. Date"/>
                <field name="active" invisible="1"/>
                <field name="branch_id" groups="base.group_user" />
            </list>
        </field>
    </record>

    <record id="view_popup_plannin_vehicle_list" model="ir.ui.view">
        <field name="name">trucking_planning.vehicle.list.popup</field>
        <field name="model">trucking_planning.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehicles">
                <field name="name" string="License Plate" />
                <field name="type" string="Vehicle Type" />
                <field name="engine_type" string="Engine Size" invisible="type == 'trailer'" />
                <field name="primary_driver_id" string="Driver" invisible="type == 'trailer'" />
                <field name="total_plan_in_month"/>
                <field name="is_rented" string="Rented" />
            </list>
        </field>
    </record>

    <record id="view_vehicle_form" model="ir.ui.view">
        <field name="name">trucking_planning.vehicle.form</field>
        <field name="model">trucking_planning.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle">
                <sheet>
                    <group>
                        <group string="Basic Information">
                            <field name="name" string="License Plate"/>
                            <field name="type" string="Vehicle Type"/>
                            <field name="engine_type" string="Engine Size"
                                   invisible="type == 'trailer'"
                                   required="type == 'truck'"
                            />
                            <field name="registration_date" string="Registration Date"/>
                            <field name="is_rented" string="Rented Vehicle"/>
                        </group>
                        <group string="Assignment" invisible="type == 'trailer'">
                            <field name="trailer_id" string="Assigned Trailer"
                                widget="many2one_new_tab" />
                            <field name="primary_driver_id" string="Driver"
                                domain="[('active', '=', True)]"
                                widget="many2one_new_tab" />
                            <field name="branch_id" string="Branch"
                                widget="many2one_new_tab" />
                        </group>
                    </group>
                    <group string="Fuel Consumption Rates" invisible="type == 'trailer'">
                        <field name="fuel_rate_inferior_20" string="Light" readonly="True"/>
                        <field name="fuel_rate_superior_20" string="Heavy" readonly="True"/>
                        <field name="fuel_rate_mix" string="Kẹp" readonly="True"/>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="hp_trucking_planning_vehicle_form_search" model="ir.ui.view">
        <field name="name">trucking.planning.vehicle.search</field>
        <field name="model">trucking_planning.vehicle</field>
        <field name="arch" type="xml">
            <search string="List Vehicles">
                <field name="name" />
                <field name="type" />

                <filter name="available_date_of_plan"
                    string="Available on Selected Date"
                    domain="[('is_available_on_date', '=', True)]" />
            </search>
        </field>
    </record>

    <record id="action_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">trucking_planning.vehicle</field>
        <field name="search_view_id" ref="hp_trucking_planning_vehicle_form_search" />
        <field name="view_mode">list,form</field>
        <field name="context">{'default_type': 'truck'}</field>
        <field name="domain">[('active', '=', True)]</field>
    </record>
</odoo>