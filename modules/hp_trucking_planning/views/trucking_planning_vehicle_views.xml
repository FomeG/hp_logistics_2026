<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_vehicle_tree" model="ir.ui.view">
        <field name="name">fleet.vehicle.tree</field>
        <field name="model">fleet.vehicle.hpl</field>
        <field name="arch" type="xml">
            <list string="Vehicles">
                <field name="license_plate" string="License Plate" />
                <field name="category_id" string="type" />
                <field name="tag_ids" string="Engine" widget="many2many_tags" options="{'color_field': 'color'}" readonly="1" invisible="is_trailer"/>
                <field name="trailer_id" string="Assigned Trailer" invisible="is_trailer"/>
                <field name="driver_id" widget="many2one_avatar" readonly="1" optional="show" invisible="is_trailer"/>
                <field name="fuel_rate_inferior_20" string="Light" invisible="is_trailer" />
                <field name="fuel_rate_superior_20" string="Heavy" invisible="is_trailer" />
                <field name="fuel_rate_mix" string="Kẹp" invisible="is_trailer" />
                <field name="trucking_branch_id" string="Branch" groups="base.group_user"
                    options="{'no_create': True, 'no_quick_create': True}" />
            </list>
        </field>
    </record>

    <record id="view_vehicle_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.form</field>
        <field name="model">fleet.vehicle.hpl</field>
        <field name="arch" type="xml">
            <form string="Vehicle HPL">
                <sheet>
                    <div class="oe_title">
                        <label for="license_plate"/>
                        <h2>
                            <field name="license_plate" class="oe_inline" required="1" placeholder="e.g. PAE 326"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Vehicle Information">
                            <field name="trucking_branch_id" string="Branch"
                                    widget="many2one_new_tab"
                                    options="{'no_create': True, 'no_quick_create': True}"
                                    required="1"
                            />
                            <field name="fake_category_type" required="1" invisible=" id > 0"/>
                            <field name="fake_engine_type" required="1" invisible="fake_category_type == 'trailer' or is_trailer"/>
                        </group>
                        <group string="Assignment Information" invisible="fake_category_type == 'trailer' or is_trailer">
                            <field name="trailer_id" options="{'no_create': True}"/>
                            <field name="driver_id" widget="many2one_avatar"/>
                        </group>
                        <group string="Fuel Rates" invisible="fake_category_type == 'trailer' or not id  or is_trailer">
                            <field name="fuel_rate_inferior_20" readonly="1"/>
                            <field name="fuel_rate_superior_20" readonly="1"/>
                            <field name="fuel_rate_mix" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_vehicle_search" model="ir.ui.view">
        <field name="name">fleet.vehicle.search</field>
        <field name="model">fleet.vehicle</field>
        <field name="arch" type="xml">
            <search string="List Vehicles">
                <field name="name" />
<!--                <field name="vehicle_type" />-->
<!--                <filter string="Truck" name="type_truck" domain="[('vehicle_type','=','truck')]" />-->
<!--                <filter string="Trailer" name="type_trailer"-->
<!--                    domain="[('vehicle_type','=','trailer')]" />-->
            </search>
        </field>
    </record>

    <record id="action_vehicle" model="ir.actions.act_window">
        <field name="name">vehicles</field>
        <field name="res_model">fleet.vehicle.hpl</field>
        <field name="search_view_id" ref="view_vehicle_search" />
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_vehicle_tree" />
        <field name="context">
            {
                'form_view_ref': 'hp_trucking_planning.view_vehicle_form',
                'search_default_type_truck': 1,
            }
        </field>
    </record>
</odoo>