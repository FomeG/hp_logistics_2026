<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_location_tree" model="ir.ui.view">
        <field name="name">location.tree</field>
        <field name="model">location.base</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type"/>
                <field name="state_id"/>
                <field name="extra_fuel"/>
                <field name="contact_phone" />
                <field name="create_date" groups="base.group_system" />
            </list>
        </field>
    </record>

    <record id="view_location_form" model="ir.ui.view">
        <field name="name">location.form</field>
        <field name="model">location.base</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="type"/>
                    </group>
                    <group>
                        <field name="extra_fuel"/>
                        <field name="address"/>
                        <field name="contact_phone"/>
                    </group>
                    <group>
                        <field name="state_id" domain="[('country_id.code', '=', 'VN')]"
                            options="{'no_create': True, 'no_edit': True}"
                            required="type=='route_point'"
                            widget="many2one_new_tab"
                        />
                    </group>
                    <group name="location_info">
                            <field name="latitude"/>
                            <field name="longitude"/>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="hp_trucking_planning_location_form_search" model="ir.ui.view">
        <field name="name">trucking.planning.location.search</field>
        <field name="model">location.base</field>
        <field name="arch" type="xml">
            <search string="List Locations">
                <field name="name" />
                <field name="type" />
                <field name="extra_fuel" />
                <field name="contact_phone" />
            </search>
        </field>
    </record>

    <record id="action_location" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">location.base</field>
        <field name="search_view_id" ref="hp_trucking_planning_location_form_search" />
        <field name="view_mode">list,form</field>
    </record>
</odoo>