<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_location_tree" model="ir.ui.view">
        <field name="name">location.tree</field>
        <field name="model">trucking_planning.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type"/>
                <field name="state_id"/>
                <field name="extra_fuel"/>
            </list>
        </field>
    </record>

    <record id="view_location_form" model="ir.ui.view">
        <field name="name">location.form</field>
        <field name="model">trucking_planning.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="type"/>
                    </group>
                    <group>
                        <field name="extra_fuel"/>
                        <field name="address"/>
                        <field name="contact_phone"/>
                    </group>
                    <group>
                        <field name="state_id" domain="[('country_id.code', '=', 'VN')]" options="{'no_create': True, 'no_edit': True}" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_location" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">trucking_planning.location</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>