<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="trucking_dashboard_default" model="trucking.dashboard">
        <field name="name">Dashboard</field>
    </record>

    <record id="action_trip_analysis" model="ir.actions.act_window">
        <field name="name">Trip Analysis</field>
        <field name="res_model">trucking_planning.trip</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">
            {
                "search_default_not_cancelled": 1
            }
        </field>
        <field name="target">current</field>
    </record>

    <record id="view_trucking_dashboard_form" model="ir.ui.view">
        <field name="name">trucking.dashboard.form</field>
        <field name="model">trucking.dashboard</field>
        <field name="arch" type="xml">
            <form string="Trucking Dashboard" create="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <i class="fa fa-dashboard"/> Dashboard Trucking
                        </h1>
                    </div>
                    <!-- Smart buttons -->
                            <div class="oe_button_box" name="button_box">
                                <button type="action"
                                        name="%(action_trip_analysis)d"
                                        class="oe_stat_button"
                                        icon="fa-line-chart">
                                    <field string="Detailed Trip Analysis"
                                           name="total_trip_month"
                                           widget="statinfo"/>
                                </button>
                            </div>
                    <!-- Filter Section -->
                    <group string="Filter">
                        <group>
                            <field name="filter_month" widget="selection"/>
                            <field name="filter_year" widget="selection"/>
                        </group>
                        <group>
                            <field name="selected_period" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="General" name="overview">
                            <!-- Statistics Cards -->
                            <group>
                                <group string="Trip Statistics">
                                    <field name="total_trip_month"
                                           readonly="1"
                                           string="Total Trip (Not cancelled)"/>
                                    <field name="total_trip_confirmed"
                                           readonly="1"
                                           string="Trip Confirmed"/>
                                    <field name="total_trip_done"
                                           readonly="1"
                                           string="Trip Done"/>
                                    <field name="total_trip_cancelled"
                                           readonly="1"
                                           string="Trip Cancelled"/>
                                </group>
                            </group>
                        </page>

                        <page string="Top Truck - Driver" name="top_performers">
                            <group string="🏆 Top 5 Truck - Driver (by Completed Trips)">
                                <field name="top_truck_driver"
                                       nolabel="1"
                                       readonly="1"
                                       widget="text"
                                       options="{'style': 'font-family: monospace; white-space: pre;'}"/>
                            </group>
                        </page>
                        <page string="Tất cả Tài xế" name="all_drivers">
                            <group string="Thống kê chi tiết tất cả Tài xế">
                                <field name="all_drivers_stats"
                                       nolabel="1"
                                       readonly="1"
                                       widget="text"
                                       options="{'style': 'font-family: monospace; white-space: pre; font-size: 13px;'}"/>
                            </group>
                            <div class="alert alert-info mt-3" role="alert">
                                <strong>Lưu ý:</strong>
                                <ul>
                                    <li>Bảng thống kê hiển thị tất cả tài xế đã thực hiện chuyến trong kỳ</li>
                                    <li>Số chuyến: Tổng số chuyến không bao gồm chuyến bị hủy</li>
                                    <li>Lít dầu: Tổng lượng nhiên liệu được tính cho các chuyến</li>
                                    <li>Dữ liệu được sắp xếp theo số chuyến giảm dần</li>
                                </ul>
                            </div>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Action mở dashboard -->
    <record id="action_trucking_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">trucking.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="res_id" ref="trucking_dashboard_default"/>
        <field name="context">{'create': False, 'delete': False}</field>
    </record>

</odoo>
