<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_client_tree" model="ir.ui.view">
        <field name="name">partner.client.tree</field>
        <field name="model">res.partner.client</field>
        <field name="arch" type="xml">
            <list string="Clients">
                <field name="ref" />
                <field name="name" />
                <field name="vat" string="Tax Number" />
                <field name="phone" />
                <field name="street" string="Address" />
                <field name="assign_trucking_manager_id" />
                <field name="trucking_branch_id" />
                <field name="create_date" groups="base.group_system" />
            </list>
        </field>
    </record>

    <record id="view_client_form" model="ir.ui.view">
        <field name="name">partner.client.form</field>
        <field name="model">res.partner.client</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                        invisible="active" />
                    <field name="image_1920" widget="image" class="oe_avatar"
                        options="{'preview_image':'image_128'}" />

                    <div class="oe_title mb48">
                        <h1>
                            <field name="name" placeholder="e.g. client Name" required="1" />
                        </h1>
                    </div>
                    <group>
                        <field name="ref" required="1" />
                        <field name="vat" required="1" />
                        <field name="phone" />
                        <field name="street" string="Address" />
                        <field name="assign_trucking_manager_id" />
                        <field name="trucking_branch_id" required="1" />
                    </group>
                    <notebook>
                        <page string="Routes">
                            <field name="route_ids" mode="kanban,form,tree">
                                <list>
                                    <field name="name" />
                                    <field name="from_location_id" widget="many2one_new_tab" />
                                    <field name="to_location_id" widget="many2one_new_tab" />
                                    <field name="distance_km" />
                                </list>
                            </field>
                        </page>
                        <page string="Trips">
                            <field name="plan_line_ids">
                                <list>
                                    <field name="code" />
                                    <field name="status" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_client_search" model="ir.ui.view">
        <field name="name">partner.client.search</field>
        <field name="model">res.partner.client</field>
        <field name="arch" type="xml">
            <search string="List Clients">
                <field name="name" />
                <field name="vat" />
            </search>
        </field>
    </record>

    <record id="action_client" model="ir.actions.act_window">
        <field name="name">clients</field>
        <field name="res_model">res.partner.client</field>
        <field name="search_view_id" ref="view_client_search" />
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_client_tree" />
        <field name="domain">[('partner_main_type_id.code', '=', 'client')]</field>
        <field name="context"
            eval="{
                'form_view_ref': 'hp_trucking_planning.view_client_form',
                'default_partner_main_type_id': ref('hp_components.partner_main_type_client')
            }" />
    </record>
</odoo>