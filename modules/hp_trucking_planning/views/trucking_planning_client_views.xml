<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_client_tree" model="ir.ui.view">
        <field name="name">client.tree</field>
        <field name="model">trucking_planning.client</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="tax_number"/>
                <field name="phone" />
                <field name="assign_user_id" />
                <field name="create_date" groups="base.group_system" />
            </list>
        </field>
    </record>

    <record id="view_client_form" model="ir.ui.view">
        <field name="name">client.form</field>
        <field name="model">trucking_planning.client</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code" />
                        <field name="name"/>
                        <field name="tax_number"/>
                        <field name="phone" />
                        <field name="assign_user_id" />
                    </group>
                    <notebook>
                        <page string="Routes">
                            <field name="route_ids" mode="kanban,form,tree">
                                <list>
                                    <field name="name"/>
                                    <field name="from_location_id" widget="many2one_new_tab" />
                                    <field name="to_location_id" widget="many2one_new_tab" />
                                    <field name="distance_km"/>
                                </list>
                            </field>
                        </page>
                        <page string="Trips">
                            <field name="plan_line_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="hp_trucking_planning_client_form_search" model="ir.ui.view">
        <field name="name">trucking.planning.client.search</field>
        <field name="model">trucking_planning.client</field>
        <field name="arch" type="xml">
            <search string="List Clients">
                <field name="name" />
                <field name="tax_number" />
            </search>
        </field>
    </record>

    <record id="action_client" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">trucking_planning.client</field>
        <field name="search_view_id" ref="hp_trucking_planning_client_form_search" />
        <field name="view_mode">list,form</field>
    </record>
</odoo>