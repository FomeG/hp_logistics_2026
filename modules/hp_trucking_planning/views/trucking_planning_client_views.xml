<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_client_tree" model="ir.ui.view">
        <field name="name">client.tree</field>
        <field name="model">trucking_planning.client</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="tax_number"/>
            </list>
        </field>
    </record>

    <record id="view_client_form" model="ir.ui.view">
        <field name="name">client.form</field>
        <field name="model">trucking_planning.client</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="tax_number"/>
                    </group>
                    <notebook>
                        <page string="Routes">
                            <field name="route_ids" mode="kanban,form,tree">
                                <list>
                                    <field name="name"/>
                                    <field name="from_location_id"/>
                                    <field name="to_location_id"/>
                                    <field name="distance_km"/>
                                </list>
                            </field>
                        </page>
                        <page string="Trips">
                            <field name="plan_line_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_client" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">trucking_planning.client</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>