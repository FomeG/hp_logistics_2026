<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- list View -->
    <record id="view_plan_prefix_rule_list" model="ir.ui.view">
        <field name="name">trucking_planning.plan.prefix.rule.list</field>
        <field name="model">trucking_planning.plan.prefix.rule</field>
        <field name="arch" type="xml">
            <list string="Prefix Rules">
                <field name="name" string="Prefix"/>
                <field name="user_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_plan_prefix_rule_form" model="ir.ui.view">
        <field name="name">trucking_planning.plan.prefix.rule.form</field>
        <field name="model">trucking_planning.plan.prefix.rule</field>
        <field name="arch" type="xml">
            <form string="Prefix Rule">
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="Prefix" placeholder="Enter prefix..."/>
                            <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Action and Menu Items -->
    <record id="action_plan_prefix_rule" model="ir.actions.act_window">
        <field name="name">Prefix Rules</field>
        <field name="res_model">trucking_planning.plan.prefix.rule</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>