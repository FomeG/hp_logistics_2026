<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Zalo Confirmation Wizard Form View -->
        <record id="view_zalo_confirmation_wizard_form" model="ir.ui.view">
            <field name="name">zalo.confirmation.wizard.form</field>
            <field name="model">trucking_planning.zalo.confirmation.wizard</field>
            <field name="arch" type="xml">
                <form string="Confirm Zalo Message">
                    <sheet>
                        <div class="alert alert-info" role="alert">
                            <strong>Message Preview:</strong> Please review the message content below before sending.
                        </div>
                        <group>
                            <field name="message_content"
                                   placeholder="Message content will appear here..."
                                   style="font-family: monospace; white-space: pre-wrap; min-height: 300px; background-color: #f8f9fa; border: 1px solid #dee2e6; padding: 10px; border-radius: 4px;"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_close" string="Close" type="object" class="btn-secondary"/>
                        <button name="action_send_message" string="Send Message" type="object" class="btn-primary"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Zalo Confirmation Wizard Action -->
        <record id="action_zalo_confirmation_wizard" model="ir.actions.act_window">
            <field name="name">Confirm Zalo Message</field>
            <field name="res_model">trucking_planning.zalo.confirmation.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="view_zalo_confirmation_wizard_form"/>
        </record>
    </data>
</odoo>
