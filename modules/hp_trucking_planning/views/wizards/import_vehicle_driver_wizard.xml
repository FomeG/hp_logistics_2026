<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Import Vehicle and Driver Wizard Form View -->
    <record id="view_import_vehicle_driver_wizard_form" model="ir.ui.view">
        <field name="name">trucking_planning.import_vehicle_driver_wizard.form</field>
        <field name="model">trucking_planning.import_vehicle_driver_wizard</field>
        <field name="arch" type="xml">
            <form string="Import Vehicle and Driver">
                <sheet>
                    <div class="oe_title mb-3">
                        <h1>
                            <i class="fa fa-upload text-primary"/> Import Vehicle and Driver từ Excel
                        </h1>
                    </div>
                    <group>
                        <group string="Cấu hình Import" class="col-md-6">
                            <field name="branch_id"
                                   placeholder="Chọn chi nhánh..."
                                   options="{'no_create': True, 'no_quick_create': True}"/>
                        </group>
                        <group string="File Upload" class="col-md-6">
                            <field name="file" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                            <field name="sheet_name" placeholder="Enter sheet name to import"/>
                            <field name="available_sheets" readonly="1"/>
                        </group>
                    </group>
                        <div class="alert alert-info" role="alert">
                            <h4 class="alert-heading" role="alert">Hướng dẫn Import</h4>
                                <div class="row">
                                      <div class="col-md-6">
                                          <p><strong>📥 Tải file mẫu:</strong></p>
                                          <p>
                                              <a href="/hp_trucking_planning/static/xlsx/Sample_import_vehicle_driver.xls" 
                                                 target="_blank"
                                                 role="button"
                                                 class="btn btn-sm btn-outline-primary">
                                                  <i class="fa fa-download"/> Tải File Mẫu Excel
                                              </a>
                                          </p>
                                          <p><strong>📋 Cách sử dụng file mẫu:</strong></p>
                                          <ol>
                                              <li>Tải file mẫu từ link trên</li>
                                              <li>Mở file Excel và nhập dữ liệu thực tế của bạn</li>
                                              <li>Giữ nguyên tên các cột header</li>
                                              <li>Lưu file và upload vào form này</li>
                                          </ol>
                                      </div>
                                      <div class="col-md-6">
                                          <p><strong>📊 Cấu trúc cột bắt buộc:</strong></p>
                                          <ul>
                                              <li><strong>Mã xe:</strong> Mã số xe</li>
                                              <li><strong>Biển số:</strong> Biển số xe (bắt buộc)</li>
                                              <li><strong>số mooc:</strong> Số mooc/trailer</li>
                                              <li><strong>Họ tên lái xe:</strong> Tên đầy đủ của lái xe</li>
                                              <li><strong>điện thoại:</strong> Số điện thoại lái xe</li>
                                              <li><strong>loại máy:</strong> "máy bé" hoặc "máy to"</li>
                                          </ul>
                                      </div>
                                  </div>
                                  <div class="row mt-3">
                                      <div class="col-12">
                                          <div class="alert alert-warning" role="alert">
                                              <h5 class="alert-heading" role="alert">⚠️ Lưu ý quan trọng:</h5>
                                              <ul class="mb-0">
                                                  <li>Dòng đầu tiên phải là header chứa tên các cột</li>
                                                  <li>Lái xe được import với CCCD và License Number tạm thời. Vui lòng cập nhật thủ công sau khi import</li>
                                                  <li>Trailer sẽ được tự động gán cho xe tương ứng trong cùng một dòng</li>
                                              </ul>
                                          </div>
                                      </div>
                                  </div>
                             </div>
                </sheet>
                <footer>
                    <button name="action_import"
                            type="object"
                            string="Import"
                            class="btn-primary"/>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_vehicle_driver_wizard" model="ir.actions.act_window">
        <field name="name">Import Vehicle and Driver</field>
        <field name="res_model">trucking_planning.import_vehicle_driver_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_import_vehicle_driver_wizard_form"/>
    </record>

</odoo> 