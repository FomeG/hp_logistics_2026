<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Wizard View -->
    <record id="add_draft_trip_wizard_form" model="ir.ui.view">
        <field name="name">trucking_planning.add_draft_trip.wizard.form</field>
        <field name="model">trucking_planning.add_draft_trip.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Draft Trip">
                <group>
                    <field name="number_of_trips"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>