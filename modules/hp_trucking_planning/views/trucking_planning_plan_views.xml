<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_plan_tree" model="ir.ui.view">
        <field name="name">trucking_planning.plan.tree</field>
        <field name="model">trucking_planning.plan</field>
        <field name="arch" type="xml">
            <list string="Plans">
                <field name="name" string="Reference" readonly="1"/>
                <field name="plan_type" string="Plan Type"/>
                <field name="booking_bill_no"/>
                <field name="location_id" string="Location"/>
                <field name="shipping_line_id" string="Shipping Line"/>
                <field name="date"/>
<!--                <field name="vehicle_id"/>-->
<!--                <field name="driver_id" />-->
                <field name="container_type" string="Container Type"/>
                <field name="goods_cut_off" string="Goods Cut Off Date"/>
                <field name="status"/>
                <field name="total_trips" string="Trips" />
                <field name="create_date" groups="base.group_system" />
            </list>
        </field>
    </record>

    <record id="view_plan_form" model="ir.ui.view">
        <field name="name">trucking_planning.plan.form</field>
        <field name="model">trucking_planning.plan</field>
        <field name="arch" type="xml">
            <form string="Plan">
                <sheet>
                        <group>
                            <field name="name" string="Reference" readonly="True"/>
                        </group>
                        <group>
                            <field name="booking_bill_no" string="Booking Bill No."/>
                            <field name="shipping_line_id" string="Shipping Line"/>
                            <field name="container_type" string="Container Type"/>
                            <field name="goods_cut_off" string="Goods Cut Off Date"/>
                            <field name="date" required="1"/>
<!--                            <field name="vehicle_id"-->
<!--                                invisible="not date"-->
<!--                                widget="many2one_new_tab"-->
<!--                                context="{-->
<!--                                    'list_view_ref': 'hp_trucking_planning.view_popup_plannin_vehicle_list',-->
<!--                                    'search_view_ref': 'hp_trucking_planning.hp_trucking_planning_vehicle_form_search',-->
<!--                                    'search_default_available_date_of_plan': 1,-->
<!--                                    'check_date': date,-->
<!--                                }" />-->

<!--                            <field name="driver_id" widget="many2one_new_tab" />-->
                            <field name="status"/>
                        </group>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_trips"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-truck">
                                <field name="total_trips" widget="statinfo" string="Trips"/>
                            </button>
                        </div>
                        <notebook>
                            <page string="Trips" invisible="not id">
                                <field name="plan_line_ids" readonly="True">
                                    <list delete="false">
                                        <field name="code" string="Job" />
                                        <field name="client_id"/>
                                        <field name="status"/>
                                        <field name="plan_type" string="Direction"/>
                                        <field name="actual_source_location_id" string="From"/>
                                        <field name="actual_destination_location_id" string="To"/>
<!--                                        <field name="weight_class" string="Weight"/>-->
<!--                                        <field name="fuel_liters"/>-->
<!--                                        <field name="total_cost"/>-->
                                    </list>
                                </field>
                            </page>
                        </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_plan_search" model="ir.ui.view">
        <field name="name">trucking_planning.plan.search</field>
        <field name="model">trucking_planning.plan</field>
        <field name="arch" type="xml">
            <search string="Plan Search">
<!--                <field name="vehicle_id"/>-->
                <field name="shipping_line_id" string="Shipping Line"/>
                <field name="name" string="Reference"/>
                <field name="month" string="Month" />
                <field name="year" string="Year" />

                <filter string="Export" name="export" domain="[('plan_type', '=', 'export')]"/>
                <filter string="Import" name="import" domain="[('plan_type', '=', 'import')]"/>
                <filter string="Draft" name="draft" domain="[('status','=','draft')]"/>
                <filter string="In Progress" name="in_progress" domain="[('status', '=', 'in_progress')]"/>
                <filter string="Done" name="done" domain="[('status','=','done')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('status','=','confirmed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('status','=','cancel')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_status" context="{'group_by':'status'}"/>
                    <filter string="Plan Type" name="group_by_plan_type" context="{'group_by':'plan_type'}"/>
                    <filter string="Container Type" name="group_by_container_type" context="{'group_by':'container_type'}"/>
<!--                    <filter string="Vehicle" name="group_by_vehicle" context="{'group_by':'vehicle_id'}"/>-->
                    <filter string="Date" name="group_by_date" context="{'group_by':'date'}"/>
                    <filter string="Month" name="month" context="{'group_by': 'month'}" />
                    <filter string="Year" name="year" context="{'group_by': 'year'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_plan" model="ir.actions.act_window">
        <field name="name">Plans</field>
        <field name="res_model">trucking_planning.plan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_status': 'in_progress'}</field>
    </record>
</odoo>