<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_plan_tree" model="ir.ui.view">
        <field name="name">trucking_planning.plan.tree</field>
        <field name="model">trucking_planning.plan</field>
        <field name="arch" type="xml">
            <list string="Plans">
                <field name="name" string="Reference" readonly="1"/>
                <field name="booking_bill_no"/>
                <field name="location_id" string="Port"/>
                <field name="plan_type" string="Plan Type"/>
                <field name="shipping_line_id" string="Shipping Line"/>
<!--                <field name="date"/>-->
                <field name="container_type" string="Container Type"/>
                <field name="goods_cut_off" string="Goods Cut Off Date"/>
                <field name="status"/>
                <field name="total_trips" string="Trips" />
                <field name="create_date" groups="base.group_system" />
            </list>
        </field>
    </record>

    <record id="view_plan_form" model="ir.ui.view">
        <field name="name">trucking_planning.plan.form</field>
        <field name="model">trucking_planning.plan</field>
        <field name="arch" type="xml">
            <form string="Plan">
                <sheet>
                    <header>
                        <field name="status" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
<!--                        <button name="action_export_plan_docx" string="Export Plan" type="object" class="btn-primary" invisible="not id"/>-->
                        <button name="action_send_message_to_all_trips" 
                                string="Send Message to All Trips" 
                                type="object" 
                                class="btn-success" 
                                icon="fa-paper-plane"
                                invisible="not id or not has_trips"/>
                    </header>
                        <group>
                            <field name="name" string="Reference" readonly="True"/>
                        </group>
                        <group>
                            <field name="booking_bill_no"
                                   string="Booking No"
                                   invisible="plan_type == 'import'"/>
                            <field name="booking_bill_no"
                                   string="Bill No"
                                   invisible="plan_type == 'export'"/>
                            <field name="plan_type" string="Plan Type"/>
                            <field name="shipping_line_id"
                                string="Shipping Line"
                                context="{
                                    'default_partner_main_type_id': %(hp_components.partner_main_type_shipping_line)d
                                }"
                                options="{'no_quick_create': True}"
                            />


                            <field name="container_type" string="Container Type"/>
<!--                            <field name="location_id" string="Port" context="{'default_type':'port', 'hide_type':True}"/>-->
                            <field name="location_id"
                                   string="Port Pickup"
                                   invisible="plan_type == 'import'"
                                   context="{'default_type':'port', 'hide_type':True}"
                                   domain="[('type', '=', 'port')]"/>
                            <field name="location_id"
                                   string="Port Drop"
                                   invisible="plan_type == 'export'"
                                   context="{'default_type':'port', 'hide_type':True}"
                                   domain="[('type', '=', 'port')]"/>
<!--                            <field name="date"/>-->
                            <field name="goods_cut_off" string="Goods Cut Off Date"/>
                            <field name="status"/>
                        </group>
                        <div class="oe_button_box" name="button_box" invisbile="not id">
                            <button name="action_view_plan_lines"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-user"
                                    invisible="not id or not plan_line_ids">
                                <field name="total_trips" widget="statinfo" string="Customer"/>
                            </button>
                            <button name="action_add_truck"
                                    string="Add Truck"
                                    type="object"
                                    class="btn-primary"
                                    icon="fa-truck"
                                    invisible="not plan_line_ids or not id"/>
                            <button name="action_add_client"
                                    string="Add Client"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-user-plus"
                                    invisible="not id"/>
                        <!--                            Quick access to all trips:-->
                            <button name="action_view_all_trips"
                                string="View All Trucks"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-list"
                                invisible="not has_trips or not id"/>
                        </div>
                        <notebook invisible="not id">
                            <page string="Customer" invisible="not plan_line_ids">
                                <field name="plan_line_ids" readonly="True">
                                    <list delete="false">
                                        <field name="code" string="Job" />
                                        <field name="client_id"
                                                context="{
                                                    'list_view_ref': 'hp_trucking_planning.view_client_tree',
                                                    'search_view_ref': 'hp_trucking_planning.view_client_search',                    
                                                }"
                                                options="{'no_create': True, 'no_edit': True}"
                                                widget="many2one_new_tab" />
                                        <field name="status"/>
                                        <field name="plan_type" string="Direction"/>
                                        <field name="actual_source_location_id" string="From"/>
                                        <field name="actual_destination_location_id" string="To"/>
                                        <field name="goods_pickup_location_id" string="Place of Pickup" invisible="plan_type == 'import' or not route_id" required="plan_type == 'export' and route_id"/>
                                        <field name="goods_delivery_location_id" string="Place of Delivery" invisible="plan_type == 'export' or not route_id" required="plan_type == 'import' and route_id"/>
                                        <field name="estimate_time_departure" string="Estimate Time Departure"/>
                                        <field name="estimate_time_arrival" string="Estimate Time Arrival"/>
                                        <field name="goods_name"/>
                                        <field name="goods_weight"/>
                                        <field name="truck_count" string="Trucks"/>
                                        <button name="action_export_plan_line_excel" 
                                                string="Export"
                                                type="object" 
                                                class="btn-primary" 
                                                icon="fa-download"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_plan_search" model="ir.ui.view">
        <field name="name">trucking_planning.plan.search</field>
        <field name="model">trucking_planning.plan</field>
        <field name="arch" type="xml">
            <search string="Plan Search">
                <field name="shipping_line_id" string="Shipping Line"/>
                <field name="name" string="Reference"/>
                <field name="booking_bill_no"/>
<!--                <field name="month" string="Month" />-->
<!--                <field name="year" string="Year" />-->

                <field name="create_date" string="Created Date"/>

                <filter name="create_date" string="Created Date" date="create_date" start_year="-4" start_month="-8" end_month="3"/>
                <filter string="Created Today" name="created_today" domain="[('create_date','&gt;=', context_today())]"/>
                <filter string="Export" name="export" domain="[('plan_type', '=', 'export')]"/>
                <filter string="Import" name="import" domain="[('plan_type', '=', 'import')]"/>
                <filter string="Draft" name="draft" domain="[('status','=','draft')]"/>
                <filter string="In Progress" name="in_progress" domain="[('status', '=', 'in_progress')]"/>
                <filter string="Done" name="done" domain="[('status','=','done')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('status','=','confirmed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('status','=','cancel')]"/>
                <filter string="Not Cancelled" name="not_cancelled" domain="[('status', '!=', 'cancel')]" />

                <group expand="0" string="Group By">
                    <filter string="Created Date" name="create_date" domain="['&amp;', ('create_date', '>=', self), ('create_date', '&lt;=', self + relativedelta(days=1))]" context="{'group_by':'create_date:day'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by':'status'}"/>
                    <filter string="Plan Type" name="group_by_plan_type" context="{'group_by':'plan_type'}"/>
                    <filter string="Container Type" name="group_by_container_type" context="{'group_by':'container_type'}"/>
<!--                    <filter string="Load/Return Date" name="group_by_date" context="{'group_by':'date'}"/>-->
                </group>
            </search>
        </field>
    </record>

    <record id="action_plan" model="ir.actions.act_window">
        <field name="name">Plans</field>
        <field name="res_model">trucking_planning.plan</field>
        <field name="view_mode">list,form</field>
        <field name="context">
            {
                'default_status': 'in_progress',
                'search_default_not_cancelled': 1,
            }
        </field>
    </record>
</odoo>