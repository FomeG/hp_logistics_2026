<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_route_tree" model="ir.ui.view">
        <field name="name">route.tree</field>
        <field name="model">trucking_planning.route</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="from_location_id" groups="base.group_system"/>
                <field name="to_location_id" groups="base.group_system"/>
                <field name="distance_km"/>
                <field name="road_fee"/>
                <field name="ticket_fee"/>
                <field name="trip_salary"/>
                <field name="total_cost"/>
                <field name="extra_fuel" />
                <field name="create_date" groups="base.group_system" />
            </list>
        </field>
    </record>
    <record id="view_route_form" model="ir.ui.view">
        <field name="name">route.form</field>
        <field name="model">trucking_planning.route</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" placeholder="Enter route name"/>
                    </group>
                    <group>
                        <field name="from_location_id" widget="many2one_new_tab" context="{'default_type':'route_point','hide_type':True}"/>
                        <field name="from_state_id" readonly="1" widget="many2one_new_tab" />
                        <field name="to_location_id" widget="many2one_new_tab" context="{'default_type':'route_point','hide_type':True}"/>
                        <field name="to_state_id" readonly="1" widget="many2one_new_tab" />
                        <field name="direction" />
                        <field name="extra_fuel" readonly="1"/>
                    </group>
                    <group>
                        <field name="distance_km"/>
                        <field name="road_fee"/>
                        <field name="trip_salary"/>
                        <field name="ticket_fee"/>
                        <field name="total_cost" readonly="1"/>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="hp_trucking_planning_route_form_search" model="ir.ui.view">
        <field name="name">trucking.planning.route.search</field>
        <field name="model">trucking_planning.route</field>
        <field name="arch" type="xml">
            <search string="List Routes">
                <field name="name" />
                <field name="distance_km" />
                <field name="total_cost" />
            </search>
        </field>
    </record>

    <record id="action_route" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">trucking_planning.route</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>