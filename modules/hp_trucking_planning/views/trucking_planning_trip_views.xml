<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_trip_list" model="ir.ui.view">
        <field name="name">trip.list</field>
        <field name="model">trucking_planning.trip</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="plan_line_id" string="Plan Line"/>
                <field name="status"/>
                <field name="container_number"/>
                <field name="seal_number"/>
                <field name="container_type"/>
                <field name="container_size"/>
                <field name="shipping_line_id"/>
                <field name="plan_type"/>
                <field name="truck_id"/>
                <field name="driver_id"/>
                <field name="trailer_id"/>
                <field name="weight_class"/>
                <field name="freeway"/>
                <field name="fuel_liters"/>
                <field name="total_cost"/>
            </list>
        </field>
    </record>

    <record id="view_trip_form" model="ir.ui.view">
        <field name="name">trip.form</field>
        <field name="model">trucking_planning.trip</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_preview_trip_order" string="Preview Trip Order" type="object" class="btn-secondary"/>
                    <button name="action_export_trip_docx" string="Export Trip DOCX" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="plan_line_id"
                               widget="many2one"
                               string="Plan Line"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="code"/>
                        <field name="status"/>
                    </group>

                    <notebook>
                        <page string="Container Info">
                            <group>
                                <field name="container_number"/>
                                <field name="seal_number"/>
                                <field name="container_type"/>
                                <field name="container_size"/>
                                <field name="shipping_line_id"/>
                                <field name="plan_type"/>
                            </group>
                        </page>
                        <page string="Vehicle/Driver">
                            <group>
                                <field name="truck_id"/>
                                <field name="driver_id"/>
                                <field name="trailer_id"/>
                                <field name="weight_class"/>
                                <field name="freeway"/>
                            </group>
                        </page>
                        <page string="Costs">
                            <group>
                                <field name="extra_charge"/>
                                <field name="extra_fuel"/>
                                <field name="fuel_liters" readonly="1"/>
                                <field name="total_cost" readonly="1"/>
                            </group>
                        </page>
                        <page string="Goods Info">
                            <group>
                                <field name="goods_name"/>
                                <field name="goods_weight"/>
                                <field name="goods_cut_off"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_trip_search" model="ir.ui.view">
        <field name="name">trip.search</field>
        <field name="model">trucking_planning.trip</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="plan_line_id"/>
                <field name="container_number"/>
                <field name="status"/>
                <field name="truck_id"/>
                <field name="driver_id"/>
                <field name="shipping_line_id"/>
                <field name="plan_type"/>
                <field name="container_type"/>
                <field name="weight_class"/>

                <filter string="Confirmed" name="confirmed" domain="[('status', '=', 'confirmed')]"/>
                <filter string="Checking" name="checking" domain="[('status', '=', 'checking')]"/>
                <filter string="Done" name="done" domain="[('status', '=', 'done')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('status', '=', 'cancelled')]"/>
                <filter string="Export" name="export" domain="[('plan_type', '=', 'export')]"/>
                <filter string="Import" name="import" domain="[('plan_type', '=', 'import')]"/>
                <filter string="Freeway" name="freeway" domain="[('freeway', '=', True)]"/>

                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_status" context="{'group_by':'status'}"/>
                    <filter string="Plan Type" name="group_by_plan_type" context="{'group_by':'plan_type'}"/>
                    <filter string="Driver" name="group_by_driver" context="{'group_by':'driver_id'}"/>
                    <filter string="Truck" name="group_by_truck" context="{'group_by':'truck_id'}"/>
                    <filter string="Container Type" name="group_by_container_type" context="{'group_by':'container_type'}"/>
                    <filter string="Weight Class" name="group_by_weight_class" context="{'group_by':'weight_class'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_trip" model="ir.actions.act_window">
        <field name="name">Trips</field>
        <field name="res_model">trucking_planning.trip</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_status': 'checking'}</field>
    </record>
</odoo>