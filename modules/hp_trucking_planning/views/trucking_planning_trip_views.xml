<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_trip_list" model="ir.ui.view">
        <field name="name">trip.list</field>
        <field name="model">trucking_planning.trip</field>
        <field name="arch" type="xml">
            <list default_order="is_eta_near desc, plan_estimate_time_arrival asc" decoration-danger="is_eta_near == True">
                <header>
                    <button name="action_export_trip_docx_bulk"
                            string="Export all"
                            type="object"
                            class="btn-primary"
                            icon="fa-download"/>
                    <button name="action_send_message_bulk" 
                            string="Send Message to all"
                            type="object" 
                            class="btn-success" 
                            icon="fa-paper-plane"/>
                    <button name="action_duplicate_with_queue"
                            type="object"
                            string="Duplicate"
                            icon="fa-copy"/>
                </header>
<!--                <div class="alert alert-warning" role="alert" style="margin: 10px; padding: 15px; border: 2px solid #f0ad4e; background-color: #fcf8e3;">-->
<!--                    <strong>⚠️ Warning:</strong> Trips nearing ETA are highlighted in <strong style="color: #d9534f;">RED</strong>. Use the "⚠️ Nearing ETA" filter to show only urgent trips.-->
<!--                </div>-->
                <field name="plan_line_id"/>
                <field name="plan_booking_bill_no" string="Booking No"/>
                <field name="status"/>
                <field name="container_number"/>
                <field name="seal_number"/>
                <field name="container_type"/>
                <field name="container_size"/>
                <field name="plan_type"/>
                <field name="truck_id"/>
                <field name="driver_id"/>
                <field name="trailer_id"/>
                <field name="weight_class"/>
                <field name="freeway"/>
                <field name="is_current" widget="boolean_toggle"/>
                <field name="fuel_liters"/>
                <field name="total_cost"/>
                <field name="plan_estimate_time_arrival" string="ETA"/>
            </list>
        </field>
    </record>

    <record id="view_trip_form" model="ir.ui.view">
        <field name="name">trip.form</field>
        <field name="model">trucking_planning.trip</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_export_trip_docx" string="Export" type="object" class="btn-primary" invisible="not id"/>
                    <button name="action_preview_trip_order" string="Preview" type="object" class="btn-secondary" invisible="not id"/>
                    <button name="action_send_message" 
                            string="Send Message" 
                            type="object" 
                            class="btn-success" 
                            icon="fa-paper-plane"
                            invisible="not id"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,checking,confirmed,done"/>
                </header>
                <sheet>
                    <!-- Current Trip Status - Always Visible at Top -->
                    <div style="margin: 10px; padding: 15px; border: 2px solid #17a2b8; background-color: transparent;" invisible="not driver_id">
                        <strong>📍 Is Current Trip of <field name="truck_id" readonly="1" invisible="not truck_id"/>? </strong>
                        <field name="is_current" 
                               widget="boolean_toggle"
                               string=""
                               help="Mark this trip as current for GPS location tracking"/>
                    </div>
                    
                    <div class="oe_button_box" name="button_box" invisible="not id">
                        <button name="action_view_job"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-user">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">View Job</span>
                            </div>
                        </button>
<!--                        Back to Plan-->
                        <button name="action_back_to_plan"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-arrow-left">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Back to Plan</span>
                            </div>
                        </button>
<!--                        All Trips in the same Plan-->
                        <button name="action_view_plan_all_trips"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-th-list">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">View All Trucks</span>
                            </div>
                        </button>
                    </div>

                    <group string="Job Selection" invisible="context.get('default_plan_line_id', False) or context.get('default_plan_id', False) or id">
                        <!-- Khi tạo từ list view trip - chỉ hiện job number -->
                        <field name="plan_line_id"
                               widget="many2one"
                               string="Job Number"
                               required="1"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>

                    <group string="Trip Information" invisible="not id and not context.get('default_plan_line_id', False) and not context.get('default_plan_id', False) and not plan_line_id">
                        <!-- Booking/Bill No - chỉ hiện khi đã chọn job number hoặc khi có context từ plan/job -->
                        <field name="plan_booking_bill_no"
                               string="Booking No"
                               invisible="plan_type == 'import' or (not id and not context.get('default_plan_line_id', False) and (not context.get('default_plan_id', False) or not plan_line_id))"/>
                        <field name="plan_booking_bill_no"
                               string="Bill No"
                               invisible="plan_type == 'export' or (not id and not context.get('default_plan_line_id', False) and (not context.get('default_plan_id', False) or not plan_line_id))"/>

                        <!-- Khi tạo từ Plan - cho phép chọn customer nhưng ẩn job number label -->
                        <field name="plan_line_id"
                               widget="many2one"
                               string="Job Number"
                               readonly="context.get('default_plan_line_id', False)"
                               required="1"
                               invisible="not context.get('default_plan_id', False) or context.get('default_plan_line_id', False)"
                               domain="[('plan_id', '=', context.get('default_plan_id', False))]"
                               options="{'no_create': True, 'no_create_edit': True}"/>

                        <!-- Khi tạo từ Job - customer readonly -->
                        <field name="plan_line_id"
                               widget="many2one"
                               string="Job Number"
                               readonly="1"
                               invisible="not context.get('default_plan_line_id', False)"
                               options="{'no_create': True, 'no_create_edit': True}"/>

                        <!-- Khi đã có record hoặc đã chọn job từ list view -->
                        <field name="plan_line_id"
                               widget="many2one"
                               string="Job Number"
                               readonly="1"
                               invisible="not id or context.get('default_plan_line_id', False) or context.get('default_plan_id', False)"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="plan_id" invisible="1"/>
                        <field name="client_id" string="Client" readonly="1"/>
                        <field name="client_tax_number" string="Client Tax Number" readonly="1"/>
                        <field name="plan_estimate_time_departure" />
                        <field name="plan_estimate_time_arrival" />
                        <field name="status"/>
                    </group>
                    <group string="Vehicle Information">
                        <button name="action_open_vehicle_driver_pair_popup"
                            type="object"
                            string="Assign Driver - Vehicle"
                            class="oe_highlight"/>
                        <field name="vehicle_assignment_log_id" options="{'no_create': True, 'no_create_edit': True}" invisible="True"/>
                        <field name="truck_id"/>
                        <field name="driver_id"/>
                        <field name="trailer_id"/>
                        <field name="weight_class"/>
                        <field name="freeway"/>
                    </group>
                    <group string ="Container Information">
                        <field name="container_number"/>
                        <field name="seal_number"/>
                        <field name="container_type"/>
                        <field name="container_size"/>
                    </group>

                    <notebook>
                        <page string="Costs">
                            <group>
                                <field name="extra_charge"/>
                                <field name="extra_fuel"/>
                                <field name="fuel_liters" readonly="1"/>
                                <field name="total_cost" readonly="1"/>
                            </group>
                        </page>
                        <page string="Goods Info" invisible="not id">
                            <group>
                                <field name="goods_name"/>
                                <field name="goods_weight"/>
                                <field name="goods_cut_off"/>
                            </group>
                        </page>

                        <page string="GPS Checkpoints" invisible="not id or not checkpoint_ids">
                            <field name="checkpoint_ids" 
                                   widget="one2many" 
                                   context="{'default_trip_id': id}"
                                   options="{'create': false, 'delete': false}"/>
                        </page>

                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_trip_search" model="ir.ui.view">
        <field name="name">trip.search</field>
        <field name="model">trucking_planning.trip</field>
        <field name="arch" type="xml">
            <search>
                <field name="plan_line_id"/>
                <field name="plan_id" string="Plan"/>
                <field name="client_id" string="Client"/>
                <field name="container_number"/>
                <field name="status"/>
                <field name="truck_id"/>
                <field name="driver_id"/>
                <field name="plan_type"/>
                <field name="container_type"/>
                <field name="weight_class"/>

                <filter string="Draft" name="draft" domain="[('status', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('status', '=', 'confirmed')]"/>
                <filter string="Checking" name="checking" domain="[('status', '=', 'checking')]"/>
                <filter string="Done" name="done" domain="[('status', '=', 'done')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('status', '=', 'cancelled')]"/>
                <filter string="Export" name="export" domain="[('plan_type', '=', 'export')]"/>
                <filter string="Import" name="import" domain="[('plan_type', '=', 'import')]"/>
                <filter string="Freeway" name="freeway" domain="[('freeway', '=', True)]"/>
                <filter string="Current GPS Trip" name="current_gps" domain="[('is_current', '=', True)]"/>
                <filter string="Not Cancelled" name="not_cancelled" domain="[('status', '!=', 'cancelled')]" />
                <filter string="⚠️ Nearing ETA" name="nearing_eta" domain="[('is_eta_near', '=', True)]" />

                <group expand="0" string="Group By">
                    <filter string="Job" name="group_by_plan_line" context="{'group_by':'plan_line_id'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by':'status'}"/>
                    <filter string="Plan Type" name="group_by_plan_type" context="{'group_by':'plan_type'}"/>
                    <filter string="Driver" name="group_by_driver" context="{'group_by':'driver_id'}"/>
                    <filter string="Truck" name="group_by_truck" context="{'group_by':'truck_id'}"/>
                    <filter string="Container Type" name="group_by_container_type" context="{'group_by':'container_type'}"/>
                    <filter string="Weight Class" name="group_by_weight_class" context="{'group_by':'weight_class'}"/>
                    <filter string="Client" name="group_by_client" context="{'group_by':'client_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_trip" model="ir.actions.act_window">
        <field name="name">Trips</field>
        <field name="res_model">trucking_planning.trip</field>
        <field name="view_mode">list,form</field>
        <field name="context">
            {
                'default_status': 'draft',
                'search_default_not_cancelled': 1,
            }
        </field>
    </record>

</odoo>