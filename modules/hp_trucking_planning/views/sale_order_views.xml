<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_quote_inherit_trucking" model="ir.ui.view">
        <field name="name">sale.order.form.quote.inherit.trucking</field>
        <field name="model">sale.order</field>
        <!-- kế thừa lại view đã được custom ở hp_sale -->
        <field name="inherit_id" ref="hp_sale.sale_order_form_quote_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_order_template_id']" position="after">
                <button name="select_truck_freight"
                        type="object"
                        string="Add Truck Freight"
                        class="btn btn-info"/>
            </xpath>
        </field>
    </record>
</odoo>