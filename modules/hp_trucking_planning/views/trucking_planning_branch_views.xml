<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="trucking_plannign_branch_tree_view" model="ir.ui.view">
        <field name="name">trucking_planning.branch.tree</field>
        <field name="model">trucking_planning.branch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="plan_prefix" />
                <field name="total_users" />
                <field name="total_vehicles" />
                <field name="create_date" groups="base.group_system" />
            </list>
        </field>
    </record>
    <record id="trucking_plannign_branch_form_view" model="ir.ui.view">
        <field name="name">trucking_planning.branch</field>
        <field name="model">trucking_planning.branch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="plan_prefix" />
                    </group>
                    <notebook>
                        <page string="Users">
                            <field name="user_ids"/>
                        </page>
                        <page string="Vehicles">
                            <field name="vehicle_ids" readonly="1">
                                <list>
                                    <field name="license_plate" string="License Plate" />
                                    <field name="model_id" string="Vehicle Type" />
                                    <field name="engine_type" string="Engine Size"
                                        invisible="vehicle_type == 'trailer'" />
                                    <field name="driver_id" string="Driver"
                                        invisible="vehicle_type == 'trailer'" />
                                    <field name="is_rented" string="Rented" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="hp_trucking_planning_branchs_form_search" model="ir.ui.view">
        <field name="name">trucking.planning.branch.search</field>
        <field name="model">trucking_planning.branch</field>
        <field name="arch" type="xml">
            <search string="List Branchs">
                <field name="name" />
                <field name="plan_prefix" />
            </search>
        </field>
    </record>

    <record id="action_branch" model="ir.actions.act_window">
        <field name="name">Branchs</field>
        <field name="res_model">trucking_planning.branch</field>
        <field name="search_view_id" ref="hp_trucking_planning_branchs_form_search" />
        <field name="view_mode">list,form</field>
    </record>
</odoo>