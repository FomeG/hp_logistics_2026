<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_plan_line_list" model="ir.ui.view">
            <field name="name">plan_line.list</field>
            <field name="model">trucking_planning.plan.line</field>
            <field name="arch" type="xml">
                <list>
                    <header>
                        <button name="action_export_all_plan_lines_excel" 
                                string="Export All to Excel" 
                                type="object" 
                                class="btn-primary" 
                                icon="fa-download"/>
                    </header>
                    <field name="plan_id" string="Plan"/>
                    <field name="code"/>
                    <field name="client_id"/>
                    <field name="tax_number" />
                    <field name="status"/>
                    <field name="route_direction" string="Direction"/>
<!--                    <field name="plan_type" string="Direction"/>-->
                    <field name="route_id"/>
                    <field name="container_summary" string="Container Type/Size"/>
                    <field name="container_number_summary" string="Cont Number"/>
                    <field name="weight_class_summary" string="Weight Class"/>
                    <field name="actual_source_location_id"
                           context="{
                               'form_view_ref': 'hp_trucking_planning.view_location_form',
                               'list_view_ref': 'hp_trucking_planning.view_location_tree'
                           }"/>
                    <field name="actual_destination_location_id"
                           context="{
                               'form_view_ref': 'hp_trucking_planning.view_location_form',
                               'list_view_ref': 'hp_trucking_planning.view_location_tree'
                           }"/>
                    <field name="date"/>
                    <field name="estimate_time_departure" string="Estimate Time Departure"/>
                    <field name="estimate_time_arrival" string="Estimate Time Arrival"/>
                    <field name="container_port_location_id" string="Empty Container Depot"/>
                    <field name="goods_pickup_location_id" string="Place of Pickup" invisible="plan_type == 'import'" required="plan_type == 'export'"/>
                    <field name="goods_delivery_location_id" string="Place of Delivery" invisible="plan_type == 'export'" required="plan_type == 'import'"/>
                    <field name="goods_name"/>
                    <field name="goods_weight"/>
                    <field name="truck_count" string="Trucks" widget="integer"/>
                    <field name="assigned_trucks" string="Assigned Trucks"/>
                    <field name="unassigned_trucks" string="Unassigned Trucks"/>
                    <field name="external_vehicles" string="External Vehicles"/>
                    <field name="combined_vehicles" string="Combined Vehicles"/>
                    <field name="trip_status_summary" string="Trip Status"/>
                    <button name="action_export_plan_line_excel" 
                            string="Export Excel" 
                            type="object" 
                            class="btn-primary" 
                            icon="fa-download"/>
                    <button name="action_add_draft_trip" type="object" string="Add Draft Trip" class="btn-primary"/>
                </list>
            </field>
        </record>
        <record id="view_plan_line_form" model="ir.ui.view">
            <field name="name">plan_line.form</field>
            <field name="model">trucking_planning.plan.line</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="status" widget="statusbar" statusbar_visible="hpl_reject,client_cancel,checking,transfer,rented"/>
                        <button name="action_export_plan_line_excel"
                                string="Export Excel" 
                                type="object" 
                                class="btn-primary" 
                                icon="fa-download"
                                invisible="not id"/>
                        <button name="action_send_message" 
                                string="Send Message to All Drivers" 
                                type="object" 
                                class="btn-success" 
                                icon="fa-paper-plane"
                                invisible="not id or not trip_ids"/>
                        <button name="action_add_truck"
                                string="Add Truck"
                                type="object"
                                class="btn-secondary"
                                icon="fa-plus"
                                invisible="not id"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="plan_id"
                                   widget="many2one_new_tab"
                                   readonly="context.get('default_plan_id', False) or id"
                                   required="1"
                                   options="{'no_create': True, 'no_quick_create': True}"/>
                        </group>
                        <group>
                            <field name="code" required="1"/>
                            <field name="client_id"
                                context="{
                                    'form_view_ref': 'hp_trucking_planning.view_client_form',
                                    'list_view_ref': 'hp_trucking_planning.view_client_tree',
                                    'search_view_ref': 'hp_trucking_planning.view_client_search',
                                    'default_partner_main_type_id': %(hp_components.partner_main_type_client)d,
                                }"
                                options="{'no_quick_create': True}"
                                widget="many2one_new_tab" />
                            <field name="tax_number" readonly="1"/>
                            <field name="status"/>
                            <field name="date" required="1"/>
                            <field name="estimate_time_departure" string="Estimate Time Departure" required="1"/>
                            <field name="estimate_time_arrival" string="Estimate Time Arrival" required="1"/>
                            <field name="container_port_location_id"
                                   string="Empty Container Depot Pickup "
                                   invisible="plan_type == 'import'"
                                   context="{
                                       'default_type':'depot',
                                       'hide_type':True,
                                       'form_view_ref': 'hp_trucking_planning.view_location_form',
                                       'list_view_ref': 'hp_trucking_planning.view_location_tree'
                                   }"
                                   domain="[('type', '=', 'depot')]"/>
                            <field name="container_port_location_id"
                                   string="Empty Container Depot Return "
                                   invisible="plan_type == 'export'"
                                   context="{
                                       'default_type':'depot',
                                       'hide_type':True,
                                       'form_view_ref': 'hp_trucking_planning.view_location_form',
                                       'list_view_ref': 'hp_trucking_planning.view_location_tree'
                                   }"
                                   domain="[('type', '=', 'depot')]"/>
                            <field name="goods_pickup_location_id"
                                   string="Place of Pickup"
                                   invisible="plan_type == 'import' or not route_id"
                                   required="plan_type == 'export' and route_id"
                                   context="{
                                       'default_type':'goods_pickup',
                                       'hide_type':True,
                                       'form_view_ref': 'hp_trucking_planning.view_location_form',
                                       'list_view_ref': 'hp_trucking_planning.view_location_tree'
                                   }"/>
                            <field name="goods_delivery_location_id"
                                   string="Place of Delivery"
                                   invisible="plan_type == 'export' or not route_id"
                                   required="plan_type == 'import' and route_id"
                                   context="{
                                       'default_type':'port',
                                       'hide_type':True,
                                       'form_view_ref': 'hp_trucking_planning.view_location_form',
                                       'list_view_ref': 'hp_trucking_planning.view_location_tree'
                                   }"/>
                        </group>

                        <div class="oe_button_box" name="button_box" invisible="not id">
                            <button name="action_view_trips"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-truck"
                                    invisible="not trip_ids">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="trip_ids" widget="statinfo" string="Truck"/>
                                    </span>
                                </div>
                            </button>
                            <button name="action_add_truck"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-plus">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Add Truck</span>
                                </div>
                            </button>
                            <button name="action_add_draft_trip" type="object" string="Add Draft Trip" class="btn-primary" icon="fa-plus"/>
<!--                            Back to Plan Button-->
                            <button name="action_back_to_plan"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-arrow-left">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Back to Plan</span>
                                </div>
                            </button>
<!--                            View All Plan Trips Button-->
                            <button name="action_view_plan_all_trips"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-list"
                                    invisible="not trip_ids">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">View All Trucks</span>
                                </div>
                            </button>
                        </div>

                        <notebook>
                            <page string="Route">
                                <group>
                                    <field name="route_id" context="{'client_id': client_id}"/>
                                    <field name="actual_source_location_id"
                                           readonly="1"
                                           options="{'no_create': True, 'no_edit': True}"
                                           context="{
                                               'form_view_ref': 'hp_trucking_planning.view_location_form',
                                               'list_view_ref': 'hp_trucking_planning.view_location_tree'
                                           }"/>
                                    <field name="actual_destination_location_id"
                                           readonly="1"
                                           options="{'no_create': True, 'no_edit': True}"
                                           context="{
                                               'form_view_ref': 'hp_trucking_planning.view_location_form',
                                               'list_view_ref': 'hp_trucking_planning.view_location_tree'
                                           }"/>
                                    <field name="route_direction" string="Direction" readonly="1"/>
<!--                                    <field name="plan_type" string="Direction"/>-->
                                </group>
                            </page>

                            <page string="Truck" invisible="not trip_ids">
                                 <field name="trip_ids" nolabel="1" readonly="1" create="0" delete="0" edit="0">
                                    <list create="false" delete="false" edit="false" open_form_view="true">
                                        <field name="container_number"/>
                                        <field name="seal_number"/>
                                        <field name="container_type"/>
                                        <field name="container_size"/>
                                        <field name="truck_id"/>
                                        <field name="driver_id"/>
                                        <field name="weight_class"/>
                                        <field name="fuel_liters"/>
                                        <field name="total_cost"/>
                                        <field name="status"/>
                                        <button name="action_open_truck_detail"
                                                string="Edit"
                                                type="object"
                                                class="btn-primary btn-sm"
                                                icon="fa-edit"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Notes">
                                <group>
                                    <field name="note"/>
                                </group>
                            </page>
                            <page string="Goods Info">
                                <group>
                                    <field name="goods_name"/>
                                    <field name="goods_weight"/>
<!--                                    <field name="goods_cut_off"/>-->
                                </group>
                            </page>
                            <!--
                            <page string="Excel Export Fields">
                                <group>
                                    <field name="sequence"/>
                                    <field name="delivery_location"/>
                                    <field name="contact_info"/>
                                    <field name="operation_type"/>
                                    <field name="turnaround"/>
                                    <field name="goods_return"/>
                                    <field name="external_vehicle"/>
                                    <field name="owner_code"/>
                                </group>
                                <group>
                                    <field name="road_fee"/>
                                    <field name="distance"/>
                                    <field name="fuel_before"/>
                                    <field name="fuel_received"/>
                                    <field name="fuel_total"/>
                                    <field name="loading_location"/>
                                    <field name="loading_cost"/>
                                    <field name="unloading_location"/>
                                    <field name="unloading_cost"/>
                                </group>
                                <group>
                                    <field name="contract_number"/>
                                    <field name="declaration_number"/>
                                    <field name="price_code"/>
                                </group>
                            </page>
                            -->
                        </notebook>
                    </sheet>
                    <chatter />
                </form>
            </field>
        </record>
        <record id="view_plan_line_search" model="ir.ui.view">
            <field name="name">plan_line.search</field>
            <field name="model">trucking_planning.plan.line</field>
            <field name="arch" type="xml">
                <search>
                    <field name="create_date" string="Created Date"/>

                    <filter name="date_filter" string="Created Date" date="create_date"/>
                    <filter string="Created Today" name="created_today" domain="[('create_date','&gt;=', context_today())]"/>
                    <field name="code"/>
                    <field name="plan_id" string="Plan"/>
                    <field name="client_id"/>
                    <field name="tax_number"/>
                    <field name="status"/>
                    <field name="route_id"/>
                    <field name="goods_name"/>
                    <field name="truck_count" string="Trucks"/>

                    <filter string="HPL Reject" name="hpl_reject" domain="[('status', '=', 'hpl_reject')]"/>
                    <filter string="Client Cancel" name="client_cancel" domain="[('status', '=', 'client_cancel')]"/>
                    <filter string="Checking" name="checking" domain="[('status', '=', 'checking')]"/>
                    <filter string="Transfer" name="transfer" domain="[('status', '=', 'transfer')]"/>
                    <filter string="Rented" name="rented" domain="[('status', '=', 'rented')]"/>
                    <filter string="Export" name="export" domain="[('plan_type', '=', 'export')]"/>
                    <filter string="Import" name="import" domain="[('plan_type', '=', 'import')]"/>
                    <filter string="Not Cancelled" name="not_cancelled" domain="[('status', '!=', 'client_cancel')]" />

                    <group expand="0" string="Group By">
                        <filter string="Created Date" name="create_date" domain="['&amp;', ('create_date', '>=', self), ('create_date', '&lt;=', self + relativedelta(days=1))]" context="{'group_by':'create_date:day'}"/>
                        <filter string="Status" name="group_by_status" context="{'group_by':'status'}"/>
                        <filter string="Client" name="group_by_client" context="{'group_by':'client_id'}"/>
                        <filter string="Plan" name="group_by_plan" context="{'group_by':'plan_id'}"/>
                        <filter string="Date" name="group_by_date" context="{'group_by':'date'}"/>
                        <filter string="Tax Number" name="group_by_tax_number" context="{'group_by':'tax_number'}"/>
                        <filter string="Route" name="group_by_route" context="{'group_by':'route_id'}"/>
                        <filter string="Direction" name="group_by_direction" context="{'group_by':'route_direction'}"/>
                        <filter string="Truck Count" name="group_by_truck_count" context="{'group_by':'truck_count'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_plan_line" model="ir.actions.act_window">
            <field name="name">Jobs</field>
            <field name="res_model">trucking_planning.plan.line</field>
            <field name="view_mode">list,form</field>
            <field name="context">
                {
                    'default_status': 'checking',
                    'search_default_not_cancelled': 1,
                    'search_default_date_filter': 1,
                }
            </field>
        </record>

    </data>
</odoo>