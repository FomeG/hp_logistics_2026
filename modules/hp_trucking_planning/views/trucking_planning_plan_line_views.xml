<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_plan_line_list" model="ir.ui.view">
        <field name="name">plan_line.list</field>
        <field name="model">trucking_planning.plan.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="date"/>
                <field name="client_id"/>
                <field name="tax_number" />
                <field name="status"/>
                <field name="booking"/>
                <field name="plan_type"/>
                <field name="container_type"/>
                <field name="container_size"/>
                <field name="shipping_line_id"/>
                <field name="actual_source_location_id"/>
                <field name="container_pickup"/>
                <field name="goods_pickup_delivery"/>
                <field name="contact_phone"/>
                <field name="container_delivery"/>
                <field name="actual_destination_location_id"/>
                <field name="driver_id" />
                <field name="truck_id" />
                <field name="trailer_id" />
                <field name="is_rented"/>
                <field name="note"/>
                <field name="weight_class"/>
                <field name="fuel_liters"/>
                <field name="plan_total_cost"/>
            </list>
        </field>
    </record>
    <record id="view_plan_line_form" model="ir.ui.view">
        <field name="name">plan_line.form</field>
        <field name="model">trucking_planning.plan.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="date"/>
                        <field name="status"/>
                        <field name="client_id"/>
                        <field name="shipping_line_id"/>
                        <field name="tax_number" readonly="1"/>
                        <field name="booking"/>
                    </group>
                    <notebook>
                        <page string="Container Info">
                            <group>
                                <field name="container_number"/>
                                <field name="seal_number"/>
                                <field name="container_type"/>
                                <field name="container_size"/>
                                <field name="plan_type"/>
                                <field name="weight_class"/>
                            </group>
                        </page>
                        <page string="Route / Locations">
                            <group>
                                <field name="route_id"/>
                                <field name="actual_source_location_id" readonly="1"/>
                                <field name="actual_destination_location_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="container_pickup"/>
                                <field name="goods_pickup_delivery"/>
                                <field name="contact_phone" readonly="1"/>
                                <field name="container_delivery"/>
                            </group>
                        </page>
                        <page string="Driver/Vehicle">
                            <group>
                                <field name="driver_id"/>
                                <field name="truck_id" readonly="1"/>
                                <field name="trailer_id" readonly="1"/>
                                <field name="is_rented" readonly="1"/>
                                <field name="contract_number"/>
                            </group>
                            <group>
                                <field name="fuel_liters" readonly="1"/>
                                <field name="plan_total_cost" readonly="1"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_trip" model="ir.actions.act_window">
        <field name="name">Trips</field>
        <field name="res_model">trucking_planning.plan.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_status': 'checking'}</field>
    </record>
</odoo>