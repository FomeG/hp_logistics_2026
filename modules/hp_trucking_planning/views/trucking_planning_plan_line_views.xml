<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_plan_line_list" model="ir.ui.view">
            <field name="name">plan_line.list</field>
            <field name="model">trucking_planning.plan.line</field>
            <field name="arch" type="xml">
                <list>
                    <header>
                        <button name="action_export_all_plan_lines_excel" 
                                string="Export All to Excel" 
                                type="object" 
                                class="btn-primary" 
                                icon="fa-download"/>
                    </header>
                    <field name="plan_id" string="Plan"/>
                    <field name="code"/>
<!--                    <field name="date"/>-->
                    <field name="client_id"/>
                    <field name="tax_number" />
                    <field name="status"/>
<!--                    <field name="booking"/>-->
                    <field name="plan_type" string="Direction"/>
                    <field name="route_id"/>
                    <field name="actual_source_location_id"/>
                    <field name="actual_destination_location_id"/>
                    <field name="goods_name"/>
                    <field name="goods_weight"/>
<!--                    <field name="shipping_line_id"/>-->
<!--                    <field name="route_info"/>-->
<!--                    <field name="container_info"/>-->
<!--                    <field name="location_info" />-->
<!--                    <field name="driver_info" />-->
                    <button name="action_export_plan_line_excel" 
                            string="Export Excel" 
                            type="object" 
                            class="btn-primary" 
                            icon="fa-download"/>
                </list>
            </field>
        </record>
        <record id="view_plan_line_form" model="ir.ui.view">
            <field name="name">plan_line.form</field>
            <field name="model">trucking_planning.plan.line</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="status" widget="statusbar" statusbar_visible="hpl_reject,client_cancel,checking,transfer,rented"/>
                        <button name="action_export_plan_line_excel" 
                                string="Export Excel" 
                                type="object" 
                                class="btn-primary" 
                                icon="fa-download"/>
<!--                        <button name="action_preview_trip_order" string="Preview Trip Order" type="object" class="btn-secondary"/>-->
<!--                         <button name="action_export_trip_docx" string="Print Trip Order" type="object" class="btn-primary"/>-->
                    </header>
                    <sheet>
                        <group>
                            <field name="plan_id" widget="many2one_new_tab" />
                        </group>
                        <group>
                            <field name="code"/>
<!--                            <field name="date"/>-->
                            <field name="client_id"
                                domain="[('assign_user_id', '=', uid)]"
                                widget="many2one_new_tab" />
<!--                            <field name="shipping_line_id" widget="many2one_new_tab" />-->
                            <field name="tax_number" readonly="1"/>
<!--                            <field name="booking"/>-->
                            <field name="status"/>
                        </group>

                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_trips"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-truck">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="trip_ids" widget="statinfo" string="Truck"/>
                                    </span>
                                </div>
                            </button>
                            <button name="action_add_truck"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-plus">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Add Truck</span>
                                </div>
                            </button>
                        </div>

                        <notebook>
                            <page string="Route">
                                <group>
                                    <field name="route_id"/>
                                    <field name="actual_source_location_id" readonly="1"
                                        widget="many2one_new_tab" />
                                    <field name="actual_destination_location_id" readonly="1"
                                        widget="many2one_new_tab" />
<!--                                    <field name="freeway" />-->
                                    <field name="plan_type" string="Direction"/>
<!--                                    <field name="weight_class"/>-->
                                </group>
<!--                                <group>-->
<!--                                    <field name="driver_id" widget="many2one_new_tab" />-->
<!--                                    <field name="truck_id" readonly="1" widget="many2one_new_tab" />-->
<!--                                    <field name="trailer_id" readonly="1" widget="many2one_new_tab" />-->
<!--                                    <field name="is_rented" readonly="1"/>-->
<!--                                    <field name="contract_number"/>-->
<!--                                </group>-->
<!--                                <group>-->
<!--                                    <field name="extra_charge" />-->
<!--                                    <field name="extra_fuel" />-->
<!--                                </group>-->
<!--                                <group>-->
<!--                                    <field name="fuel_liters" readonly="1"/>-->
<!--                                    <field name="total_cost" readonly="1"/>-->
<!--                                </group>-->
                            </page>
<!--                            <page string="Locations">-->
<!--                                <group>-->
<!--                                    <field name="container_pickup"/>-->
<!--                                    <field name="goods_pickup_delivery"/>-->
<!--                                    <field name="contact_phone" readonly="1"/>-->
<!--                                    <field name="container_delivery"/>-->
<!--                                </group>-->
<!--                            </page>-->
<!--                            <page string="Container Info">-->
<!--                                <group>-->
<!--                                    <field name="container_number"/>-->
<!--                                    <field name="seal_number"/>-->
<!--                                    <field name="container_type"/>-->
<!--                                    <field name="container_size"/>-->
<!--                                </group>-->
<!--                            </page>-->
                            <page string="Truck" invisible="not trip_ids">
                                 <field name="trip_ids" nolabel="1" readonly="1" create="0" delete="0" edit="0">
                                    <list create="false" delete="false" edit="false">
<!--                                        <field name="code" string="Trip Code"/>-->
                                        <field name="container_number"/>
                                        <field name="seal_number"/>
                                        <field name="container_type"/>
                                        <field name="container_size"/>
                                        <field name="truck_id"/>
                                        <field name="driver_id"/>
                                        <field name="weight_class"/>
                                        <field name="fuel_liters"/>
                                        <field name="total_cost"/>
                                        <field name="status"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Notes">
                                <group>
                                    <field name="note"/>
                                </group>
                            </page>
                            <page string="Goods Info">
                                <group>
                                    <field name="goods_name"/>
                                    <field name="goods_weight"/>
<!--                                    <field name="goods_cut_off"/>-->
                                </group>
                            </page>
                            <!--
                            <page string="Excel Export Fields">
                                <group>
                                    <field name="sequence"/>
                                    <field name="delivery_location"/>
                                    <field name="contact_info"/>
                                    <field name="operation_type"/>
                                    <field name="turnaround"/>
                                    <field name="goods_return"/>
                                    <field name="external_vehicle"/>
                                    <field name="owner_code"/>
                                </group>
                                <group>
                                    <field name="road_fee"/>
                                    <field name="distance"/>
                                    <field name="fuel_before"/>
                                    <field name="fuel_received"/>
                                    <field name="fuel_total"/>
                                    <field name="loading_location"/>
                                    <field name="loading_cost"/>
                                    <field name="unloading_location"/>
                                    <field name="unloading_cost"/>
                                </group>
                                <group>
                                    <field name="contract_number"/>
                                    <field name="declaration_number"/>
                                    <field name="price_code"/>
                                </group>
                            </page>
                            -->
                        </notebook>
                    </sheet>
                    <chatter />
                </form>
            </field>
        </record>
        <record id="view_plan_line_search" model="ir.ui.view">
            <field name="name">plan_line.search</field>
            <field name="model">trucking_planning.plan.line</field>
            <field name="arch" type="xml">
                <search>
                    <field name="code"/>
                    <field name="plan_id" string="Plan"/>
                    <field name="client_id"/>
<!--                    <field name="booking" />-->
                    <field name="status"/>
                    <field name="route_id"/>
                    <field name="goods_name"/>
<!--                    <field name="driver_id"/>-->
<!--                    <field name="truck_id"/>-->
<!--                    <field name="plan_month" />-->
<!--                    <field name="plan_year" />-->
<!--                    <filter string="Freeway Trips" name="freeway" domain="[('freeway','=',True)]"/>-->

                    <filter string="HPL Reject" name="hpl_reject" domain="[('status', '=', 'hpl_reject')]"/>
                    <filter string="Client Cancel" name="client_cancel" domain="[('status', '=', 'client_cancel')]"/>
                    <filter string="Checking" name="checking" domain="[('status', '=', 'checking')]"/>
                    <filter string="Transfer" name="transfer" domain="[('status', '=', 'transfer')]"/>
                    <filter string="Rented" name="rented" domain="[('status', '=', 'rented')]"/>
                    <filter string="Export" name="export" domain="[('plan_type', '=', 'export')]"/>
                    <filter string="Import" name="import" domain="[('plan_type', '=', 'import')]"/>

                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_by_status" context="{'group_by':'status'}"/>
                        <filter string="Client" name="group_by_client" context="{'group_by':'client_id'}"/>
                        <filter string="Route" name="group_by_route" context="{'group_by':'route_id'}"/>
                        <filter string="Direction" name="group_by_direction" context="{'group_by':'plan_type'}"/>
<!--                        <filter string="Driver" name="group_by_driver" context="{'group_by':'driver_id'}"/>-->
<!--                        <filter string="Date" name="group_by_date" context="{'group_by':'date:day'}"/>-->
<!--                        <filter string="Month" name="plan_month" context="{'group_by': 'plan_month'}" />-->
<!--                        <filter string="Year" name="plan_year" context="{'group_by': 'plan_year'}" />-->
                    </group>
                </search>
            </field>
        </record>

        <record id="action_plan_line" model="ir.actions.act_window">
            <field name="name">Plan Lines</field>
            <field name="res_model">trucking_planning.plan.line</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'default_status': 'checking'}</field>
        </record>
<!--        <record id="action_trip" model="ir.actions.act_window">-->
<!--            <field name="name">Trips</field>-->
<!--            <field name="res_model">trucking_planning.plan.line</field>-->
<!--            <field name="view_mode">list,form</field>-->
<!--            <field name="context">{'default_status': 'checking'}</field>-->
<!--        </record>-->
    </data>
</odoo>