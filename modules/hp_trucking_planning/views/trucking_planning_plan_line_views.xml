<!--                            <field name="tax_number" readonly="1"/>-->
<!--                            <field name="booking"/>-->
                        </group>
                        <notebook>
                            <page string="Route/Driver/Vehicle">
                                <group>
                                    <field name="route_id"/>
                                    <field name="actual_source_location_id" readonly="1"
                                        widget="many2one_new_tab" />
                                    <field name="actual_destination_location_id" readonly="1"
                                        widget="many2one_new_tab" />
<!--                                    <field name="freeway" />-->
                                    <field name="plan_type" string="Direction"/>
<!--                                    <field name="weight_class"/>-->
                                </group>
<!--                                <group>-->
<!--                                    <field name="driver_id" widget="many2one_new_tab" />-->
<!--                                    <field name="truck_id" readonly="1" widget="many2one_new_tab" />-->
<!--                                    <field name="trailer_id" readonly="1" widget="many2one_new_tab" />-->
<!--                                    <field name="is_rented" readonly="1"/>-->
<!--                                    <field name="contract_number"/>-->
<!--                                </group>-->
<!--                                <group>-->
<!--                                    <field name="extra_charge" />-->
<!--                                    <field name="extra_fuel" />-->
<!--                                </group>-->
<!--                                <group>-->
<!--                                    <field name="fuel_liters" readonly="1"/>-->
<!--                                    <field name="total_cost" readonly="1"/>-->
<!--                                </group>-->
                            </page>
<!--                            <page string="Locations">-->
<!--                                <group>-->
<!--                                    <field name="container_pickup"/>-->
<!--                                    <field name="goods_pickup_delivery"/>-->
<!--                                    <field name="contact_phone" readonly="1"/>-->
<!--                                    <field name="container_delivery"/>-->
<!--                                </group>-->
<!--                            </page>-->
<!--                            <page string="Container Info">-->
<!--                                <group>-->
<!--                                    <field name="container_number"/>-->
<!--                                    <field name="seal_number"/>-->
<!--                                    <field name="container_type"/>-->
<!--                                    <field name="container_size"/>-->
<!--                                </group>-->
<!--                            </page>-->
                            <page string="Notes">
                                <group>
                                    <field name="note"/>
                                </group>
                            </page>
                            <page string="Goods Info">
                                <group>
                                    <field name="goods_name"/>
                                    <field name="goods_weight"/>
<!--                                    <field name="goods_cut_off"/>-->
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter />
                </form>
            </field>
        </record>
        <record id="view_plan_line_search" model="ir.ui.view">
            <field name="name">plan_line.search</field>
            <field name="model">trucking_planning.plan.line</field>
            <field name="arch" type="xml">
                <search>
                    <field name="code"/>
                    <field name="client_id"/>
<!--                    <field name="booking" />-->
                    <field name="status"/>
<!--                    <field name="driver_id"/>-->
<!--                    <field name="truck_id"/>-->
<!--                    <field name="plan_month" />-->
<!--                    <field name="plan_year" />-->
<!--                    <filter string="Freeway Trips" name="freeway" domain="[('freeway','=',True)]"/>-->

                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_by_status" context="{'group_by':'status'}"/>
                        <filter string="Client" name="group_by_client" context="{'group_by':'client_id'}"/>
<!--                        <filter string="Driver" name="group_by_driver" context="{'group_by':'driver_id'}"/>-->
<!--                        <filter string="Date" name="group_by_date" context="{'group_by':'date:day'}"/>-->
<!--                        <filter string="Month" name="plan_month" context="{'group_by': 'plan_month'}" />-->
<!--                        <filter string="Year" name="plan_year" context="{'group_by': 'plan_year'}" />-->
                    </group>
                </search>
            </field>
        </record>
