<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_driver_tree" model="ir.ui.view">
        <field name="name">driver.tree</field>
        <field name="model">trucking_planning.driver</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone_number"/>
                <field name="license_number"/>
            </list>
        </field>
    </record>
    <record id="view_driver_form" model="ir.ui.view">
        <field name="name">driver.form</field>
        <field name="model">trucking_planning.driver</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="phone_number"/>
                        <field name="cccd"/>
                        <field name="license_number"/>
                        <field name="contract_date"/>
                    </group>
                    <notebook>
                        <page string="Trips">
                            <field name="plan_line_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="date"/>
                                    <field name="route_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Vehicles">
                            <field name="vehicle_driver_history_ids" readonly="True">
                                <list>
                                    <field name="vehicle_id"/>
                                    <field name="action"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_driver" model="ir.actions.act_window">
        <field name="name">Drivers</field>
        <field name="res_model">trucking_planning.driver</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>