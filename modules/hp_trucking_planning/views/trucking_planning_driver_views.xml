<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_driver_tree" model="ir.ui.view">
        <field name="name">driver.tree</field>
        <field name="model">trucking_planning.driver</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone_number"/>
                <field name="license_number"/>
                <field name="truck_id"/>
                <field name="trailer_id"/>
            </list>
        </field>
    </record>
    <record id="view_driver_form" model="ir.ui.view">
        <field name="name">driver.form</field>
        <field name="model">trucking_planning.driver</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="phone_number"/>
                        <field name="cccd"/>
                        <field name="license_number"/>
                        <field name="contract_date"/>
                    </group>
                    <group>
                        <field name="truck_id" domain="[('type', '=', 'truck')]"/>
                        <field name="truck_registration_date"/>
                        <field name="trailer_id" domain="[('type', '=', 'trailer')]"/>
                        <field name="trailer_registration_date"/>
                    </group>
                    <notebook>
                        <page string="Plans">
                            <field name="plan_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="date"/>
                                    <field name="route_id"/>
                                    <field name="container_number"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_driver" model="ir.actions.act_window">
        <field name="name">Drivers</field>
        <field name="res_model">trucking_planning.driver</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>