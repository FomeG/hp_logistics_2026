<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_driver_tree" model="ir.ui.view">
        <field name="name">partner.driver.tree</field>
        <field name="model">res.partner.driver</field>
        <field name="arch" type="xml">
            <list string="Drivers">
                <field name="name" />
                <field name="phone" />
                <field name="ref" string="CCCD" />
                <field name="license_number" />
                <field name="license_issue_date" />
                <field name="license_expiry_date"/>
                <field name="create_date" groups="base.group_system" />
            </list>
        </field>
    </record>

    <record id="view_driver_form" model="ir.ui.view">
        <field name="name">partner.driver.form</field>
        <field name="model">res.partner.driver</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                        invisible="active" />
                    <field name="image_1920" widget="image" class="oe_avatar"
                        options="{'preview_image':'image_128'}" />

                    <div class="oe_title mb48">
                        <h1>
                            <field name="name" placeholder="e.g. Driver Name" required="1" />
                        </h1>
                    </div>
                    <group>
                        <field name="phone" required="1"/>
                        <field name="ref" string="CCCD" required="1" />
                        <field name="license_number" required="1" />
                    </group>
                    <group string="Vehicle Assignation History">
                        <field name="vehicle_assignation_ids">
                            <list>
                                <field name="vehicle_id" string="Vehicle"/>
                                <field name="date_start" string="Start Date"/>
                                <field name="date_end" string="End Date"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_driver_search" model="ir.ui.view">
        <field name="name">partner.driver.search</field>
        <field name="model">res.partner.driver</field>
        <field name="arch" type="xml">
            <search string="List Drivers">
                <field name="name" />
                <field name="phone" />
                <field name="ref" string="CCCD" />
                <field name="license_number" />
            </search>
        </field>
    </record>

    <record id="action_driver" model="ir.actions.act_window">
        <field name="name">Drivers</field>
        <field name="res_model">res.partner.driver</field>
        <field name="search_view_id" ref="view_driver_search" />
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_driver_tree" />
        <field name="domain">[]</field>
        <field name="context"
            eval="{
                'default_partner_main_type_id': ref('hp_trucking_planning.partner_main_type_driver')
            }" />
    </record>
</odoo>