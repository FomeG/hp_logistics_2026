<odoo>
    <record id="view_ms_graph_user_form" model="ir.ui.view">
        <field name="name">ms.graph.user.form</field>
        <field name="model">ms.graph.user</field>
        <field name="arch" type="xml">
            <form string="Microsoft User Info" create="0" delete="0">
                <header>
                    <button name="fetch_and_forward_mail_single"
                            type="object"
                            string="Fetch MS User"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="user_id" readonly="1"/>
                        <field name="x_has_fetched_all" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_open_ms_graph_user" model="ir.actions.server">
        <field name="name">MS Graph User</field>
        <field name="model_id" ref="model_ms_graph_user"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_my_profile()</field>
    </record>



</odoo>