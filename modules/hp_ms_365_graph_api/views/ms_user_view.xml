<odoo>
    <record id="view_ms_graph_user_form" model="ir.ui.view">
        <field name="name">ms.graph.user.form</field>
        <field name="model">ms.graph.user</field>
        <field name="arch" type="xml">
            <form string="Microsoft User Info">
                <header>
            <button name="fetch_and_forward_mail_single"
                    type="object"
                    string="Fetch MS User"
                    class="btn-primary"/>
                            </header>
                            <sheet>
                                <group>
                                    <field name="subject"/>
                                    <field name="sender"/>
                                    <field name="body"/>
                                    <field name="raw_data" widget="text"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </record>

    <record id="action_ms_graph_user" model="ir.actions.act_window">
        <field name="name">MS Graph User</field>
        <field name="res_model">ms.graph.user</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
