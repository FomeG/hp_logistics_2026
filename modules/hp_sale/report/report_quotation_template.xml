<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_quotation_document">
        <t t-call="web.basic_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <div class="page" style="font-family: Arial, sans-serif; font-size: 11pt;">
                <div style="text-align: center; margin-bottom: 10px;">
                    <table style="width: 100%; border: none;">
                        <tr>
                            <td style="width: 20%; vertical-align: top; text-align: left;">
                                <img t-if="doc.company_id.logo"
                                     t-att-src="image_data_uri(doc.company_id.logo)"
                                     style="max-height: 70px; max-width: 150px;"
                                     alt="Company Logo"/>
                                <br/>
                                <span style="font-size: 8pt;">www.hplogistics.com.vn</span>
                            </td>
                            <td style="width: 80%; vertical-align: top; text-align: center;">
                                <div style="font-size: 9pt; color: #0066cc; font-weight: bold; margin-bottom: 5px;">
                                    HỆ THỐNG ĐẠI LÝ HÀNG HÓA VÀ TÀU BIỂN HÀNG ĐẦU VIỆT NAM
                                </div>
                                <div style="margin-bottom: 10px;">
                                    <img src="/hp_sale/static/img/logoshippingline.jpg"
                                         style="max-width: 600px; height: auto;"
                                         alt="Shipping Lines"/>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>

                <div style="text-align: center; margin: 15px 0;">
                    <h3 style="color: #cc0000; font-weight: bold; margin: 5px 0;">BẢNG BÁO GIÁ</h3>
                    <div style="font-size: 10pt;">Số báo giá: <strong><span t-field="doc.name"/></strong></div>
                </div>

                <!-- Thông tin 2 cột -->
                <table style="width: 100%; border: 1px solid #000; margin-bottom: 10px; font-size: 9pt;">
                    <tr>
                        <td style="width: 50%; padding: 5px; border-right: 1px solid #000; vertical-align: top;">
                            <div><strong>Khách hàng:</strong></div>
                            <div style="margin: 3px 0;"><strong>Người liên hệ:</strong></div>
                            <div style="margin: 3px 0;"><strong>Địa chỉ:</strong></div>
                            <div style="margin: 3px 0;"><strong>Tel:</strong></div>
                            <div style="margin: 3px 0;">Email:</div>
                            <div style="margin: 3px 0;">Fax:</div>
                        </td>
                        <td style="width: 50%; padding: 5px; vertical-align: top;">
                            <div style="text-align: right;">Ngày báo giá: <span t-field="doc.date_order" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/></div>
                            <div style="margin: 3px 0;">Sales phụ trách: <span t-field="doc.user_id.name"/></div>
                            <div style="margin: 3px 0;">Số điện thoại: <span t-field="doc.user_id.phone"/></div>
                            <div style="margin: 3px 0;">Email: <span t-field="doc.user_id.email"/></div>
                        </td>
                    </tr>
                </table>

                <!-- Lời mở đầu -->
                <div style="margin: 10px 0; font-size: 9pt;">
                    <p style="margin: 3px 0;"><strong>Kính gửi Quý Khách hàng!</strong></p>
                    <p style="margin: 3px 0;">Trước tiên, chúng tôi Công ty cổ phần tiếp vận HP xin chân thành cảm ơn Quý Khách hàng đã quan tâm tới sản phẩm của chúng tôi.</p>
                    <p style="margin: 3px 0;">Nay chúng tôi xin báo giá dịch vụ cước biển, khai báo hải quan và dịch vụ trucking với nội dung chi tiết như sau:</p>
                </div>

                <!-- Thông tin ETD và Tỷ giá -->
                <div style="margin: 10px 0; font-size: 9pt;">
                    <span style="margin-right: 30px;">Tỷ giá: <strong><span t-esc="'{:,.0f}'.format(doc.currency_rate or 25000)"/></strong> VNĐ/USD</span>
                    <span>ETD: <strong><span t-field="doc.etd" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/></strong></span>
                </div>

                <!-- Bảng chi tiết -->
                <table style="width: 100%; border-collapse: collapse; font-size: 8pt; margin: 10px 0;">
                    <thead>
                        <tr style="background-color: #f0f0f0;">
                            <th style="border: 1px solid #000; padding: 5px; text-align: center; width: 3%;">No.</th>
                            <th style="border: 1px solid #000; padding: 5px; text-align: center; width: 22%;">Descriptions<br/>(Mô tả)</th>
                            <th style="border: 1px solid #000; padding: 5px; text-align: center; width: 8%;">Line<br/>(Hãng tàu)</th>
                            <th style="border: 1px solid #000; padding: 5px; text-align: center; width: 7%;">Amount<br/>(ĐVT)</th>
                            <th style="border: 1px solid #000; padding: 5px; text-align: center; width: 7%;">Type<br/>(Loại)</th>
                            <th style="border: 1px solid #000; padding: 5px; text-align: center; width: 5%;">Q'ty<br/>(Số lượng)</th>
                            <th style="border: 1px solid #000; padding: 5px; text-align: center; width: 8%;">U.price<br/>(USD)</th>
                            <th style="border: 1px solid #000; padding: 5px; text-align: center; width: 9%;">U.price<br/>(VNĐ)</th>
                            <th style="border: 1px solid #000; padding: 5px; text-align: center; width: 5%;">VAT<br/>(%)</th>
                            <th style="border: 1px solid #000; padding: 5px; text-align: center; width: 10%;">Total Amount<br/>(VNĐ)</th>
                            <th style="border: 1px solid #000; padding: 5px; text-align: center; width: 8%;">ETD</th>
                            <th style="border: 1px solid #000; padding: 5px; text-align: center; width: 8%;">Note</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="line_number" t-value="1"/>
                        <t t-foreach="doc.order_line" t-as="line">
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center;"><span t-esc="line_number"/></td>
                                <td style="border: 1px solid #000; padding: 4px;"><span t-field="line.name"/></td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center;"><span t-field="doc.shipping_line_id.name"/></td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center;"><span t-field="line.product_uom.name"/></td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center;">''</td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center;"><span t-field="line.product_uom_qty"/></td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: right;">
                                    <span t-if="doc.currency_id.name == 'USD'" t-esc="'{:,.2f}'.format(line.price_unit)"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: right;">
                                    <span t-esc="'{:,.0f}'.format(line.price_unit * (doc.currency_rate or 25000) if doc.currency_id.name == 'USD' else line.price_unit)"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center;">8%</td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: right;">
                                    <span t-esc="'{:,.0f}'.format(line.price_subtotal * (doc.currency_rate or 25000) * 1.08 if doc.currency_id.name == 'USD' else line.price_subtotal * 1.08)"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                    <span t-field="doc.etd" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px;"></td>
                            </tr>
                            <t t-set="line_number" t-value="line_number + 1"/>
                        </t>
                        <!-- Dòng tổng cộng -->
                        <tr>
                            <td colspan="9" style="border: 1px solid #000; padding: 4px; text-align: right;"><strong>Thành tiền trước thuế VAT:</strong></td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: right;">
                                <strong><span t-esc="'{:,.0f}'.format(doc.amount_untaxed * (doc.currency_rate or 25000) if doc.currency_id.name == 'USD' else doc.amount_untaxed)"/></strong>
                            </td>
                            <td colspan="2" style="border: 1px solid #000;"></td>
                        </tr>
                        <tr>
                            <td colspan="9" style="border: 1px solid #000; padding: 4px; text-align: right;"><strong>Tiền thuế VAT (8%):</strong></td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: right;">
                                <strong><span t-esc="'{:,.0f}'.format(doc.amount_tax * (doc.currency_rate or 25000) if doc.currency_id.name == 'USD' else doc.amount_tax)"/></strong>
                            </td>
                            <td colspan="2" style="border: 1px solid #000;"></td>
                        </tr>
                        <tr>
                            <td colspan="9" style="border: 1px solid #000; padding: 4px; text-align: right;"><strong>Tổng cộng:</strong></td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: right; background-color: #f0f0f0;">
                                <strong><span t-esc="'{:,.0f}'.format(doc.amount_total * (doc.currency_rate or 25000) if doc.currency_id.name == 'USD' else doc.amount_total)"/></strong>
                            </td>
                            <td colspan="2" style="border: 1px solid #000;"></td>
                        </tr>
                    </tbody>
                </table>

                <!-- Điều khoản thanh toán -->
                <div style="margin-top: 15px;">
                    <div style="font-size: 9pt; font-weight: bold; margin-bottom: 5px;">ĐIỀU KHOẢN THANH TOÁN:</div>
                    <ul style="font-size: 8pt; margin: 0; padding-left: 20px; line-height: 1.4;">
                        <li>Phương thức thanh toán:</li>
                        <li>Thời hạn thanh toán:</li>
                        <li>Hiệu lực báo giá:</li>
                        <li>Báo giá không bao gồm chi phí đường cấm, chi phí phát sinh khác (nếu có)</li>
                        <li>Báo giá đã bao gồm VAT, Tỷ giá cước biển sẽ tính theo giá của Vietcombank tại ETD</li>
                        <li>Hải quan (luồng đỏ) giá: 1,000,000 VNĐ (chưa bao gồm VAT), chưa bao gồm kiểm hóa và các chi phí khác tại Hải Phòng</li>
                        <li>Trường hợp lấy hàng hoặc hạ rỗng tại Lạch Huyện phụ thu phí vận chuyển: 500,000 đồng/lần</li>
                    </ul>
                </div>

                <!-- Footer với thông tin ngân hàng và chữ ký -->
                <table style="width: 100%; margin-top: 20px; font-size: 8pt;">
                    <tr>
                        <td style="width: 65%; vertical-align: top;">
                            <div style="font-style: italic; margin-bottom: 5px;">Rất mong được hợp tác với Quý khách hàng!</div>
                            <div style="margin-top: 80px; text-align: center;">
                                <div><strong>Xác nhận khách hàng</strong></div>
                                <div style="margin-top: 40px; font-style: italic;">(Ký, ghi rõ họ tên và đóng dấu)</div>
                            </div>
                        </td>
                        <td style="width: 35%; vertical-align: top; border: 1px solid #000; padding: 8px;">
                            <div><strong>Tên TK: CÔNG TY CỔ PHẦN TIẾP VẬN HP</strong></div>
                            <div style="margin: 3px 0;"><strong>Ngân hàng:</strong> TMCP Á Châu - Chi nhánh Hà Nội</div>
                            <div style="margin: 3px 0;"><strong>STK:</strong> 1303200988</div>
                            <div style="margin-top: 50px; text-align: center;">
                                <div><strong>CÔNG TY CỔ PHẦN TIẾP VẬN HP</strong></div>
                                <div style="margin-top: 40px; font-style: italic;">(Ký, ghi rõ họ tên)</div>
                                <div style="margin-top: 5px;"><strong><span t-field="doc.user_id.name"/></strong></div>
                                <div><span t-field="doc.date_order" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/></div>
                            </div>
                        </td>
                    </tr>
                </table>

                <!-- Footer địa chỉ -->
                <div style="margin-top: 15px; font-size: 8pt; text-align: center; border-top: 1px solid #000; padding-top: 5px;">
                    <div><strong>HÀ NỘI</strong></div>
                    <div>378 Minh Khai, P.Vĩnh Tuy, Q. Hai Bà Trưng</div>
                    <div style="margin-top: 5px;"><strong>HẢI PHÒNG</strong></div>
                    <div>441 Đà Nẵng, Hải An</div>
                    <div style="margin-top: 5px;"><strong>HỒ CHÍ MINH</strong></div>
                    <div>104 Ung Văn Khiêm, Phường 25, Q. Bình Thạnh</div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_quotation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="hp_sale.report_quotation_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>