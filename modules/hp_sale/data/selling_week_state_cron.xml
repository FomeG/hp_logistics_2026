<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Scheduled Action Update State Selling Week -->
        <record id="ir_cron_update_product_prices" model="ir.cron">
            <field name="name">Update State Selling Week</field>
            <field name="model_id" ref="model_selling_week"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_state()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now().replace(hour=0, minute=0, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')" />
        </record>
    </data>
</odoo>