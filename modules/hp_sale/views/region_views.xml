<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Region Form View -->
    <record id="sale_region_form_view" model="ir.ui.view">
        <field name="name">region.form</field>
        <field name="model">region</field>
        <field name="arch" type="xml">
            <form string="Region">
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1" />
                            <field name="code" />
                        </group>
                        <group>
                            <field name="parent_id" />
                            <field name="is_active" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Countries">
                            <field name="country_ids"
                                context="{'form_view_ref': 'hp_freight_purchase.view_country_with_ports_form'}"
                                widget="many2many">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="port_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sub Regions">
                            <field name="child_ids">
                                <list string="Sub Regions">
                                    <field name="code" />
                                    <field name="name" />
                                    <field name="is_active" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Region Tree/List View -->
    <record id="sale_region_list_view" model="ir.ui.view">
        <field name="name">region.list</field>
        <field name="model">region</field>
        <field name="arch" type="xml">
            <list string="Regions">
                <field name="code" />
                <field name="name" />
                <field name="parent_id" string="Continent" />
                <field name="port_count" />
                <field name="is_active" />
                <field name="create_date" />
            </list>
        </field>
    </record>

    <!-- Region Action -->
    <record id="sale_region_action" model="ir.actions.act_window">
        <field name="name">Regions</field>
        <field name="res_model">region</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hp_components.region_search_view" />
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="context"
            eval="{
                'search_default_filter_active': 1,
                'form_view_ref': 'hp_sale.sale_region_form_view',
                'list_view_ref': 'hp_sale.sale_region_list_view'
            }" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Region
            </p>
            <p>
                Regions are used to group countries and locations for organizational purposes.
            </p>
        </field>
    </record>

</odoo>