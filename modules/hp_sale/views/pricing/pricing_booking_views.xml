<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="pricing_booking_form_view" model="ir.ui.view">
        <field name="name">pricing.booking.form</field>
        <field name="model">pricing.booking</field>
        <field name="arch" type="xml">
            <form class="oe_form_configuration">
                <sheet>
                    <div class="oe_title">
                        <label for="booking_no" string="Số booking"/>
                        <h1><field name="booking_no" placeholder="e.g. YMJAM491311743"/></h1>
                    </div>
                    <group>
                        <field name="voyage_id"/>
                        <field name="volume"/>
                        <field name="booking_price"/>
                        <field name="booking_status"/>
                    </group>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pricing_booking_list_view" model="ir.ui.view">
        <field name="name">pricing.booking.list</field>
        <field name="model">pricing.booking</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="DS Booking">
                <field name="booking_no"/>
                <field name="voyage_id"/>
                <field name="volume"/>
                <field name="booking_price"/>
                <field name="booking_status"/>
            </list>
        </field>
    </record>

    <record id="pricing_booking_search_view" model="ir.ui.view">
        <field name="name">pricing.booking.search</field>
        <field name="model">pricing.booking</field>
        <field name="arch" type="xml">
            <search string="DS Hãng tàu">
                <field name="booking_no" string="Số booking"/>
                <field name="voyage_id" string="Tàu và số hiệu chuyến"/>
            </search>
        </field>
    </record>

    <record id="pricing_booking_action_form" model="ir.actions.act_window">
        <field name="name">DS Booking</field>
        <field name="res_model">pricing.booking</field>
        <field name="search_view_id" ref="pricing_booking_search_view"/>
        <field name="view_id" ref="pricing_booking_list_view"/>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
