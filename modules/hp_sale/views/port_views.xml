<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_location_base_list_view" model="ir.ui.view">
        <field name="name">location.base.list</field>
        <field name="model">location.base</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="contact_name" />
                <field name="contact_phone" />
                <field name="region_id"/>
                <field name="create_date" />
            </list>
        </field>
    </record>

    <record id="sale_location_base_form_view" model="ir.ui.view">
        <field name="name">location.base.form</field>
        <field name="model">location.base</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="type" readonly="1"/>
                    </group>
                    <group>
                        <field name="address"/>
                        <field name="contact_phone"/>
                        <field name="parent_id" />
                    </group>
                    <group>
                        <field name="country_id"
                               options="{'no_create': True, 'no_edit': True}"
                        />
                        <field name="state_id"
                            options="{'no_create': True, 'no_edit': True}"
                            widget="many2one_new_tab"
                        />
                    </group>
                    <group name="location_info">
                            <field name="latitude"/>
                            <field name="longitude"/>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="sale_action_location_base" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">location.base</field>
        <field name="search_view_id" ref="hp_components.location_base_form_search" />
        <field name="context"
            eval="{
                'form_view_ref': 'hp_sale.sale_location_base_form_view',
                'list_view_ref': 'hp_sale.sale_location_base_list_view'
            }" />
        <field name="view_mode">list,form</field>
        <field name="domain">[('type', '=', 'port')]</field>
    </record>
</odoo>