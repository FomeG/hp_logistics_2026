<odoo>
    <record id="sale.sale_order_menu" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('sales_team.group_sale_salesman'), ref('sales_team.group_sale_salesman_all_leads'), ref('base.group_system')])]"/>
    </record>

    <record id="sale.menu_sale_quotations" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('sales_team.group_sale_salesman'), ref('sales_team.group_sale_salesman_all_leads'), ref('base.group_system')])]"/>
    </record>

    <record id="sale.menu_sale_order" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('sales_team.group_sale_salesman'), ref('sales_team.group_sale_salesman_all_leads'), ref('base.group_system')])]"/>
    </record>

    <record id="sale.product_menu_catalog" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('sales_team.group_sale_salesman'), ref('sales_team.group_sale_salesman_all_leads'), ref('base.group_system')])]"/>
    </record>

    <record id="sale.menu_products" model="ir.ui.menu">
        <field name="active" eval="True"/>
        <field name="groups_id" eval="[(6, 0, [ref('sales_team.group_sale_salesman'), ref('sales_team.group_sale_salesman_all_leads'), ref('base.group_system')])]"/>
    </record>

    <menuitem id="menu_selling_week"
        name="Week"
        action="action_selling_week"
        parent="sale.product_menu_catalog"
        sequence="5"
        groups="sales_team.group_sale_salesman,sales_team.group_sale_salesman_all_leads,base.group_system"/>

    <menuitem
        id="menu_sale_client"
        name="Clients"
        parent="sale.sale_menu_root"
        sequence="35"
        action="action_res_partner_client"
        groups="sales_team.group_sale_salesman,sales_team.group_sale_salesman_all_leads,base.group_system"/>

    <menuitem
        id="menu_sale_product_selling_week"
        name="Sea Freight"
        parent="sale.sale_menu_root"
        sequence="36"
        action="action_product_template_selling_week"
        groups="sales_team.group_sale_salesman,sales_team.group_sale_salesman_all_leads,base.group_system"/>


    <!-- Hide To Invoice from Salesman -->
    <record id="sale.menu_sale_invoicing" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

    <!-- Hide Product Categories from Salesman -->
    <record id="sale.menu_product_categories" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

    <!-- Hide Product Variants from Salesman-->
    <record id="sale.menu_products" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

    <!-- Hide Product Variants from Salesman-->
    <record id="sale.report_sales_team" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>


    <!-- Hide Pricelists from Salesman-->
    <record id="sale.menu_product_pricelist_main" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

    <!-- Hide Reporting from Salesman -->
    <record id="sale.menu_sale_report" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

    <!-- Hide Configuration from Salesman -->
    <record id="sale.menu_sale_config" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

    <!-- Hide Sales Teams (moved to Configuration) -->
    <record id="sale.sales_team_config" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Hide default Customers menu -->
    <record id="sale.res_partner_menu" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Tools Menu - Only Admin -->
    <menuitem
        id="menu_sale_tools"
        name="Tools"
        parent="sale.sale_menu_root"
        sequence="100"
        groups="base.group_system"/>

    <menuitem
        id="menu_sale_import_client"
        name="Import Client"
        parent="menu_sale_tools"
        sequence="10"
        action="action_import_client_wizard"
        groups="base.group_system"/>

</odoo>