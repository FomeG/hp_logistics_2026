<odoo>

    <!-- Inherit and Move the "Product Categories" Menu to "Products" -->
    <record id="sale.menu_product_categories" model="ir.ui.menu">
        <field name="parent_id" ref="sale.product_menu_catalog"/>
        <field name="sequence">25</field>
    </record>

    <!--            groups="sales_team.group_sale_salesman"-->
    <!-- Parent Menu Pricing-->
    <menuitem id="menu_sale_pricing"
              name="Pricing"
              parent="sale.sale_menu_root"
              sequence="35"/>

    <!-- Pricing Teams and Members-->
    <menuitem id="menu_sale_pricing_team"
              action="action_pricing_team"
              parent="menu_sale_pricing"
              sequence="10"/>

    <menuitem id="menu_sale_pricing_team_member"
              action="action_pricing_team_member"
              parent="menu_sale_pricing"
              sequence="20"/>

    <!-- Parent Menu Trucking-->
    <menuitem id="menu_sale_trucking"
              name="Trucking"
              parent="sale.sale_menu_root"
              sequence="36"/>

    <!-- Submenu: Voyage Management -->
    <menuitem id="menu_pricing_voyage"
              name="Quản lý Tàu hàng"
              parent="menu_sale_pricing"
              sequence="20"/>

    <!-- Pricing Voyage Entries -->
    <menuitem id="menu_sale_pricing_voyage"
              action="pricing_voyage_action_form"
              parent="menu_pricing_voyage"
              sequence="10"/>

    <menuitem id="menu_sale_pricing_booking"
              action="pricing_booking_action_form"
              parent="menu_pricing_voyage"
              sequence="20"/>

    <!-- Submenu: Information Management -->
    <menuitem id="menu_pricing_data"
              name="Danh sách Thông tin"
              parent="menu_sale_pricing"
              sequence="30"/>

    <!-- Pricing Information Entries -->
    <menuitem id="menu_sale_pricing_pol"
              action="pricing_pol_action_form"
              parent="menu_pricing_data"
              sequence="10"/>

    <menuitem id="menu_sale_pricing_pod"
              action="pricing_pod_action_form"
              parent="menu_pricing_data"
              sequence="20"/>

    <menuitem id="menu_sale_pricing_region"
              action="pricing_region_action_form"
              parent="menu_pricing_data"
              sequence="30"/>

    <menuitem id="menu_sale_pricing_shipping_line"
              action="pricing_shipping_line_action_form"
              parent="menu_pricing_data"
              sequence="40"/>

    <menuitem id="menu_sale_pricing_shipping_vessel"
              action="pricing_shipping_vessel_action_form"
              parent="menu_pricing_data"
              sequence="50"/>





    <!-- Trucking Teams and Members-->
    <menuitem id="menu_sale_trucking_team"
              action="action_trucking_team"
              parent="menu_sale_trucking"
              sequence="10"/>

    <menuitem id="menu_sale_trucking_team_member"
              action="action_trucking_team_member"
              parent="menu_sale_trucking"
              sequence="20"/>
    <!-- Child menus with explicit parent references -->


</odoo>