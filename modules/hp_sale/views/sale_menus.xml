<odoo>

    <!-- Inherit and Move the "Product Categories" Menu to "Products" -->
    <record id="sale.menu_product_categories" model="ir.ui.menu">
        <field name="parent_id" ref="sale.product_menu_catalog"/>
        <field name="sequence">25</field>
    </record>

    <!--            groups="sales_team.group_sale_salesman"-->
    <!-- Parent menu -->
    <menuitem id="menu_sale_pricing"
              name="Pricing"
              parent="sale.sale_menu_root"
              sequence="35"/>

    <!-- Child menus with explicit parent references -->
    <menuitem id="menu_sale_pricing_pol"
              action="pricing_pol_action_form"
              parent="menu_sale_pricing"
              sequence="10"/>

    <menuitem id="menu_sale_pricing_pod"
              action="pricing_pod_action_form"
              parent="menu_sale_pricing"
              sequence="20"/>

    <menuitem id="menu_sale_pricing_region"
              action="pricing_region_action_form"
              parent="menu_sale_pricing"
              sequence="30"/>

    <menuitem id="menu_sale_pricing_shipping_line"
              action="pricing_shipping_line_action_form"
              parent="menu_sale_pricing"
              sequence="40"/>

    <menuitem id="menu_sale_pricing_shipping_vessel"
              action="pricing_shipping_vessel_action_form"
              parent="menu_sale_pricing"
              sequence="50"/>

</odoo>