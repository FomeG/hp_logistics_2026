<odoo>
    <!-- Inherit and Move the "Product Categories" Menu to "Products" -->
    <record id="sale.menu_product_categories" model="ir.ui.menu">
        <field name="parent_id" ref="sale.product_menu_catalog"/>
        <field name="sequence">25</field>
    </record>

    <record id="sale.menu_products" model="ir.ui.menu">
        <field name="active" eval="True"/>
    </record>
    <record id="sale.menu_product_categories" model="ir.ui.menu">
        <field name="active" eval="True"/>
    </record>

    <menuitem
        id="menu_sale_tools"
        name="Tools"
        parent="sale.sale_menu_root"
        sequence="100"
        groups="sales_team.group_sale_manager" />

    <record id="sale.res_partner_menu" model="ir.ui.menu">
        <field name="active">False</field>
    </record>

    <menuitem
        id="menu_sale_client"
        name="Clients"
        parent="sale.sale_menu_root"
        sequence="35"
        action="action_res_partner_client"
        groups="sales_team.group_sale_salesman" />

    <menuitem
        id="menu_sale_import_client"
        name="Import Client"
        parent="menu_sale_tools"
        sequence="10"
        action="action_import_client_wizard"
        groups="sales_team.group_sale_manager" />

    <menuitem id="menu_selling_week"
        name="Selling Week"
        action="action_selling_week"
        parent="sale.product_menu_catalog"
        sequence="5"/>

    <menuitem id="menu_product_selling_week"
        name="Product Selling Week"
        action="action_product_template_selling_week" 
        parent="sale.product_menu_catalog"
        sequence="30"/>

</odoo>