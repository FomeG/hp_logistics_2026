<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<record id="quotations_sent_to_lead_list_view" model="ir.ui.view">
        <field name="name">sale.order.list</field>
        <field name="model">sale.order</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <list class="o_sale_order"
                string="Quotation sent to lead"
                create="False"
            >   
                <field name="message_needaction" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="name" string="Number" readonly="1" decoration-bf="1"/>
                <field name="date_order" optional="show" readonly="state in ['cancel', 'sale']"/>
                <field name="partner_id" readonly="1"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="amount_total"
                       sum="Total Tax Included"
                       widget="monetary"
                       decoration-bf="1"
                       decoration-info="invoice_status == 'to invoice'"
                       optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_quotations_send_to_leader" model="ir.actions.act_window">
        <field name="name">Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_id" ref="quotations_sent_to_lead_list_view"/>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="domain">[('state','=','sent_to_leader')]</field>
        <field name="context"
            eval="{
                'form_view_ref': 'sale.view_order_form',
            }" />
    </record>
</odoo>