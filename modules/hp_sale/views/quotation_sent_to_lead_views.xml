<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="quotation_approval_list_view" model="ir.ui.view">
        <field name="name">sale.order.approval.list</field>
        <field name="model">sale.order</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <list class="o_sale_order"
                string="Quotation Approval"
                create="False"
            >
                <field name="message_needaction" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="name" string="Number" readonly="1" decoration-bf="1"/>
                <field name="date_order" optional="show" readonly="state in ['cancel', 'sale']"/>
                <field name="client_id" string="Client" readonly="1"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show" string="Salesperson"/>
                <field name="state" widget="badge" decoration-info="state == 'request_to_approval'" decoration-success="state == 'sale'"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="amount_total"
                       sum="Total Tax Included"
                       widget="monetary"
                       decoration-bf="1"
                       decoration-info="invoice_status == 'to invoice'"
                       optional="show"/>
            </list>
        </field>
    </record>

    <record id="quotation_approval_search_view" model="ir.ui.view">
        <field name="name">sale.order.approval.search</field>
        <field name="model">sale.order</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <search string="Search Quotations">
                <field name="name" string="Order" filter_domain="['|', '|', ('name', 'ilike', self), ('client_id', 'ilike', self), ('partner_id', 'child_of', self)]"/>
                <field name="user_id"/>
                <field name="client_id"/>
                <separator/>
                <filter string="Request to Approval" name="request_to_approval"
                        domain="[('state', '=', 'request_to_approval')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Salesperson" name="salesperson" domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter string="Order Date" name="order_month" domain="[]" context="{'group_by': 'date_order'}"/>
                    <filter string="State" name="state" domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>




    <record id="action_quotation_approval" model="ir.actions.act_window">
        <field name="name">Quotation Approval</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="quotation_approval_list_view"/>
        <field name="search_view_id" ref="quotation_approval_search_view"/>
        <field name="domain">[('is_from_managed_department', '=', True)]</field>
        <field name="context" eval="{
            'search_default_request_to_approval': 1,
            'form_view_ref': 'sale.view_order_form',
        }"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No quotations pending approval
            </p>
        </field>
    </record>
</odoo>
