<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Trucking Team Member Action -->
        <record id="action_trucking_team_member" model="ir.actions.act_window">
            <field name="name">Trucking Team Members</field>
            <field name="res_model">trucking.team.member</field>
            <field name="view_mode">list,form,kanban</field>
            <!-- Replace view_ids with views if you need to specify priority -->
            <field name="views" eval="[(False, 'list'), (False, 'form'), (False, 'kanban')]"/>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create a new Trucking Team Member</p>
                <p>Manage team members and their assigned regions.</p>
            </field>
        </record>

        <!-- Search View for Trucking Team Members -->
        <record id="trucking_team_member_view_search" model="ir.ui.view">
            <field name="name">trucking.team.member.view.search</field>
            <field name="model">trucking.team.member</field>
            <field name="arch" type="xml">
                <search string="Trucking Team Members">
                    <field name="user_id"/>
                    <field name="trucking_team_id"/>
                    <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <!-- Form View for trucking Team Members -->
        <record id="trucking_team_member_view_form" model="ir.ui.view">
            <field name="name">trucking.team.member.form</field>
            <field name="model">trucking.team.member</field>
            <field name="arch" type="xml">
                <form string="Trucking Team Member">
                    <sheet>
                        <group>
                            <field name="user_id" required="1"/>
                            <field name="trucking_team_id" required="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View for Trucking Team Members -->
        <record id="trucking_team_member_view_tree" model="ir.ui.view">
            <field name="name">trucking.team.member.list</field>
            <field name="model">trucking.team.member</field>
            <field name="arch" type="xml">
                <list string="Trucking Team Members">
                    <field name="user_id"/>
                    <field name="trucking_team_id"/>
                </list>
            </field>
        </record>

        <!-- Kanban View for Trucking Team Members -->
        <record id="trucking_team_member_view_kanban" model="ir.ui.view">
            <field name="name">trucking.team.member.view.kanban</field>
            <field name="model">trucking.team.member</field>
            <field name="arch" type="xml">
                <kanban default_group_by="trucking_team_id">
                    <templates>
                        <t t-name="kanban-box">
                            <div class="o_kanban_card">
                                <div class="o_kanban_image">
                                    <field name="user_id" widget="image" options="{'preview_image': 'avatar_128'}"/>
                                </div>
                                <div class="o_kanban_details">
                                    <div><strong><field name="user_id"/></strong></div>
                                    <div><em>Team:</em> <field name="trucking_team_id"/></div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

    </data>
</odoo>
