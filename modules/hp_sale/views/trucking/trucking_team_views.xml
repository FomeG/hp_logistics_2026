<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Search View for Trucking Teams -->
        <record id="trucking_team_view_search" model="ir.ui.view">
            <field name="name">trucking.team.view.search</field>
            <field name="model">trucking.team</field>
            <field name="arch" type="xml">
                <search string="Trucking Teams Search">
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <field name="name"/>
                    <field name="team_manager_id"/>
                    <field name="member_ids"/>
                    <group expand="0" string="Group By...">
                        <filter string="Company" name="company" context="{'group_by': 'company_id'}"/>
                        <filter string="Team Manager" name="team_manager" context="{'group_by': 'team_manager_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Form View for Trucking Teams -->
        <record id="trucking_team_view_form" model="ir.ui.view">
            <field name="name">trucking.team.form</field>
            <field name="model">trucking.team</field>
            <field name="arch" type="xml">
                <form string="Trucking Team">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="e.g. Regional trucking Team"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="active" invisible="1"/>
                                <field name="sequence" invisible="1"/>
                                <field name="team_manager_id" widget="many2one_avatar_user"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="member_company_ids" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Members">
                                <field name="member_ids" mode="kanban" class="w-100"/>
                            </page>
                            <page string="Detailed Members">
                                <field name="trucking_team_member_ids" mode="list,form"
                                    context="{
                                        'form_view_ref': 'trucking_team_member_view_form',
                                        'tree_view_ref': 'trucking_team_member_view_tree',
                                        'default_trucking_team_id': id
                                    }"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View for trucking Teams -->
        <record id="trucking_team_view_tree" model="ir.ui.view">
            <field name="name">trucking.team.list</field>
            <field name="model">trucking.team</field>
            <field name="arch" type="xml">
                <list string="trucking Teams" multi_edit="1">
                    <field name="name"/>
                    <field name="team_manager_id"/>
                    <field name="active"/>
                    <field name="company_id"/>
                </list>
            </field>
        </record>

        <!-- Kanban View for trucking Teams -->
        <record id="trucking_team_view_kanban" model="ir.ui.view">
            <field name="name">trucking.team.view.kanban</field>
            <field name="model">trucking.team</field>
            <field name="arch" type="xml">
                <kanban default_group_by="company_id">
                    <templates>
                        <t t-name="kanban-box">
                            <div class="o_kanban_card">
                                <div class="o_kanban_details">
                                    <strong><field name="name"/></strong>
                                    <div><field name="team_manager_id"/></div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Trucking Team Action -->
       <record id="action_trucking_team" model="ir.actions.act_window">
            <field name="name">Trucking Teams</field>
            <field name="res_model">trucking.team</field>
            <field name="view_mode">list,form,kanban</field>
            <field name="view_id" ref="trucking_team_view_tree"/>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create a new trucking team</p>
                <p>Manage your trucking teams and their members.</p>
            </field>
        </record>


    </data>
</odoo>