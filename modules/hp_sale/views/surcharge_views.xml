<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_hp_surcharge_tree" model="ir.ui.view">
        <field name="name">hp.surcharge.tree</field>
        <field name="model">hp.surcharge</field>
        <field name="arch" type="xml">
            <list string="Surcharges">
                <!-- <field name="code"/> -->
                <field name="name"/>
                <field name="type"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hp_surcharge_form" model="ir.ui.view">
        <field name="name">hp.surcharge.form</field>
        <field name="model">hp.surcharge</field>
        <field name="arch" type="xml">
            <form string="Surcharge">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <!-- <field name="code"/> -->
                            <field name="type"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hp_surcharge_search" model="ir.ui.view">
        <field name="name">hp.surcharge.search</field>
        <field name="model">hp.surcharge</field>
        <field name="arch" type="xml">
            <search string="Surcharges">
                <field name="name"/>
                <field name="code"/>
                <field name="type"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_by_type" context="{'group_by': 'type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hp_surcharge" model="ir.actions.act_window">
        <field name="name">Surcharges</field>
        <field name="res_model">hp.surcharge</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hp_surcharge_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new surcharge
            </p>
            <p>
                Define surcharges that can be applied to freight pricing.
            </p>
        </field>
    </record>
</odoo>
