<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_selling_week_list" model="ir.ui.view">
        <field name="name">selling.week.list</field>
        <field name="model">selling.week</field>
        <field name="arch" type="xml">
            <list string="Selling Weeks" default_order="start_date desc">
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
                <field name="is_active" />
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_selling_week_form" model="ir.ui.view">
        <field name="name">selling.week.form</field>
        <field name="model">selling.week</field>
        <field name="arch" type="xml">
            <form string="Selling Week">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="state"/>
                        <field name="is_active" invisible="not id"/>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_selling_week_search" model="ir.ui.view">
        <field name="name">selling.week.search</field>
        <field name="model">selling.week</field>
        <field name="arch" type="xml">
            <search string="Search Selling Week">
                <field name="name" string="Name"/>
                <field name="year"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <filter string="Active" name="filter_active" domain="[('is_active', '=', True)]"/>
                <filter string="Inactive" name="filter_inactive" domain="[('is_active', '=', False)]"/>

                <field name="state"/>
                <searchpanel>
                    <field name="state" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_selling_week" model="ir.actions.act_window">
        <field name="name">Selling Weeks</field>
        <field name="res_model">selling.week</field>
        <field name="search_view_id" ref="view_selling_week_search" />
        <field name="view_id" ref="view_selling_week_list" />
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first Selling Week
            </p>
        </field>
    </record>

</odoo>
