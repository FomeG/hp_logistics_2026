<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit form view to modify header buttons and statusbar -->
    <record id="view_order_form_inherit_extended_states" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.extended.states</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Hide the control section when not in draft or activated state -->
            <xpath expr="//field[@name='order_line']/list/control" position="attributes">
                <attribute name="invisible">state not in ['draft', 'activated']</attribute>
            </xpath>

<!--            &lt;!&ndash; Also make the entire field readonly when not in draft or activated state &ndash;&gt;-->
<!--            <xpath expr="//field[@name='order_line']" position="attributes">-->
<!--                <attribute name="readonly">state not in ['draft', 'pricing_leader_confirm']</attribute>-->
<!--            </xpath>-->

<!--            &lt;!&ndash; Update the original readonlycondition to include your custom states &ndash;&gt;-->
<!--            <xpath expr="//field[@name='order_line']" position="attributes">-->
<!--                <attribute name="readonly">state not in ['draft', 'pricing_leader_confirm'] or locked</attribute>-->
<!--            </xpath>-->

            <!-- Modify the statusbar -->
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">activated,customer_confirm,sale_leader_confirm,pricing_leader_confirm,sale</attribute>
            </xpath>

            <!-- Add state-specific alert messages after the state statusbar -->
            <xpath expr="//header" position="after">
                <!-- Message for draft state -->
                <div class="alert alert-danger text-center" role="alert" invisible="state != 'draft'">
                    <span><i class="fa fa-exclamation-circle"/> The Quotation is in draft state, please click on 'Activate' button to activate and start Sale Flow.</span>
                </div>

                <!-- Message for activated state -->
                <div class="alert alert-danger text-center" role="alert" invisible="state != 'activated'">
                    <span><i class="fa fa-exclamation-circle"/> Make sure all products have unit price, then send Quotation to customer and once they confirmed, click on 'Customer Confirmed'.</span>
                </div>

                <!-- Message for customer_confirm state -->
                <div class="alert alert-danger text-center" role="alert" invisible="state != 'customer_confirm'">
                    <span><i class="fa fa-exclamation-circle"/> The Quotation is waiting for Sale leader to confirm.</span>
                </div>

                <!-- Message for sale_leader_confirm state -->
                <div class="alert alert-danger text-center" role="alert" invisible="state != 'sale_leader_confirm'">
                    <span><i class="fa fa-exclamation-circle"/> The Quotation is waiting for Pricing leader to confirm.</span>
                </div>

                <!-- Message for pricing_leader_confirm state -->
                <div class="alert alert-danger text-center" role="alert" invisible="state != 'pricing_leader_confirm'">
                    <span><i class="fa fa-exclamation-circle"/> Review the Quotation and click on 'Confirmed' to convert Quotation to an Order.</span>
                </div>
            </xpath>

            <!-- Replace the "Send by Email" primary button with first stage transition button -->
            <xpath expr="//button[@name='action_quotation_send'][@id='send_by_email_primary']" position="replace">
                <button name="action_activate_quotation" id="action_activate_quotation"
                        string="Activate" type="object" data-hotkey="g"
                        invisible="state != 'draft' or not id" class="btn-primary"
                        context="{'validate_analytic': True}"/>
                   <button name="action_bypass_to_sale" string="confirm to invoice"  type="object"   class="btn-primary"/>
                <button name="action_convert_to_cs_job"
        type="object"
        string="Convert to CS Job"
        class="btn-primary"/>

            </xpath>

            <!-- Add buttons for each state transition -->
            <xpath expr="//button[@name='action_quotation_send'][@id='send_by_email']" position="after">
                <button name="action_customer_confirm" id="action_customer_confirm"
                        string="Customer Confirmed" type="object" class="btn-primary"
                        data-hotkey="c" invisible="state != 'activated'"/>

<!--                <button name="action_customer_approved" id="action_customer_approved"-->
<!--                        string="Submit to Sales Leader" type="object" class="btn-primary"-->
<!--                        data-hotkey="c" invisible="state != 'customer_confirm'"/>-->

<!--                <button name="action_sale_leader_approved" id="action_sale_leader_approved"-->
<!--                        string="Submit to Pricing Leader" type="object" class="btn-primary"-->
<!--                        data-hotkey="s" invisible="state != 'sale_leader_confirm'"-->
<!--                        groups="sales_team.group_sale_manager"/>-->

                <button name="action_final_confirm" id="action_final_confirm"
                        string="Confirmed" type="object" class="btn-primary"
                        data-hotkey="p"
                        groups="sales_team.group_sale_manager,sales_team.group_sale_salesman"
                        invisible="state != 'pricing_leader_confirm' or (uid != create_uid and uid != user_id)"/>
            </xpath>


            <!-- Hide the Confirm button for sent state completely -->
            <xpath expr="//button[@name='action_confirm'][@id='action_confirm']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide the Confirm button for draft state completely -->
            <xpath expr="//button[@name='action_confirm'][not(@id)]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Update visibility of Cancel button -->
            <xpath expr="//button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">state in ['cancel', 'sale'] or not id or locked</attribute>
            </xpath>

            <!-- Hide the original "Send by Email" button -->
            <xpath expr="//button[@name='action_quotation_send'][@id='send_by_email']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide the proforma email buttons if needed (optional) -->
            <xpath expr="//button[@name='action_quotation_send'][@id='send_proforma_primary']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//button[@name='action_quotation_send'][@id='send_proforma']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="options">{'no_quick_create' : True}</attribute>
                    <attribute name="context">
                        {
                            'res_partner_search_mode': 'customer',
                            'show_address': 1,
                            'show_vat': True,
                            'default_customer_rank': 1,
                            'default_company_type': 'company',
                            'form_view_ref': 'base.view_partner_form'
                        }
                    </attribute>
            </xpath>

            <!-- Modify product_id and product_template_id in form view -->
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_quick_create': True, 'no_create_edit' : True}</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list//field[@name='product_template_id']" position="attributes">
                <attribute name="options">{'no_quick_create': True, 'no_create_edit' : True}</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list//field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_quick_create': True, 'no_create_edit' : True}</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="client_id"
                    widget="many2one"
                    placeholder="Select Client ..."
                    options="{'no_create': True, 'no_create_edit': True}"
                    context="{'show_ref': True}" />
                 <field name="booking_id"
                    widget="many2one"
                    placeholder="Select Booking ..." />
            </xpath>

            <xpath expr="//page[@name='customer_signature']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="sale_order_form_quote_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.quote.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_management.sale_order_form_quote"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='optional_products']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='sale_order_template_id']" position="after">
                <button name="select_sale_order_line"
                        type="object"
                        string="Add Sale Order Line"
                        class="btn btn-success"/>
            </xpath>
        </field>
    </record>
</odoo>