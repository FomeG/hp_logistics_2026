<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_sea_freight_request_tree" model="ir.ui.view">
        <field name="name">sea.freight.request.tree</field>
        <field name="model">freight.purchase.sea.freight.request</field>
        <field name="arch" type="xml">
            <list string="Sea Freight Requests" decoration-info="state == 'open'" decoration-success="state == 'done'" decoration-muted="state == 'cancelled'">
                <field name="from_location_id"/>
                <field name="to_location_id"/>
                <field name="number_of_response" />
                <field name="create_uid" string="Creator"/>
                <field name="assignee_id" string="Assignee"/>
                <field name="state" widget="badge" decoration-info="state == 'open'" decoration-success="state == 'done'" decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_sea_freight_request_form" model="ir.ui.view">
        <field name="name">sea.freight.request.form</field>
        <field name="model">freight.purchase.sea.freight.request</field>
        <field name="arch" type="xml">
            <form string="Sea Freight Request">
                <header>
                    <button name="action_open_response_form" type="object"
                            string="Response" class="btn-primary"
                            invisible="state != 'open' or not context.get('from_sale_menu')"
                            groups="sales_team.group_sale_salesman_all_leads"/>
                    <button name="action_generate_sea_freight"
                            string="Generate Sea Freight"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'done' or sea_freight_id"
                            groups="sales_team.group_sale_salesman"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Route Information">
                            <field name="service_type"/>
                            <field name="from_location_id" options="{'no_create': True}" domain="[('id', 'in', allow_from_location_ids)]"/>
                            <field name="to_location_id" options="{'no_create': True}" domain="[('id', 'in', allow_to_location_ids)]"/>
                            <field name="voyage_mode"/>
                        </group>
                        <group string="Shipment Details">
                            <field name="shipping_line_id" options="{'no_create': True}"/>
                            <field name="container_type_id" options="{'no_create': True}"/>
                            <field name="quantity"/>
                            <field name="weight"/>
                            <field name="etd"/>
                        </group>
                    </group>
                    <group>
                        <group string="Cargo Information">
                            <field name="commodity"/>
                            <field name="commodity_hs_code"/>
                            <field name="free_time"/>
                        </group>
                        <group string="References">
                            <field name="client" options="{'no_create': True}"/>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="sea_freight_id" readonly="1"/>
                            <field name="parent_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook invisible="not id">
                        <page string="Rates" name="rates">
                            <field name="request_line_ids" readonly="1">
                                <list editable="bottom">
                                    <field name="shipping_line_id" options="{'no_create': True}"/>
                                    <field name="selling_price"/>
                                    <field name="surcharge_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="free_time"/>
                                    <button string="View"
                                        name="view_content"
                                        type="object"
                                        class="btn-primary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                    <group string="Notes" invisible="id">
                        <field name="note" placeholder="Additional notes..."/>
                    </group>
                </sheet>
                <chatter invisible="not id"/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_sea_freight_request_search" model="ir.ui.view">
        <field name="name">sea.freight.request.search</field>
        <field name="model">freight.purchase.sea.freight.request</field>
        <field name="arch" type="xml">
            <search string="Sea Freight Requests">
                <field name="name"/>
                <field name="from_location_id"/>
                <field name="to_location_id"/>
                <field name="shipping_line_id"/>
                <field name="client"/>
                <field name="sale_order_id"/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="filter_inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Open" name="filter_open" domain="[('state', '=', 'open')]"/>
                <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="My Requests" name="my_requests" domain="[('create_uid', '=', uid)]"/>
                <filter string="Assigned to me" name="assigned_to_me" domain="[('assignee_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Service Type" name="group_by_service_type" context="{'group_by': 'service_type'}"/>
                    <filter string="POL" name="group_by_pol" context="{'group_by': 'from_location_id'}"/>
                    <filter string="POD" name="group_by_pod" context="{'group_by': 'to_location_id'}"/>
                    <filter string="ETD" name="group_by_etd" context="{'group_by': 'etd'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sea_freight_request" model="ir.actions.act_window">
        <field name="name">Sea Freight Requests</field>
        <field name="res_model">freight.purchase.sea.freight.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sea_freight_request_search"/>
        <field name="context">{'search_default_filter_active': 1, 'from_sale_menu': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new sea freight request
            </p>
            <p>
                Request pricing information from the pricing team for sea freight shipments.
            </p>
        </field>
    </record>

    <!-- Action for Pricing team (DOPR) -->
    <record id="action_sea_freight_request_pricing" model="ir.actions.act_window">
        <field name="name">Price Requests</field>
        <field name="res_model">freight.purchase.sea.freight.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sea_freight_request_search"/>
        <field name="context">{'search_default_filter_active': 1, 'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No price requests
            </p>
            <p>
                Price requests from the sales team will appear here.
            </p>
        </field>
    </record>

    <!-- Response Form View for Sea Freight Request Line (Popup) -->
    <record id="view_sea_freight_request_line_response_form" model="ir.ui.view">
        <field name="name">sea.freight.request.line.response.form</field>
        <field name="model">freight.purchase.sea.freight.request.line</field>
        <field name="arch" type="xml">
            <form string="Response to Price Request">
                <group>
                    <group string="Carrier Information">
                        <field name="request_id" invisible="1"/>
                        <field name="shipping_line_id" options="{'no_create': True}"/>
                        <field name="container_type_id" options="{'no_create': True}"/>
                        <field name="voyage_mode"/>
                    </group>
                    <group string="Pricing">
                        <field name="price" readonly="context.get('from_sale_menu')"/>
                        <field name="selling_price" invisible="not context.get('from_sale_menu')"/>
                        <field name="currency_id" options="{'no_create': True}"/>
                    </group>
                </group>
                <group>
                    <group string="Additional Info">
                        <field name="surcharge_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="free_time"/>
                    </group>
                </group>
                <group string="ETD Dates">
                    <label for="etd_to_add" string="Select date to add"/>
                    <field name="etd_to_add" widget="date" nolabel="1"/>
                    <label for="etd" string="Selected dates"/>
                    <field name="etd" widget="date_tags" nolabel="1"/>
                </group>
                <group string="Notes">
                    <field name="note" nolabel="1" placeholder="Additional notes..."/>
                </group>
                <footer>
                    <button string="Save &amp; Close" special="save" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Response Form View Readonly for Sea Freight Request Line -->
    <record id="view_sea_freight_request_line_response_form_readonly" model="ir.ui.view">
        <field name="name">sea.freight.request.line.response.form</field>
        <field name="model">freight.purchase.sea.freight.request.line</field>
        <field name="arch" type="xml">
            <form string="Response to Price Request" edit="false" create="false">
                <group>
                    <group string="Carrier Information">
                        <field name="request_id"/>
                        <field name="shipping_line_id"/>
                        <field name="container_type_id"/>
                        <field name="voyage_mode"/>
                    </group>
                    <group string="Pricing">
                        <field name="selling_price"/>
                        <field name="currency_id"/>
                    </group>
                </group>
                <group>
                    <group string="Additional Info">
                        <field name="surcharge_ids" widget="many2many_tags"/>
                        <field name="free_time"/>
                    </group>
                </group>
                <group string="ETD Dates">
                    <label for="etd_to_add" string="Select date to add"/>
                    <field name="etd_to_add" widget="date" nolabel="1"/>
                    <label for="etd" string="Selected dates"/>
                    <field name="etd" widget="date_tags" nolabel="1"/>
                </group>
                <group string="Notes">
                    <field name="note" nolabel="1" placeholder="Additional notes..."/>
                </group>
                <footer>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
