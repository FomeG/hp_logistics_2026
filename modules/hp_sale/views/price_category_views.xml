<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Price Category Form View -->
    <record id="view_product_price_category_form" model="ir.ui.view">
        <field name="name">product.price.category.form</field>
        <field name="model">product.price.category</field>
        <field name="arch" type="xml">
            <form string="Price Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Summer Promotion 2025"/>
                            <span class="badge text-bg-warning" attrs="{'invisible': [('is_superseded', '=', False)]}">Superseded</span>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="price_type" widget="radio"/>
                            <field name="is_superseded" readonly="1"/>
                        </group>
                        <group>
                            <field name="valid_from"/>
                            <field name="valid_until"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pricing">
                            <group>
                                <group>
                                    <field name="common_price" attrs="{'required': [('price_type', 'in', ['common', 'tiered'])]}"/>
                                </group>
                                <group attrs="{'invisible': [('price_type', '!=', 'tiered')]}">
                                    <field name="tiered_price" attrs="{'required': [('price_type', '=', 'tiered')]}"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert" attrs="{'invisible': [('price_type', '!=', 'tiered')]}">
                                <p>
                                    <strong>Note:</strong> For tiered pricing, the "Common Price" applies to the first item, and "Tiered Price" applies to additional items.</p>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Price Category Tree View -->
    <record id="view_product_price_category_tree" model="ir.ui.view">
        <field name="name">product.price.category.tree</field>
        <field name="model">product.price.category</field>
        <field name="arch" type="xml">
            <tree string="Price Categories" decoration-muted="is_superseded" decoration-success="not is_superseded">
                <field name="name"/>
                <field name="product_id"/>
                <field name="price_type"/>
                <field name="common_price"/>
                <field name="tiered_price" attrs="{'invisible': [('price_type', '!=', 'tiered')]}"/>
                <field name="valid_from"/>
                <field name="valid_until"/>
                <field name="is_superseded"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- Price Category Search View -->
    <record id="view_product_price_category_search" model="ir.ui.view">
        <field name="name">product.price.category.search</field>
        <field name="model">product.price.category</field>
        <field name="arch" type="xml">
            <search string="Search Price Categories">
                <field name="name"/>
                <field name="product_id"/>
                <filter string="Current (Not Superseded)" name="not_superseded" domain="[('is_superseded', '=', False)]"/>
                <filter string="Superseded" name="superseded" domain="[('is_superseded', '=', True)]"/>
                <separator/>
                <filter string="Common Price" name="common_price" domain="[('price_type', '=', 'common')]"/>
                <filter string="Tiered Pricing" name="tiered_price" domain="[('price_type', '=', 'tiered')]"/>
                <separator/>
                <filter string="Valid Today" name="valid_today" domain="[('valid_from', '&lt;=', context_today().strftime('%Y-%m-%d')), ('valid_until', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Future" name="future" domain="[('valid_from', '&gt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Expired" name="expired" domain="[('valid_until', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Product" name="group_by_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Price Type" name="group_by_price_type" context="{'group_by': 'price_type'}"/>
                    <filter string="Valid From" name="group_by_valid_from" context="{'group_by': 'valid_from'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action and Menu Items -->
    <record id="action_product_price_category" model="ir.actions.act_window">
        <field name="name">Price Categories</field>
        <field name="res_model">product.price.category</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_product_price_category_tree"/>
        <field name="search_view_id" ref="view_product_price_category_search"/>
        <field name="domain">[('product_id.type', 'in', ['common', 'custom'])]</field>
        <field name="context">{'search_default_not_superseded': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new price category
            </p>
            <p>
                Define price categories with validity periods to automatically 
                update product prices on specific dates.
            </p>
            <p>
                <strong>Note:</strong> Price categories can only be created for products 
                of type "Common" or "Custom".
            </p>
        </field>
    </record>

