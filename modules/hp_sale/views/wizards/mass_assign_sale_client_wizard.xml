<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard cho Sale -->
    <record id="view_mass_assign_sale_user_wizard_form" model="ir.ui.view">
        <field name="name">res.partner.client.mass.assign.sale.user.wizard.form</field>
        <field name="model">res.partner.client.assign.sale.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Assign Branch to Sale Clients">
                <group>
                    <field name="client_ids" widget="many2many_tags" readonly="1"/>
                    <field name="branch_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_assign_sale_branch" type="object" string="Assign Branch" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mass_assign_sale_branch_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Assign Branch (Sale)</field>
        <field name="res_model">res.partner.client.assign.sale.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>