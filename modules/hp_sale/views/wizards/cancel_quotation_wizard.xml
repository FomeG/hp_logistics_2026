<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cancel_quotation_wizard_form" model="ir.ui.view">
        <field name="name">hp_sale.cancel.quotation.wizard.form</field>
        <field name="model">hp_sale.cancel.quotation.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Quotation">
                <group>
                    <field name="order_id" readonly="1"/>
                    <field name="cancel_reason" placeholder="Please provide a reason for cancellation..." widget="text"/>
                </group>
                <footer>
                    <button name="action_confirm_cancel" type="object" string="Confirm Cancel" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cancel_quotation_wizard" model="ir.actions.act_window">
        <field name="name">Cancel Quotation</field>
        <field name="res_model">hp_sale.cancel.quotation.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_cancel_quotation_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
