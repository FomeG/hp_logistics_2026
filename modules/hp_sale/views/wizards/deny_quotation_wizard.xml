<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deny_quotation_wizard_form" model="ir.ui.view">
        <field name="name">hp_sale.deny.quotation.wizard.form</field>
        <field name="model">hp_sale.deny.quotation.wizard</field>
        <field name="arch" type="xml">
            <form string="Deny Quotation">
                <group>
                    <field name="order_id" readonly="1"/>
                    <field name="deny_reason_type" widget="radio"/>
                    <field name="deny_reason" placeholder="Please provide a reason for denial..." widget="text" invisible="deny_reason_type != 'other'"/>
                </group>
                <footer>
                    <button name="action_confirm_deny" type="object" string="Confirm Deny" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_deny_quotation_wizard" model="ir.actions.act_window">
        <field name="name">Deny Quotation</field>
        <field name="res_model">hp_sale.deny.quotation.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_deny_quotation_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
