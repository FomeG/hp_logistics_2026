<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Assign Price Request Wizard Form View -->
    <record id="view_assign_price_request_wizard_form" model="ir.ui.view">
        <field name="name">assign.price.request.wizard.form</field>
        <field name="model">assign.price.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Price Request">
                <group>
                    <field name="price_request_id" invisible="1"/>
                    <field name="allowed_user_ids" invisible="1" widget="many2many_tags"/>
                    <field name="assignee_id"
                           string="Assign To"
                           options="{'no_create': True, 'no_quick_create': True}"
                           domain="[('id', 'in', allowed_user_ids)]"
                           placeholder="Select a pricing member..."/>
                </group>
                <footer>
                    <button string="Assign"
                            name="action_confirm"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard -->
    <record id="action_assign_price_request_wizard" model="ir.actions.act_window">
        <field name="name">Assign Price Request</field>
        <field name="res_model">assign.price.request.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_assign_price_request_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
