<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Product Template Form -->
    <record id="product_template_form_view_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <!-- Hide the entire 'group_standard_price' group (for Sales price, Cost) -->
            <xpath expr="//group[@name='group_standard_price']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide the entire 'sales' page (for Sales price, Cost) -->
            <xpath expr="//page[@name='sales']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide the entire 'options' div (for Sales,Purchase) -->
            <xpath expr="//div[@name='options']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Modify the product type field -->
            <xpath expr="//field[@name='type']" position="replace">
                <field name="type" widget="radio" options="{'horizontal': true}"/>
            </xpath>

            <!-- Move the 'categ_id' field outside the hidden group -->
            <xpath expr="//field[@name='type']" position="after">
                <field name="categ_id"
                    domain="[('allowed_type_id', '=', type)]"
                    invisible="type not in ('custom', 'common')"/>
            </xpath>

            <xpath expr="//page[@name='general_information']/group" position="after">
                <!-- Service Fields for Common & Custom -->
                <group string="Service Information" invisible="type not in ['common', 'custom']">
                    <field name="complete_time" widget="float_time"/>
                </group>
            </xpath>

            <!-- Add Price Configuration for Common & Custom -->
            <xpath expr="//page[@name='general_information']/group" position="after">
                <group string="Price Configuration" name="price_configuration" invisible="type not in ['common', 'custom']">
                        <group>
                            <field name="price_type" widget="radio"/>
                        </group>
                        <group>
                            <!-- List Price: Always visible -->
                            <field name="list_price"/>
                            <!-- Tiered Price: Only visible if price_type is tiered -->
                            <field name="tiered_price" invisible="price_type != 'tiered'"/>
                        </group>
                </group>
            </xpath>

            <!-- Add reigion product -->
            <xpath expr="//div[@class='oe_title']" position="after">
                <group>
                    <field name="region_id" options="{'no_create': True, 'no_edit': True}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Inherit Product Template Form View -->
        <record id="product_template_only_form_view_inherit" model="ir.ui.view">
            <field name="name">product.template.product.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <!-- Remove fields after categ_id -->
                <xpath expr="//field[@name='categ_id']/following-sibling::field[@name='default_code']" position="replace"/>
                <xpath expr="//field[@name='categ_id']/following-sibling::field[@name='valid_product_template_attribute_line_ids']" position="replace"/>
                <xpath expr="//field[@name='categ_id']/following-sibling::field[@name='barcode']" position="replace"/>
                <xpath expr="//page[@name='variants']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

    <!-- Inherit the existing Product Template Form View - Invoice Policy -->
        <record id="product_template_form_view_inherit_hide_invoice_policy" model="ir.ui.view">
            <field name="name">product.template.form.view.inherit.hide.invoice_policy</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <!-- Hide the invoice_policy field -->
                <xpath expr="//field[@name='invoice_policy']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

    <!-- Inherit Product Template Tree View -->
    <record id="product_template_tree_view_inherit" model="ir.ui.view">
        <field name="name">product.template.tree.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="type"/>
            </field>

            <field name="list_price" position="after">
                <field name="tiered_price" optional="show"/>
                <field name="complete_time" optional="hide" widget="float_time"/>
            </field>
        </field>
    </record>

    <!-- Inherit Product Template Search View -->
    <record id="product_template_search_view_inherit" model="ir.ui.view">
        <field name="name">product.template.search.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <!-- Remove specific filters -->
            <xpath expr="//filter[@name='services']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='goods']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='combo']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='filter_to_sell']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='filter_to_purchase']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Instead of looking for a specific filter, add to the filter section -->
            <xpath expr="//search/*[last()]" position="after">
                <separator/>
                <filter string="Pricing" name="type_pricing" domain="[('type', '=', 'pricing')]"/>
                <filter string="Trucking" name="type_trucking" domain="[('type', '=', 'trucking')]"/>
                <filter string="Common" name="type_common" domain="[('type', '=', 'common')]"/>
                <filter string="Custom" name="type_custom" domain="[('type', '=', 'custom')]"/>
                <field name="region_id"/>
                <searchpanel>
                    <field name="region_id" enable_counters="1"/>
                </searchpanel>
            </xpath>

            <!-- For group by, find the existing group element -->
            <xpath expr="//group" position="inside">
                <filter string="Product Type" name="groupby_type" context="{'group_by': 'type'}"/>
            </xpath>
        </field>
    </record>
</odoo>