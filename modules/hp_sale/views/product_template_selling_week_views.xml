<odoo>
    <!-- Tree/List View -->
    <record id="view_product_template_selling_week_list" model="ir.ui.view">
        <field name="name">product.template.selling.week.tree</field>
        <field name="model">product.template.selling.week</field>
        <field name="arch" type="xml">
            <list string="Sea Freight">
                <field name="name" />
                <field name="week_info"/>
                <field name="from_location_id"/>
                <field name="to_location_id"/>
                <field name="note" />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_product_template_selling_week_form" model="ir.ui.view">
        <field name="name">product.template.selling.week.form</field>
        <field name="model">product.template.selling.week</field>
        <field name="arch" type="xml">
            <form string="Sea Freight">
                <sheet>
                    <group>
                        <field name="name" invisible="1"/>
                        <field name="selling_week_id" string="week" domain="[('year', '=', context_today().strftime('%Y'))]" required="1"/>
                        <field name="goods_info"/>
                        <field name="from_location_id" required="1"/>
                        <field name="to_region_id"/>
                        <field name="to_location_id" required="1" domain="[('region_id', '=?', to_region_id), ('type', '=', 'port')]" options="{'no_quick_create': True}"/>
                        <field name="note"/>
                        <field name="team_id" invisible="1"/>
                    </group>
   
                    <notebook>
                        <page string="Rates">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="shipping_line_id"
                                        context="{'default_partner_main_type_id': %(hp_components.partner_main_type_shipping_line)d}" />
                                    <field name="container_type_id"/>
                                    <field name="price"/>
                                    <field name="surcharge_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_product_template_selling_week_search" model="ir.ui.view">
        <field name="name">product.template.selling.week.search</field>
        <field name="model">product.template.selling.week</field>
        <field name="arch" type="xml">
            <search string="Sea Freight">
                <field name="name"/>
                <field name="goods_info"/>
                <searchpanel>
                    <field name="region_id" enable_counters="1"/>
                    <field name="team_id" enable_counters="1"/>
                    <field name="selling_week_id" string="week" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_product_template_selling_week" model="ir.actions.act_window">
        <field name="name">Sea Freight</field>
        <field name="res_model">product.template.selling.week</field>
        <field name="search_view_id" ref="view_product_template_selling_week_search" />
        <field name="view_id" ref="view_product_template_selling_week_list" />
        <field name="view_mode">list,form</field>
         <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first Product Template Selling Week
            </p>
        </field>
    </record>
</odoo>
