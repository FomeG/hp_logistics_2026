<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job: Deactivate Expired Quotations -->
        <record id="cron_deactivate_expired_quotations" model="ir.cron">
            <field name="name">Deactivate Expired Quotations</field>
            <field name="model_id" ref="model_pricing_booking"/>
            <field name="state">code</field>
            <field name="code">model._cron_deactivate_expired_quotations()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>