<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record model="ir.module.category" id="module_category_hp_pricing">
            <field name="name">Pricing Department</field>
            <field name="description">Pricing Department</field>
            <field name="sequence">5</field>
        </record>

        <!-- Pricing teams -->
        <record id="group_hp_pricing_member" model="res.groups">
            <field name="name">Pricing Member</field>
            <field name="category_id" ref="module_category_hp_pricing"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_hp_pricing_lead" model="res.groups">
            <field name="name">Pricing Lead</field>
            <field name="category_id" ref="module_category_hp_pricing"/>
            <field name="implied_ids" eval="[(4, ref('group_hp_pricing_member'))]"/>
        </record>

        <!-- Director -->
        <record id="group_hp_pricing_director" model="res.groups">
            <field name="name">Pricing Director</field>
            <field name="category_id" ref="module_category_hp_pricing"/>
            <field name="implied_ids" eval="[(4, ref('group_hp_pricing_lead'))]"/>
        </record>

        <!-- Administrator -->
       <record id="group_hp_pricing_administrator" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_hp_pricing" />
            <field name="implied_ids" eval="[(4, ref('group_hp_pricing_director'))]" />
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
        </record>

        <record id="rule_pricing_admin_lead_director_modify_users" model="ir.rule">
            <field name="name">Pricing Admin, Lead, and Director Can Modify Users</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="groups" eval="[
                (4, ref('hp_pricing.group_hp_pricing_administrator')),
                (4, ref('hp_pricing.group_hp_pricing_lead')),
                (4, ref('hp_pricing.group_hp_pricing_director'))
            ]"/>
            <field name="domain_force">[]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="sale_order_line_rule_pricing_director" model="ir.rule">
            <field name="name">Pricing Director Sales Order Line Access</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hp_pricing.group_hp_pricing_director'))]"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <field name="perm_read" eval="1"/>
        </record>

        <record id="rule_product_variant_access_all_for_pricing" model="ir.rule">
            <field name="name">All Product Variants - Pricing Access</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('hp_pricing.group_hp_pricing_member')),
                                        (4, ref('hp_pricing.group_hp_pricing_lead')),
                                        (4, ref('hp_pricing.group_hp_pricing_director')),
                                        (4, ref('hp_pricing.group_hp_pricing_administrator'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <field name="global" eval="False"/>
        </record>

    </data>
</odoo>