<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Create popup form for collecting POD/POL information -->
    <record id="view_create_pod_pol_request_wizard" model="ir.ui.view">
        <field name="name">pod.pol.request.wizard.form</field>
        <field name="model">pod.pol.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Create POD/POL Request">
                <group>
                    <field name="sale_order_id" readonly="1"/>
                    <field name="etd" required="1"/>
                    <field name="pod_name_request" required="1" placeholder="Enter Port of Discharge name"/>
                    <field name="pol_name_request" required="1" placeholder="Enter Port of Loading name"/>
                </group>
                <footer>
                    <button name="action_create_task" string="Create Task" type="object" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>