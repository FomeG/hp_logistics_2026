<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="pricing_pol_form_view" model="ir.ui.view">
        <field name="name">pricing.pol.form</field>
        <field name="model">pricing.pol</field>
        <field name="arch" type="xml">
            <form class="oe_form_configuration">
                <sheet>
                    <div class="oe_title">
                        <label for="pol_name" string="Port of Loading"/>
                        <h1><field name="pol_name" placeholder="e.g. HCM"/></h1>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="pricing_pol_list_view" model="ir.ui.view">
        <field name="name">pricing.pol.list</field>
        <field name="model">pricing.pol</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Port of Loading">
                <field name="pol_name" string="Port of Loading"/>
            </list>
        </field>
    </record>

    <record id="pricing_pol_search_view" model="ir.ui.view">
        <field name="name">pricing.pol.search</field>
        <field name="model">pricing.pol</field>
        <field name="arch" type="xml">
            <search string="Port of Loading">
                <field name="pol_name" string="Port of Loading"/>
            </search>
        </field>
    </record>

    <record id="pricing_pol_action_form" model="ir.actions.act_window">
        <field name="name">Ports of Loading</field>
        <field name="res_model">pricing.pol</field>
        <field name="search_view_id" ref="pricing_pol_search_view"/>
        <field name="view_id" ref="pricing_pol_list_view"/>
    </record>

</odoo>
