<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="pricing_sealine_form_view" model="ir.ui.view">
        <field name="name">pricing.sealine.form</field>
        <field name="model">pricing.sealine</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Sealine">
                <group>
                    <field name="pol_id" string="Port of Loading"/>
                    <field name="pod_id" string="Port of Discharge"/>
                </group>
            </form>
        </field>
    </record>

    <record id="pricing_sealine_list_view" model="ir.ui.view">
        <field name="name">pricing.sealine.list</field>
        <field name="model">pricing.sealine</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Sealine List">
                <field name="sealine_name" string="Sealine"/>
                <field name="pol_id" string="Port of Loading"/>
                <field name="pod_id" string="Port of Discharge"/>
            </list>
        </field>
    </record>

    <record id="pricing_sealine_search_view" model="ir.ui.view">
        <field name="name">pricing.sealine.search</field>
        <field name="model">pricing.sealine</field>
        <field name="arch" type="xml">
            <search string="Sealine List">
                <field name="sealine_name" string="Sealine"/>
                <field name="pol_id" string="Port of Loading"/>
                <field name="pod_id" string="Port of Discharge"/>
            </search>
        </field>
    </record>

    <record id="pricing_sealine_action_form" model="ir.actions.act_window">
        <field name="name">Sealine List</field>
        <field name="res_model">pricing.sealine</field>
        <field name="search_view_id" ref="pricing_sealine_search_view"/>
        <field name="view_id" ref="pricing_sealine_list_view"/>
    </record>

</odoo>
