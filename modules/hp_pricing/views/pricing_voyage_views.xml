<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="pricing_voyage_form_view" model="ir.ui.view">
        <field name="name">pricing.voyage.form</field>
        <field name="model">pricing.voyage</field>
        <field name="arch" type="xml">
            <form class="oe_form_configuration">
                <group>
                    <group>
                        <field name="shipping_line_id" required="1" />
                        <field name="shipping_vessel_id" required="1" />
                        <field name="voyage_no"/>
                    </group>
                    <group>
                        <field name="sealine_id" required="1" />
                        <field name="etd" required="1" />
                        <field name="pricing_member_id" required="1" options="{'no_create': True, 'no_create_edit': True}" />
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="pricing_voyage_list_view" model="ir.ui.view">
        <field name="name">pricing.voyage.list</field>
        <field name="model">pricing.voyage</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Voyage List">
                <field name="pricing_member_id"/>
                <field name="shipping_vessel_id"/>
                <field name="voyage_no"/>
                <field name="shipping_line_id"/>
                <field name="sealine_id" />
                <field name="etd"/>
            </list>
        </field>
    </record>

    <record id="pricing_voyage_search_view" model="ir.ui.view">
        <field name="name">pricing.voyage.search</field>
        <field name="model">pricing.voyage</field>
        <field name="arch" type="xml">
            <search string="Voyage List">
                <field name="pricing_member_id" string="Nhân viên Pricing"/>
                <field name="shipping_vessel_id" string="Tàu hàng"/>
                <field name="voyage_no" string="Số voyage"/>
                <field name="shipping_line_id" string="Hãng tàu"/>
                <field name="sealine_id" string="Cảng dỡ hàng" />
            </search>
        </field>
    </record>

    <record id="pricing_voyage_action_form" model="ir.actions.act_window">
        <field name="name">Voyage List</field>
        <field name="res_model">pricing.voyage</field>
        <field name="search_view_id" ref="pricing_voyage_search_view"/>
        <field name="view_id" ref="pricing_voyage_list_view"/>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
