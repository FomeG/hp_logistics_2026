<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="pricing_booking_form_view" model="ir.ui.view">
        <field name="name">pricing.booking.form</field>
        <field name="model">pricing.booking</field>
        <field name="arch" type="xml">
            <form class="oe_form_configuration">
                <header>
                    <button name="action_create_booking" type="object" string="Duplicate Booking" class="btn-secondary" invisible="not id"/>
                    <button name="action_create_booking_from_quotation" type="object" string="Create Booking from Linked Quotation" class="btn-primary" invisible="not pricing_quotation_id"/>
                </header>
                <field name="id" invisible="1"/>
                <div class="alert alert-danger text-center" role="alert" invisible="not id">
                    <span><i class="fa fa-exclamation-circle"/> Please check to ensure the booking volume is equal or more than total volume required by all linked sale order (and/or reservations).</span>
                </div>
                <sheet>
                    <group>
                        <group>
                            <field name="voyage_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="booking_no" placeholder="e.g. YMJAM491311743"/>
                            <field name="volume_quantity_1" required="1"/>
                            <field name="volume_cont_1" required="1"/>
                            <field name="volume_quantity_2"/>
                            <field name="volume_cont_2"/>
                        </group>
                        <group>
                            <field name="volume_total" readonly="1"/>
                            <field name="etd" readonly="1"/>
                            <field name="booking_price" required="True" />
                            <field name="company_booking_price" required="True" />
                            <field name="booking_status"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>

                    <!-- Pricing quotation section -->
                    <group string="Linked Pricing Quotation" invisible="not pricing_quotation_id">
                        <field name="pricing_quotation_id" readonly="1">
                            <form>
                                <group>
                                    <field name="display_name"/>
                                    <field name="cont_20_price"/>
                                    <field name="cont_40_price"/>
                                    <field name="valid_from"/>
                                    <field name="valid_to"/>
                                    <field name="always"/>
                                </group>
                            </form>
                        </field>
                    </group>

                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pricing_booking_list_view" model="ir.ui.view">
        <field name="name">pricing.booking.list</field>
        <field name="model">pricing.booking</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Booking List">
                <field name="voyage_id"/>
                <field name="booking_no"/>
                <field name="volume_total"/>
                <field name="booking_price"/>
                <field name="company_booking_price"/>
                <field name="booking_status"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="pricing_booking_search_view" model="ir.ui.view">
        <field name="name">pricing.booking.search</field>
        <field name="model">pricing.booking</field>
        <field name="arch" type="xml">
            <search string="Booking List">
                <field name="booking_no" string="Booking No"/>
                <field name="booking_status" string="Booking Status"/>
                <field name="voyage_id" string="Voyage"/>
            </search>
        </field>
    </record>

    <record id="pricing_booking_action_form" model="ir.actions.act_window">
        <field name="name">Booking List</field>
        <field name="res_model">pricing.booking</field>
        <field name="search_view_id" ref="pricing_booking_search_view"/>
        <field name="view_id" ref="pricing_booking_list_view"/>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
