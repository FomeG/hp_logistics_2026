<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Pricing Team Member Action -->
        <record id="action_pricing_team_member" model="ir.actions.act_window">
            <field name="name">Pricing Team Members</field>
            <field name="res_model">pricing.team.member</field>
            <field name="view_mode">list,form,kanban</field>
<!--            <field name="view_id" ref="pricing_team_member_view_tree"/>-->
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create a new Pricing Team Member</p>
                <p>Manage team members and their assigned regions.</p>
            </field>
        </record>


        <!-- Search View for Pricing Team Members -->
        <record id="pricing_team_member_view_search" model="ir.ui.view">
            <field name="name">pricing.team.member.view.search</field>
            <field name="model">pricing.team.member</field>
            <field name="arch" type="xml">
                <search string="Pricing Team Members">
                    <field name="user_id"/>
                    <field name="pricing_team_id"/>
                    <field name="region_id"/>
                    <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <!-- Form View for Pricing Team Members -->
        <record id="pricing_team_member_view_form" model="ir.ui.view">
            <field name="name">pricing.team.member.form</field>
            <field name="model">pricing.team.member</field>
            <field name="arch" type="xml">
                <form string="Pricing Team Member">
                    <sheet>
                        <group>
                            <field name="user_id" required="1"/>
                            <field name="pricing_team_id" required="1"/>
                            <field name="region_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View for Pricing Team Members -->
        <record id="pricing_team_member_view_tree" model="ir.ui.view">
            <field name="name">pricing.team.member.list</field>
            <field name="model">pricing.team.member</field>
            <field name="arch" type="xml">
                <list string="Pricing Team Members">
                    <field name="user_id"/>
                    <field name="pricing_team_id"/>
                    <field name="region_id"/>
                </list>
            </field>
        </record>

        <!-- Kanban View for Pricing Team Members -->
        <record id="pricing_team_member_view_kanban" model="ir.ui.view">
            <field name="name">pricing.team.member.view.kanban</field>
            <field name="model">pricing.team.member</field>
            <field name="arch" type="xml">
                <kanban default_group_by="pricing_team_id">
                    <templates>
                        <t t-name="kanban-box">
                            <div class="o_kanban_card">
                                <div class="o_kanban_image">
                                    <field name="user_id" widget="image" options="{'preview_image': 'avatar_128'}"/>
                                </div>
                                <div class="o_kanban_details">
                                    <div><strong><field name="user_id"/></strong></div>
                                    <div><em>Region:</em> <field name="region_id"/></div>
                                    <div><em>Team:</em> <field name="pricing_team_id"/></div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

    </data>
</odoo>
