<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="pricing_pod_form_view" model="ir.ui.view">
        <field name="name">pricing.pod.form</field>
        <field name="model">pricing.pod</field>
        <field name="arch" type="xml">
            <form class="oe_form_configuration">
                <sheet>
                    <div class="oe_title">
                        <label for="pod_name" string="Port of Discharge"/>
                        <h1><field name="pod_name" placeholder="e.g. YOKOHAMA"/></h1>
                    </div>
                    <group name="first" col="2">
                        <field name="region_id" class="oe_inline"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="pricing_pod_list_view" model="ir.ui.view">
        <field name="name">pricing.pod.list</field>
        <field name="model">pricing.pod</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Port of Discharge">
                <field name="pod_name" string="Port of Discharge"/>
                <field name="region_id" string="Region"/>
            </list>
        </field>
    </record>

    <record id="pricing_pod_search_view" model="ir.ui.view">
        <field name="name">pricing.pod.search</field>
        <field name="model">pricing.pod</field>
        <field name="arch" type="xml">
            <search string="Port of Discharge">
                <field name="pod_name" string="Port of Discharge"/>
                <field name="region_id"/>
            </search>
        </field>
    </record>

    <record id="pricing_pod_action_form" model="ir.actions.act_window">
        <field name="name">Ports of Discharge</field>
        <field name="res_model">pricing.pod</field>
        <field name="search_view_id" ref="pricing_pod_search_view"/>
        <field name="view_id" ref="pricing_pod_list_view"/>
    </record>

</odoo>
