<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="pricing_region_form_view" model="ir.ui.view">
        <field name="name">pricing.region.form</field>
        <field name="model">pricing.region</field>
        <field name="arch" type="xml">
            <form class="oe_form_configuration">
                <sheet>
                    <div class="oe_title">
                        <label for="region_name" string="Khu vực vận chuyển"/>
                        <h1><field name="region_name" placeholder="e.g. Đông Bắc Á"/></h1>
                    </div>
                    <notebook>
                        <page string="Members" name="members_users">
                            <field name="member_ids" widget="many2many_tags" class="w-100"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="pricing_region_list_view" model="ir.ui.view">
        <field name="name">pricing.region.list</field>
        <field name="model">pricing.region</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="DS Khu vực vận chuyển">
                <field name="region_name" string="Khu vực vận chuyển"/>
            </list>
        </field>
    </record>

    <record id="pricing_region_search_view" model="ir.ui.view">
        <field name="name">pricing.region.search</field>
        <field name="model">pricing.region</field>
        <field name="arch" type="xml">
            <search string="DS Khu vực vận chuyển">
                <field name="region_name" string="Khu vực vận chuyển"/>
            </search>
        </field>
    </record>

    <record id="pricing_region_action_form" model="ir.actions.act_window">
        <field name="name">DS Khu vực vận chuyển</field>
        <field name="res_model">pricing.region</field>
        <field name="search_view_id" ref="pricing_region_search_view"/>
        <field name="view_id" ref="pricing_region_list_view"/>
    </record>

</odoo>
