<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="pricing_shipping_vessel_form_view" model="ir.ui.view">
        <field name="name">pricing.shipping.vessel.form</field>
        <field name="model">pricing.shipping.vessel</field>
        <field name="arch" type="xml">
            <form class="oe_form_configuration">
                <sheet>
                    <div class="oe_title">
                        <label for="vessel_name" string="Shipping Vessel Name"/>
                        <h1><field name="vessel_name" placeholder="e.g. YM HEIGHTS 369S"/></h1>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="pricing_shipping_vessel_list_view" model="ir.ui.view">
        <field name="name">pricing.shipping.vessel.list</field>
        <field name="model">pricing.shipping.vessel</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="DS Tàu hàng">
                <field name="vessel_name" string="Shipping Vessel Name"/>
            </list>
        </field>
    </record>

    <record id="pricing_shipping_vessel_search_view" model="ir.ui.view">
        <field name="name">pricing.shipping.vessel.search</field>
        <field name="model">pricing.shipping.vessel</field>
        <field name="arch" type="xml">
            <search string="Shipping Vessels">
                <field name="vessel_name" string="Shipping Vessel Name"/>
            </search>
        </field>
    </record>

    <record id="pricing_shipping_vessel_action_form" model="ir.actions.act_window">
        <field name="name">Shipping Vessels</field>
        <field name="res_model">pricing.shipping.vessel</field>
        <field name="search_view_id" ref="pricing_shipping_vessel_search_view"/>
        <field name="view_id" ref="pricing_shipping_vessel_list_view"/>
    </record>

</odoo>
