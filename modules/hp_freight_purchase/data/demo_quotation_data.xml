<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Quotation: Hai Phong (VN) -> LA (US) -->
        <record id="demo_quotation_1" model="freight.purchase.quotation">
            <field name="from_location_id" ref="hp_components.location_port_vn_hpp"/>
            <field name="to_location_id" ref="hp_components.location_port_us_la"/>
            <field name="shipping_line_id" ref="hp_components.shipping_line_maersk"/>
            <field name="available_from" eval="(datetime.now()).strftime('%Y-%m-%d')"/>
            <field name="available_to" eval="(datetime.now()+timedelta(days=30)).strftime('%Y-%m-%d')"/>
            <field name="is_active">True</field>
        </record>

        <!-- Quotation Lines -->
        <record id="demo_quotation_line_1" model="freight.purchase.quotation.line">
            <field name="quotation_id" ref="demo_quotation_1"/>
            <field name="container_type_id" ref="hp_components.container_type_20dc"/>
            <field name="cost">1000.0</field>
            <field name="price">1200.0</field>
        </record>

        <record id="demo_quotation_line_2" model="freight.purchase.quotation.line">
            <field name="quotation_id" ref="demo_quotation_1"/>
            <field name="container_type_id" ref="hp_components.container_type_40dc"/>
            <field name="cost">1800.0</field>
            <field name="price">2000.0</field>
        </record>
    </data>
</odoo>
