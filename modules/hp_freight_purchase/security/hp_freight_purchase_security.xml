<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record model="ir.module.category" id="module_category_hp_freight_purchase">
            <field name="name">Freight Purchase</field>
            <field name="description">Freight Purchase Department</field>
            <field name="sequence">5</field>
        </record>

        <!-- Member -->
        <record id="group_hp_freight_purchase_member" model="res.groups">
            <field name="name">Member</field>
            <field name="category_id" ref="module_category_hp_freight_purchase" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Leader -->
        <record id="group_hp_freight_purchase_lead" model="res.groups">
            <field name="name">Leader</field>
            <field name="category_id" ref="module_category_hp_freight_purchase" />
            <field name="implied_ids" eval="[(4, ref('group_hp_freight_purchase_member'))]" />
        </record>

        <!-- Director -->
        <record id="group_hp_freight_purchase_director" model="res.groups">
            <field name="name">Director</field>
            <field name="category_id" ref="module_category_hp_freight_purchase" />
            <field name="implied_ids" eval="[(4, ref('group_hp_freight_purchase_lead'))]" />
        </record>

        <!-- Administrator -->
        <record id="group_hp_freight_purchase_administrator" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_hp_freight_purchase" />
            <field name="implied_ids" eval="[(4, ref('group_hp_freight_purchase_director'))]" />
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
        </record>

    </data>
</odoo>