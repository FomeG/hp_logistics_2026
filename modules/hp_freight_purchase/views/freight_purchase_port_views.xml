<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="freight_purchase_port_form_view" model="ir.ui.view">
        <field name="name">freight.purchase.port.form</field>
        <field name="model">freight.purchase.port</field>
        <field name="arch" type="xml">
            <form string="Port">
                <sheet>
                    <group>
                        <field name="name" required="1" />
                        <field name="region_id" required="1" />
                        <field name="is_local"/>
                        <field name="is_active" required="1" invisible="not id"/>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="freight_purchase_port_list_view" model="ir.ui.view">
        <field name="name">freight.purchase.port.list</field>
        <field name="model">freight.purchase.port</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="List Ports">
                <field name="code" />
                <field name="name" />
                <field name="region_id" />
                <field name="employees" string="Employees"/>
                <field name="is_local" />
                <field name="is_active" />
                <field name="normalized_name" groups="base.group_system"/>
                <field name="create_date" groups="base.group_system"/>
            </list>
        </field>
    </record>

    <record id="freight_purchase_port_search_view" model="ir.ui.view">
        <field name="name">freight.purchase.port.search</field>
        <field name="model">freight.purchase.port</field>
        <field name="arch" type="xml">
            <search string="List Ports">
                <field name="code" />
                <field name="name" />
                <field name="region_id" />
                <field name="is_local" />
                <field name="is_active" />

                <!-- Filters: POD -->
                <separator string="POD Status"/>
                <filter string="Local" name="filter_is_local" domain="[('is_local', '=', True)]"/>

                <!-- Filters: Active -->
                <separator string="Active Status"/>
                <filter string="Active" name="filter_active" domain="[('is_active', '=', True)]"/>
                <filter string="Inactive" name="filter_inactive" domain="[('is_active', '=', False)]"/>

                <!-- Group By -->
                <separator string="Group By"/>
                <group expand="1" string="Group By">
                    <filter string="Region" name="group_by_region" context="{'group_by': 'region_id'}"/>
                    <filter string="Active" name="group_by_is_active" context="{'group_by': 'is_active'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="freight_purchase_port_action" model="ir.actions.act_window">
        <field name="name">Freight Purchase Port</field>
        <field name="res_model">freight.purchase.port</field>
        <field name="search_view_id" ref="freight_purchase_port_search_view" />
        <field name="view_id" ref="freight_purchase_port_list_view" />
        <field name="view_mode">list,form</field>
    </record>

</odoo>