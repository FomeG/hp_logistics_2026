<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Create popup form for collecting Port/Route information -->
    <record id="view_create_port_route_request_wizard" model="ir.ui.view">
        <field name="name">port.route.request.wizard.form</field>
        <field name="model">port.route.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Port/Route Request">
                <group>
                    <field name="sale_order_id" readonly="1"/>
                    <field name="etd" required="1"/>
                    <field name="pod_name_request" required="1" placeholder="Enter Port of Discharge name"/>
                    <field name="pol_name_request" required="1" placeholder="Enter Port of Loading name"/>
                    <field name="container_type_id" required="1" placeholder="Container Type (For this quotation)"/>
                    <field name="notes" placeholder="Additional notes or special requirements"/>
                </group>
                <footer>
                    <button name="action_task_create_new_route" string="Request New Route" type="object" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo> 