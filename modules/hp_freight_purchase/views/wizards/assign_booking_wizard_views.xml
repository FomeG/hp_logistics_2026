<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_assign_booking_wizard" model="ir.ui.view">
        <field name="name">assign.booking.wizard.form</field>
        <field name="model">assign.booking.wizard</field>
        <field name="arch" type="xml">
            <form string="Provide Booking">
                <group>
                    <field name="sale_order_id" readonly="1"/>
                    <field name="booking_id"
                        options="{'no_create': True, 'no_create_edit': True}"
                        domain="[('id', 'in', allow_booking_ids)]"
                    />
                    <field name="inventory_summary" invisible="not booking_id"/>
                    <field name="container_type_id"
                        options="{'no_create': True, 'no_create_edit': True}"
                        domain="[('id', 'in', allow_container_type_ids)]"    
                    />
                    <field name="quantity"/>
                    <field name="deadline"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>