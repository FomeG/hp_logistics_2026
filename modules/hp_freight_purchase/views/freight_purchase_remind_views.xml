<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="freight_purchase_remind_form_view" model="ir.ui.view">
        <field name="name">freight.purchase.remind.form</field>
        <field name="model">freight.purchase.remind</field>
        <field name="arch" type="xml">
            <form string="Remind">
                <sheet>
                    <group>
                        <field name="type" required="1" />
                        <field name="total" required="1" />
                        <field name="interval" />
                        <field name="is_active" required="1" invisible="not id" />
                    </group>
                    <notebook>
                        <page string="Without Booking Lines" invisible="not id">
                            <field name="without_booking_line_ids">
                                <list delete="false" create="false">
                                    <!-- NOTE: Changed from pod_id to to_location_id (quotation removal #561) -->
                                    <field name="to_location_id" />
                                    <!-- comment #561
                                    <field name="quotation_line_id" groups="base.group_system" />
                                    -->
                                    <field name="container_type_id" />
                                    <field name="quantity" />
                                    <field name="price" />
                                    <field name="teu_volume" />
                                    <field name="status" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="freight_purchase_remind_list_view" model="ir.ui.view">
        <field name="name">freight.purchase.remind.list</field>
        <field name="model">freight.purchase.remind</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="List Reminds">
                <field name="type" />
                <field name="total" />
                <field name="interval" />
                <field name="is_active" />
            </list>
        </field>
    </record>

    <record id="freight_purchase_remind_action" model="ir.actions.act_window">
        <field name="name">Freight Purchase Remind</field>
        <field name="res_model">freight.purchase.remind</field>
        <field name="view_id" ref="freight_purchase_remind_list_view" />
        <field name="view_mode">list,form</field>
    </record>

</odoo>