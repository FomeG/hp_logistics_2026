<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Sale Order view to add Create Route button -->
    <record id="sale_order_form_freight_purchase_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.freight.purchase.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            
            <!-- Add the Create Route button before the existing create control -->
            <xpath expr="//field[@name='order_line']/list/control/create[@name='add_product_control']" position="before">
                <button name="action_create_route"
                        string="Create Route"
                        type="object"
                        context="{'default_sale_order_id': parent.id}"
                        class="o_list_button_add btn-link"/>
            </xpath>

            <!-- Show these fields only if product_type_filter is 'pricing' -->
            <xpath expr="//field[@name='order_line']/list//field[@name='product_template_id']" position="after">
                 <field name="etd_sale" readonly="product_type_filter in ['trucking', 'common', 'custom']"/>
                <field name="container_type_id" readonly="product_type_filter in ['trucking', 'common', 'custom']"
                       required="product_type_filter == 'pricing'"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="after">
                <field name="etd_sale" readonly="product_type_filter in ['trucking', 'common', 'custom']"/>
                <field name="container_type_id" readonly="product_type_filter in ['trucking', 'common', 'custom']"
                       required="product_type_filter == 'pricing'"/>
            </xpath>

            <!-- Add the filter as a column in the list view -->
            <xpath expr="//field[@name='order_line']/list/field[@name='sequence']" position="after">
                 <field name="product_type_filter" widget="selection" class="ui-widget"/>
            </xpath>

            <xpath expr="//field[@name='product_type_filter']" position="attributes">
                <attribute name="style">padding-left: 10px !important;</attribute>
            </xpath>

            <!-- Modify domain on product_template_id in list view -->
            <xpath expr="//field[@name='order_line']/list//field[@name='product_template_id']" position="attributes">
                <attribute name="domain">[('sale_ok', '=', True), ('type', '=', product_type_filter)]</attribute>
            </xpath>

            <!-- Modify domain on product_id in list view -->
            <xpath expr="//field[@name='order_line']/list//field[@name='product_id']" position="attributes">
                <attribute name="domain">[('sale_ok', '=', True), ('product_tmpl_id.type', '=', product_type_filter)]</attribute>
            </xpath>

            <!-- Add filter to the form view in a better position -->
            <xpath expr="//field[@name='order_line']/form//field[@name='product_updatable']" position="after">
                <field name="product_type_filter" widget="selection" class="ui-widget"/>
            </xpath>

            <!-- Modify domain on product_id in form view -->
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="attributes">
                <attribute name="domain">[('sale_ok', '=', True), ('product_tmpl_id.type', '=', product_type_filter)]</attribute>
            </xpath>

            <!-- Show these fields only if product_type_filter is 'pricing' -->
            <xpath expr="//field[@name='order_line']/list//field[@name='product_uom_qty']" position="after">
                <field name="freight_booking_id" readonly="product_type_filter in ['trucking', 'common', 'custom']"/>
                <field name="freight_quotation_id" readonly="product_type_filter in ['trucking', 'common', 'custom']"/>
            </xpath>

            <!-- Add freight purchase fields to form view of order lines -->
            <xpath expr="//field[@name='order_line']/form//field[@name='product_uom_qty']" position="after">
                <field name="freight_booking_id" readonly="product_type_filter in ['trucking', 'common', 'custom']"/>
                <field name="freight_quotation_id" readonly="product_type_filter in ['trucking', 'common', 'custom']"/>
            </xpath>

            <!-- Find the partner_id field and add the domain attribute -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('user_id', '=', uid)]</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list//field[@name='tax_id']" position="after">
                 <field name="commission" width="120px"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/list//field[@name='price_unit']" position="before">
                 <field name="base_price" width="120px"/>
            </xpath>

        </field>
    </record>

</odoo> 