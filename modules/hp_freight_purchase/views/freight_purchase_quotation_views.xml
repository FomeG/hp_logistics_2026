<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="freight_purchase_quotation_form_view" model="ir.ui.view">
        <field name="name">freight.purchase.quotation.form</field>
        <field name="model">freight.purchase.quotation</field>
        <field name="arch" type="xml">
            <form class="oe_form_configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="not id"/>
                            <field name="route_id" widget="many2one_new_tab" />
                            <field name="shipping_line_id"
                                domain="[('is_shipping_line', '=', True)]"
                                options="{'no_create_edit': True, 'no_quick_create': True}"
                                widget="many2one_new_tab" />
                            <field name="note" />
                            <field name="is_active" invisible="not id" />
                        </group>
                        <group>
                            <field name="available_from" />
                            <field name="available_to" />
                            <field name="fees">
                                <list>
                                    <field name="name" />
                                    <field name="amount" />
                                </list>
                            </field>
                        </group>
                    </group>

                    <group string="Quotation Lines">
                        <field name="line_ids" string="">
                            <form>
                                <group>
                                    <field name="container_type_id" />
                                    <field name="cost"/>
                                    <field name="price" />
                                </group>
                            </form>
                            <list>
                                <field name="container_type_id" />
                                <field name="cost" />
                                <field name="price" string="Internal price" />
                                <field name="create_date" />
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="freight_purchase_quotation_list_view" model="ir.ui.view">
        <field name="name">freight.purchase.quotation.list</field>
        <field name="model">freight.purchase.quotation</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Quotation List">
                <field name="name" groups="base.group_system"/>
                <field name="shipping_line_id" />
                <field name="route_id" />
                <field name="str_available" />
                <field name="total_quotation_lines" string="Lines" />
                <field name="is_active" groups="base.group_system"/>
                <field name="create_date" />
            </list>
        </field>
    </record>

    <record id="freight_purchase_quotation_search_view" model="ir.ui.view">
        <field name="name">freight.purchase.quotation.search</field>
        <field name="model">freight.purchase.quotation</field>
        <field name="arch" type="xml">
            <search string="Quotation List">
                <field name="name" />
                <field name="available_from" />
                <field name="available_to" />
                <field name="is_active" />
                <field name="shipping_line_id"/>
                <field name="route_id"/>

                <!-- Filters: Active -->
                <separator string="Active Status"/>
                <filter string="Active" name="filter_active" domain="[('is_active', '=', True)]"/>
                <filter string="Inactive" name="filter_inactive" domain="[('is_active', '=', False)]"/>

                <!-- Filters: Availability Dates -->
                <separator string="Availability"/>
                <filter string="Available Today" name="filter_today"
                        domain="[('available_from', '&lt;=', (context_today())), ('available_to', '&gt;=', (context_today()))]"/>
                <filter string="Expired" name="filter_expired"
                        domain="[('available_to', '&lt;', (context_today()))]"/>
                <filter string="Upcoming" name="filter_upcoming"
                        domain="[('available_from', '&gt;', (context_today()))]"/>

                <!-- Group By -->
                <separator string="Group By"/>
                <group expand="1" string="Group By">
                    <filter string="Route" name="group_by_route" context="{'group_by': 'route_id'}"/>
                    <filter string="Shipping Line" name="group_by_shipping" context="{'group_by': 'shipping_line_id'}"/>
                    <filter string="Available To" name="group_by_available_from" context="{'group_by': 'available_to'}"/>
                    <filter string="Active Status" name="group_by_is_active" context="{'group_by': 'is_active'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="freight_purchase_quotation_action" model="ir.actions.act_window">
        <field name="name">Quotation List</field>
        <field name="res_model">freight.purchase.quotation</field>
        <field name="search_view_id" ref="freight_purchase_quotation_search_view" />
        <field name="view_id" ref="freight_purchase_quotation_list_view" />
        <field name="view_mode">list,form</field>
    </record>

</odoo>