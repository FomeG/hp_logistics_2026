<odoo>
    <!-- List view for all booking documents -->
    <record id="view_freight_purchase_document_list" model="ir.ui.view">
        <field name="name">freight.purchase.document.list</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="document_type"/>
                <field name="booking_id"/>
                <field name="create_uid"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Action to open booking documents -->
    <record id="action_freight_purchase_documents" model="ir.actions.act_window">
        <field name="name">All Documents</field>
        <field name="res_model">ir.attachment</field>
        <field name="view_mode">list</field>
        <field name="domain">[('booking_id', '!=', False)]</field>
        <field name="view_id" ref="view_freight_purchase_document_list"/>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No documents yet. Upload booking files, invoices, BL drafts, etc.
            </p>
        </field>
    </record>


</odoo>