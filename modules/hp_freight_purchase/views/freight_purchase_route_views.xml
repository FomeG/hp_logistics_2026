<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="freight_purchase_route_form_view" model="ir.ui.view">
        <field name="name">freight.purchase.route.form</field>
        <field name="model">freight.purchase.route</field>
        <field name="arch" type="xml">
            <form string="Route">
                <sheet>
                    <group>
                        <field name="name" required="1" />
                        <field name="pol_id" required="1"
                            widget="many2one_new_tab" />
                        <field name="pod_id" required="1" invisible="not pol_id"
                            widget="many2one_new_tab" />
                        <field name="region_id" required="1" widget="many2one_new_tab" />
                        <field name="shipment_type" required="1" />
                        <field name="is_active" required="1" invisible="not id" />
                        <field name="quotation_ids" readonly="1" invisible="not id">
                            <list>
                                <field name="name" string="Name" />
                                <field name="shipping_line_id" />
                                <field name="available_from" />
                                <field name="available_to" />
                                <field name="is_active" />
                                <field name="create_date" />
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="freight_purchase_route_list_view" model="ir.ui.view">
        <field name="name">freight.purchase.route.list</field>
        <field name="model">freight.purchase.route</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="List Routes">
                <field name="name" />
                <field name="is_active" />
                <field name="pol_id" />
                <field name="pod_id" />
                <field name="shipment_type" />
                <field name="total_quotations" />
                <field name="create_date" />
            </list>
        </field>
    </record>

    <record id="freight_purchase_route_search_view" model="ir.ui.view">
        <field name="name">freight.purchase.route.search</field>
        <field name="model">freight.purchase.route</field>
        <field name="arch" type="xml">
            <search string="List Routes">
                <field name="name" />
                <field name="is_active" />
                <field name="pol_id" />
                <field name="pod_id" />
                <field name="shipment_type" />
                <field name="create_date" />

                <!-- Active Filters -->
                <separator string="Status"/>
                <filter string="Active" name="filter_active" domain="[('is_active', '=', True)]"/>
                <filter string="Inactive" name="filter_inactive" domain="[('is_active', '=', False)]"/>

                <!-- Quotation Filters -->
                <separator string="Quotations"/>
                <filter string="With Quotations" name="filter_has_quotations" domain="[('quotation_ids', '!=', False)]"/>
                <filter string="Without Quotations" name="filter_no_quotations" domain="[('quotation_ids', '=', False)]"/>

                <!-- Group By -->
                <separator string="Group By"/>
                <group expand="1" string="Group By">
                    <filter string="POL" name="group_by_pol" context="{'group_by': 'pol_id'}"/>
                    <filter string="POD" name="group_by_pod" context="{'group_by': 'pod_id'}"/>
                    <filter string="Region" name="group_by_region" context="{'group_by': 'region_id'}"/>
                    <filter string="Status" name="group_by_active" context="{'group_by': 'is_active'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="freight_purchase_route_action" model="ir.actions.act_window">
        <field name="name">Freight Purchase Route</field>
        <field name="res_model">freight.purchase.route</field>
        <field name="search_view_id" ref="freight_purchase_route_search_view" />
        <field name="view_id" ref="freight_purchase_route_list_view" />
        <field name="view_mode">list,form</field>
    </record>

</odoo>