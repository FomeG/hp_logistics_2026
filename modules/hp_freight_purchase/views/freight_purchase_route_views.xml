<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="freight_purchase_route_form_view" model="ir.ui.view">
        <field name="name">freight.purchase.route.form</field>
        <field name="model">route.base</field>
        <field name="arch" type="xml">
            <form string="Route">
                <sheet>
                    <group>
                        <field name="from_location_id"
                               string="POL"
                               required="1"
                               domain="[('type', '=', 'port')]"
                               />
                        <field name="to_location_id"
                               string="POD"
                               required="1"
                               domain="[('type', '=', 'port')]"
                            />
                        <field name="pol_id" invisible="1"/>
                        <field name="pod_id" invisible="1"/>
                        <!-- <field name="transport_mode" invisible="1" readonly="1"/> -->
                    </group>
                    <notebook>
                        <page string="Quotations" invisible=" not id">
                            <field name="quotation_ids" readonly="1">
                                <list>
                                    <field name="name" string="Name" />
                                    <field name="shipping_line_id" />
                                    <field name="available_from" string="from"/>
                                    <field name="available_to" string="to"/>
                                    <field name="create_date" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="freight_purchase_route_list_view" model="ir.ui.view">
        <field name="name">freight.purchase.route.list</field>
        <field name="model">route.base</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="List Routes">
                <field name="name" />
                <field name="pol_id" />
                <field name="pod_id" />
                <field name="direction" />
                <field name="total_quotations" />
                <!-- <field name="product_id" groups="base.group_system" widget="many2one_new_tab"/> -->
            </list> 
        </field>
    </record>

    <record id="freight_purchase_route_search_view" model="ir.ui.view">
        <field name="name">freight.purchase.route.search</field>
        <field name="model">route.base</field>
        <field name="arch" type="xml">
            <search string="List Routes">
                <field name="name" />
                <field name="pol_id" />
                <field name="pod_id" />
                <field name="direction" />
                <!-- Quotation Filters -->
                <separator string="Quotations"/>
                <filter string="With Quotations" name="filter_has_quotations" domain="[('quotation_ids', '!=', False)]"/>
                <filter string="Without Quotations" name="filter_no_quotations" domain="[('quotation_ids', '=', False)]"/>
                <!-- Group By -->
                <separator string="Group By"/>
                <group expand="1" string="Group By">
                    <filter string="POL" name="group_by_pol" context="{'group_by': 'pol_id'}"/>
                    <filter string="POD" name="group_by_pod" context="{'group_by': 'pod_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="freight_purchase_route_action" model="ir.actions.act_window">
        <field name="name">Freight Purchase Route</field>
        <field name="res_model">route.base</field>
        <field name="search_view_id" ref="freight_purchase_route_search_view" />
        <field name="domain">[('transport_mode', '=', 'sea')]</field>
        <field name="context"
            eval="{
                'form_view_ref': 'hp_freight_purchase.freight_purchase_route_form_view',
                'list_view_ref': 'hp_freight_purchase.freight_purchase_route_list_view'
            }" />
        <field name="view_mode">list,form</field>
    </record>

</odoo>