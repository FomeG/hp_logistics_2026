<odoo>
    <data noupdate="0">
        <menuitem id="menu_freight_purchase_root"
            name="Freight Purchase"
            groups="hp_freight_purchase.group_hp_freight_purchase_member"
            action="freight_purchase_assign_booking_action"
            sequence="40" />

        <!-- Purchase menus -->
        <menuitem id="menu_base_team"
            name="Bases"
            parent="menu_freight_purchase_root"
            sequence="10" />

        <menuitem id="menu_freight_purchase_shipping_line"
            name="Shipping Lines"
            action="freight_purchase_shipping_line_action"
            parent="menu_base_team"
            sequence="10" />

        <menuitem id="menu_freight_purchase_vessel"
            name="Vessels"
            action="freight_purchase_vessel_action"
            parent="menu_base_team"
            sequence="20" />

        <menuitem id="menu_freight_purchase_region"
            name="Regions"
            action="freight_purchase_region_action"
            parent="menu_base_team"
            sequence="30" />

        <menuitem id="menu_freight_purchase_documents"
              name="Documents"
              parent="menu_freight_purchase_root"
              groups="group_hp_freight_purchase_member"
              sequence="35"
              action="action_freight_purchase_documents"/>

        <menuitem id="menu_freight_purchase_port"
            name="Ports"
            action="freight_purchase_port_action"
            parent="menu_base_team"
            sequence="40" />

        <menuitem id="menu_freight_purchase_container_type"
            name="Container Types"
            action="freight_purchase_container_type_action"
            parent="menu_base_team"
            sequence="60" />

        <menuitem id="menu_freight_purchase_import_tools"
                  name="Import Tools"
                  parent="menu_freight_purchase_root"
                  sequence="65"
                  groups="base.group_system"/>

        <menuitem id="menu_import_shipping_line"
                  name="Import Shipping Line"
                  parent="menu_freight_purchase_import_tools"
                  action="action_import_shipping_line_wizard"
                  sequence="10"/>



        <!-- Purchase menus -->
        <menuitem id="menu_purchase_team"
            name="Purchase"
            parent="menu_freight_purchase_root"
            sequence="20" />

        <!-- NOTE: Commented out quotation menus (quotation removal #561)
        <menuitem id="menu_freight_purchase_quotation"
            name="Quotations"
            action="freight_purchase_quotation_action"
            parent="menu_purchase_team"
            sequence="10" />

        <menuitem id="menu_freight_purchase_quotation_line"
            name="Quotation Lines"
            action="freight_purchase_quotation_line_action"
            parent="menu_purchase_team"
            sequence="20" />
        -->

        <menuitem id="menu_freight_purchase_booking"
            name="Bookings"
            action="freight_purchase_booking_action"
            parent="menu_purchase_team"
            sequence="30" />

        <menuitem id="freight_purchase_booking_line"
            name="Booking Lines"
            action="freight_purchase_booking_line_action"
            parent="menu_purchase_team"
            sequence="40" />
        
        <!-- Assign booking -->
        <menuitem id="menu_purchase_assign_booking"
              name="Assign Booking"
              parent="menu_freight_purchase_root"
              sequence="25"
              action="freight_purchase_assign_booking_action"/>

        <!-- Price Requests Form View (Inherited) - Add Response button for pricing team -->
        <record id="view_sea_freight_request_form_pricing" model="ir.ui.view">
            <field name="name">sea.freight.request.form.pricing</field>
            <field name="model">freight.purchase.sea.freight.request</field>
            <field name="inherit_id" ref="hp_sale.view_sea_freight_request_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header/field[@name='state']" position="before">
                    <button name="action_open_response_form" type="object"
                            string="Response" class="btn-primary"
                            invisible="state != 'open' or not context.get('from_freight_purchase')"/>
                </xpath>
            </field>
        </record>

        <!-- Price Requests Action -->
        <record id="action_price_request_freight_purchase" model="ir.actions.act_window">
            <field name="name">Price Requests</field>
            <field name="res_model">freight.purchase.sea.freight.request</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="hp_sale.view_sea_freight_request_search"/>
            <field name="context">{'from_freight_purchase': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No price requests assigned to you
                </p>
                <p>
                    Price requests from the sales team will appear here when assigned to you.
                </p>
            </field>
        </record>

        <!-- Price Requests Menu -->
        <menuitem id="menu_price_request"
              name="Price Requests"
              parent="menu_freight_purchase_root"
              sequence="26"
              action="action_price_request_freight_purchase"/>

        <!-- fee -->
        <menuitem id="menu_freight_purchase_fee_menu"
            name="Fee Management"
            parent="menu_freight_purchase_root"
            sequence="30" />
        <menuitem id="menu_freight_purchase_fee_type"
            name="Fee Type"
            action="freight_purchase_fee_type_action"
            parent="menu_freight_purchase_fee_menu"
            sequence="10" />
        <menuitem id="menu_freight_purchase_fee"
            name="Fee"
            action="freight_purchase_fee_action"
            parent="menu_freight_purchase_fee_menu"
            sequence="20" />
        <menuitem id="menu_freight_purchase_fee_line"
            name="Fee Line"
            action="freight_purchase_fee_line_action"
            parent="menu_freight_purchase_fee_menu"
            sequence="30" />
        <menuitem id="menu_freight_purchase_setting"
            name="Setting"
            parent="menu_freight_purchase_root"
            sequence="40" />
        <menuitem
            id="menu_freight_purchase_manage_team"
            name="Pricing Teams"
            parent="menu_freight_purchase_setting"
            action="hr_team_action_pricing"
            sequence="5"
        />
        <menuitem id="menu_freight_purchase_remind"
            name="Remind"
            action="freight_purchase_remind_action"
            parent="menu_freight_purchase_setting"
            sequence="10" />
    </data>
</odoo>