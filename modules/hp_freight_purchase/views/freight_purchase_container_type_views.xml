<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="freight_purchase_container_type_form_view" model="ir.ui.view">
        <field name="name">freight.purchase.container.type.form</field>
        <field name="model">container.type</field>
        <field name="arch" type="xml">
            <form string="Container Types">
                <sheet>
                    <group>
                        <field name="name" required="1" />
                        <field name="teu" required="1"/>
                        <field name="is_active" required="1" />
                        <field name="quotation_line_ids" readonly="1" invisible="not id">
                            <list>
                                <field name="quotation_id" string="Quotation name" />
                                <field name="cost" string="Booking price" />
                                <field name="price" string="Internal price" />
                                <field name="create_date" string="Created" />
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="freight_purchase_container_type_list_view" model="ir.ui.view">
        <field name="name">freight.purchase.container.type.list</field>
        <field name="model">container.type</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="List Container Types">
                <field name="code" />
                <field name="name" />
                <field name="teu" />
                <field name="is_active" />
                <field name="total_quotation_lines" />
                <field name="create_date" />
            </list>
        </field>
    </record>

    <record id="freight_purchase_container_type_search_view" model="ir.ui.view">
        <field name="name">freight.purchase.container.type.search</field>
        <field name="model">container.type</field>
        <field name="arch" type="xml">
            <search string="List Container Types">
                <field name="code" />
                <field name="name" />
                <field name="teu" />
                <field name="is_active" />

                <!-- Filter Sections -->
                <separator string="Status"/>
                <filter string="Active" name="filter_active" domain="[('is_active', '=', True)]"/>
                <filter string="Inactive" name="filter_inactive" domain="[('is_active', '=', False)]"/>

                <separator string="TEU Range"/>
                <filter string="TEU > 5" name="filter_teu_high" domain="[('teu', '&gt;', 5)]"/>
                <filter string="TEU ≤ 5" name="filter_teu_low" domain="[('teu', '&lt;=', 5)]"/>

                <!-- Group By Section -->
                <separator string="Group By"/>
                <group expand="1" string="Group By">
                    <filter string="Active" name="group_by_active" context="{'group_by': 'is_active'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="freight_purchase_container_type_action" model="ir.actions.act_window">
        <field name="name">Container Types</field>
        <field name="res_model">container.type</field>
        <field name="search_view_id" ref="freight_purchase_container_type_search_view" />
        <field name="view_id" ref="freight_purchase_container_type_list_view" />
        <field name="view_mode">list,form</field>
    </record>

</odoo>