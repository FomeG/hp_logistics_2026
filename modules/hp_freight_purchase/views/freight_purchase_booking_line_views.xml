<odoo>

    <record id="freight_purchase_booking_line_form_view" model="ir.ui.view">
        <field name="name">freight.purchase.booking.line.form</field>
        <field name="model">freight.purchase.booking.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group colspan="2">
                            <field name="booking_id" invisible="context.get('from_booking_form')" placeholder="Select booking to filter quotation lines"/>
                            <field name="quotation_id" readonly="1" string="Linked Quotation"
                                groups="base.group_system" widget="many2one_new_tab" />
                            <field name="quotation_line_id"
                                invisible="(context.get('from_booking_form') and not parent.quotation_id.line_ids) or not has_quotation_lines"
                                domain="[('quotation_id','=',quotation_id)]"
                                options="{'no_create': True, 'no_edit': True}"
                                widget="many2one_new_tab"
                            />
                        </group>
                        <group colspan="2" invisible="has_quotation_lines">
                            <field name="quotation_line_container_type_id"
                                required="not has_quotation_lines" widget="many2one_new_tab" />
                            <field name="quotation_line_cost" required="not has_quotation_lines"/>
                            <field name="quotation_line_price" required="not has_quotation_lines"/>
                        </group>
                        <group colspan="2">
                            <field name="container_type_id" invisible="not quotation_line_id"
                                widget="many2one_new_tab" />
                            <field name="unit_price" required="1"/>
                            <field name="quantity" />
                            <field name="teu_volume" />
                        </group>
                        <group colspan="2">
                            <field name="price" string="Price" readonly="1"/>
                            <field name="employee_id" string="Reserved By"
                                domain="[('department_id.department_type', '=', 'sale')]"
                                options="{'no_create': True, 'no_edit': True}"
                                widget="many2one_new_tab"
                            />
                            <field name="reservation_expiration_date" />
                            <field name="note" />

                            <field name="status" />
                        </group>
                    </group>
                    <group string="Sale Order Information">
                        <field name="sale_order_id" widget="many2one_new_tab" />
                        <field name="customer_id" widget="many2one_new_tab" />
                        <field name="salesman_id" widget="many2one_new_tab" />
                        <field name="sale_order_line_ids" string="Order Lines" readonly="status == 'cancelled'">
                            <list editable="top" create="false" delete="true">
                                <field name="order_id" />
                                <field name="product_id" />
                                <field name="product_uom_qty" />
                                <field name="price_unit" />
                                <field name="price_subtotal" />
                            </list>
                        </field>
                        <div invisible="not can_add_sale_line">
                            <button name="action_add_sale_line"
                                string="Add Sale Lines"
                                type="object"
                                class="btn-light ml-2"
                             />
                        </div>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="freight_purchase_booking_line_list_view" model="ir.ui.view">
        <field name="name">freight.purchase.booking.line.list</field>
        <field name="model">freight.purchase.booking.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="booking_id" />
                <field name="container_type_id" />
                <field name="quotation_line_id" />
                <field name="quantity" />
                <field name="price" />
                <field name="status" />
                <field name="teu_volume" />
                <field name="reservation_expiration_date" />
            </list>
        </field>
    </record>

    <record id="freight_purchase_booking_line_search_view" model="ir.ui.view">
        <field name="name">freight.purchase.booking.line.search</field>
        <field name="model">freight.purchase.booking.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="booking_id" />
                <field name="quotation_line_id" />
                <field name="status" />
                <field name="reserved_by_id" />

                <filter string="Available" name="filter_status_available" domain="[('status', '=', 'available')]"/>
                <filter string="Reserved" name="filter_status_reserved" domain="[('status', '=', 'reserved')]"/>
                <filter string="Allocated" name="filter_status_allocated" domain="[('status', '=', 'allocated')]"/>
                <filter string="Shipped" name="filter_status_shipped" domain="[('status', '=', 'shipped')]"/>
                <filter string="Cancelled" name="filter_status_cancelle" domain="[('status', '=', 'cancelled')]"/>

                <!-- Group By Filters -->
                <group expand="1" string="Group By">
                    <filter string="Booking" name="group_by_booking" context="{'group_by': 'booking_id'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Reserved By" name="group_by_reserved" context="{'group_by': 'reserved_by_id'}"/>
                </group>

            </search>
        </field>
    </record>

    <record id="freight_purchase_booking_line_action" model="ir.actions.act_window">
        <field name="name">Booking Lines</field>
        <field name="res_model">freight.purchase.booking.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="freight_purchase_booking_line_search_view" />
        <field name="view_id" ref="freight_purchase_booking_line_list_view" />
        <field name="context">{'from_booking_form': False}</field>
    </record>

</odoo>