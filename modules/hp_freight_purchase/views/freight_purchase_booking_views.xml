<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="freight_purchase_booking_form_view" model="ir.ui.view">
        <field name="name">freight.purchase.booking.form</field>
        <field name="model">freight.purchase.booking</field>
        <field name="arch" type="xml">
            <form class="oe_form_configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="booking_mode" required="1" readonly="id > 0"/>
                            <field name="quotation_id"
                                invisible="not id and booking_mode == 'without_quotation'"
                                readonly="id > 0" widget="many2one_new_tab" />
                            <field name="code" required="1" string="Code" help="Book Code"/>
                            <field name="name" readonly="1"/>
                            <field name="vessel_id" required="1" widget="many2one_new_tab" />
                            <field name="etd" />
                            <field name="status" />
                        </group>
                        <group invisible="not id and booking_mode == 'without_quotation'" >
                            <field name="route_id" widget="many2one_new_tab" />
                            <field name="shipping_line_id" widget="many2one_new_tab"  />
                        </group>

                        <group invisible="id > 0 or booking_mode == 'with_quotation'">
                            <field name="quotation_route_id"
                                required="not id and booking_mode == 'without_quotation'"
                                widget="many2one_new_tab" />
                            <field name="quotation_shipping_line_id"
                                required="not id and booking_mode == 'without_quotation'"
                                domain="[('is_shipping_line', '=', True)]" widget="many2one_new_tab" />
                        </group>
                        <group>
                            <field name="teu_volume" />
                            <field name="note" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Booking Lines" invisible="not id">
                            <field name="line_ids" context="{'from_booking_form': True}">
                                <list>
                                    <field name="pod_id" />
                                    <field name="quotation_line_id" groups="base.group_system"/>
                                    <field name="container_type_id" />
                                    <field name="quantity" />
                                    <field name="price" />
                                    <field name="teu_volume" />
                                    <field name="reserved_by_id" />
                                    <field name="status" />
                                </list>
                            </field>
                        </page>
                        <page string="Inventory" invisible="not is_show_inventory">
                            <field name="booking_inventory_ids" context="{'from_booking_form': True}">
                                <list edit="0" delete="0" create="1" readonly="1" no_open="1">
                                    <field name="container_type_id" />
                                    <field name="action" />
                                    <field name="quantity" />
                                    <field name="booking_line_id" />
                                    <field name="create_date" />
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="booking_id"
                                                invisible="context.get('from_booking_form')" />
                                            <field name="container_type_id" required="1" domain="[('id', 'in', allow_container_type_ids)]" />
                                            <field name="quantity" required="1" />
                                            <field name="action" readonly="1"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="freight_purchase_booking_list_view" model="ir.ui.view">
        <field name="name">freight.purchase.booking.list</field>
        <field name="model">freight.purchase.booking</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Booking List">
                <field name="name" groups="base.group_system"/>
                <field name="quotation_id" groups="base.group_system"/>
                <field name="code" string="Code" />
                <field name="shipping_line_id" />
                <field name="route_id" />
                <field name="vessel_id" />
                <field name="etd" />
                <field name="teu_volume" />
                <field name="total_booking_lines" string="Lines" />
                <field name="status" />
                <field name="create_date" />
            </list>
        </field>
    </record>

    <record id="freight_purchase_booking_search_view" model="ir.ui.view">
        <field name="name">freight.purchase.booking.search</field>
        <field name="model">freight.purchase.booking</field>
        <field name="arch" type="xml">
            <search string="Booking List">
                <field name="name" />
                <field name="status" />
                <field name="vessel_id"/>
                <field name="route_id"/>
                <field name="shipping_line_id"/>

                <!-- Status Filters -->
                <separator string="Status"/>
                <filter string="Draft" name="filter_status_draft" domain="[('status', '=', 'draft')]"/>
                <filter string="Pending" name="filter_status_pending" domain="[('status', '=', 'pending')]"/>
                <filter string="Confirmed" name="filter_status_confirmed" domain="[('status', '=', 'confirmed')]"/>
                <filter string="Fully Assigned" name="filter_status_assigned" domain="[('status', '=', 'fully_assigned')]"/>
                <filter string="Shipped" name="filter_status_shipped" domain="[('status', '=', 'shipped')]"/>
                <filter string="Cancelled" name="filter_status_cancelled" domain="[('status', '=', 'cancelled')]"/>
                <filter string="Expired" name="filter_status_expired" domain="[('status', '=', 'expired')]"/>

                <!-- Booking Mode -->
                <separator string="Booking Mode"/>
                <filter string="With Quotation" name="filter_mode_with" domain="[('booking_mode', '=', 'with_quotation')]"/>
                <filter string="Without Quotation" name="filter_mode_without" domain="[('booking_mode', '=', 'without_quotation')]"/>

                <!-- Group By -->
                <group expand="1" string="Group By">
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Vessel" name="group_by_vessel" context="{'group_by': 'vessel_id'}"/>
                    <filter string="Shipping Line" name="group_by_shipping" context="{'group_by': 'shipping_line_id'}"/>
                    <filter string="Route" name="group_by_route" context="{'group_by': 'route_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="freight_purchase_booking_action" model="ir.actions.act_window">
        <field name="name">Booking List</field>
        <field name="res_model">freight.purchase.booking</field>
        <field name="search_view_id" ref="freight_purchase_booking_search_view" />
        <field name="view_id" ref="freight_purchase_booking_list_view" />
        <field name="view_mode">list,form</field>
    </record>

</odoo>