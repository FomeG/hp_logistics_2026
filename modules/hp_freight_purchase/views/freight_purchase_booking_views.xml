<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="freight_purchase_booking_form_view" model="ir.ui.view">
        <field name="name">freight.purchase.booking.form</field>
        <field name="model">freight.purchase.booking</field>
        <field name="arch" type="xml">
            <form class="oe_form_configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="code" required="1" string="Ref Code" help="Booking Code"/>
                            <field name="vessel_id" required="1" widget="many2one_new_tab" />
                            <field name="voyage"/>
                            <field name="etd" />
                            <field name="status" />
                        </group>
                        <group invisible="not id" >
                            <field name="from_location_id" widget="many2one_new_tab" />
                            <field name="to_location_id" widget="many2one_new_tab" />
                            <field name="shipping_line_id" widget="many2one_new_tab"  />
                        </group>
                        <group>
                            <field name="teu_volume" />
                            <field name="note" />
                        </group>
                        <group colspan="2">
                            <field name="inventory_summary" readonly="1" widget="text" invisible="not has_inventory"/>
                        </group>

                    </group>
                    <notebook>
                        <page string="Booking Lines" invisible="not has_inventory">
                            <field name="line_ids" context="{'from_booking_form': True}">
                                <list delete="false">
                                    <!-- NOTE: Changed from pod_id to to_location_id (POD) after quotation removal #561 -->
                                    <field name="to_location_id" />
                                    <field name="container_type_id" />
                                    <field name="quantity" />
                                    <field name="price" />
                                    <field name="teu_volume" />
                                    <field name="reserved_by_id" />
                                    <field name="status" />
                                    <field name="fee_line_ids" widget="many2many_tags"
                                           options="{'no_create_edit': True}"
                                           string="Fees"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="booking_id" invisible="context.get('from_booking_form')" />
                                        <field name="container_type_id"/>
                                        <field name="quantity"/>
                                        <field name="unit_price"/>
                                        <field name="price"/>
                                        <field name="status"/>
                                    </group>
                                    <group string="Fees">
                                        <field name="fee_line_ids" invisible="not id">
                                            <list editable="bottom">
                                                <field name="fee_line_id"/>
                                                <field name="amount"/>
                                            </list>
                                        </field>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Documents">
                            <field name="attachment_ids" domain="[('booking_id', '=', id)]">
                                <list>
                                    <field name="name"/>
                                    <field name="document_type"/>
                                    <field name="create_uid"/>
                                    <field name="create_date"/>
                                </list>
                                <form string="Document">
                                    <sheet>
                                        <group>
                                            <field name="name"/>
                                            <field name="document_type" required="True"/>
                                            <field name="booking_id"/>
                                            <field name="create_uid" readonly="1" invisible="not id"/>
                                            <field name="create_date" readonly="1" invisible="not id"/>
                                        </group>
                                        <group>
                                            <field name="datas" filename="name"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Inventory" invisible="not has_inventory">
                            <field name="booking_inventory_ids" context="{'from_booking_form': True}">
                                <list edit="0" delete="0" readonly="1" no_open="1">
                                    <field name="container_type_id"/>
                                    <field name="action" />
                                    <field name="quantity" />
                                    <field name="str_inventory_booking_line" />
                                    <field name="create_date" />
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="booking_id"
                                                invisible="context.get('from_booking_form')" />
                                            <!-- NOTE: Removed domain allow_container_type_ids (quotation removal #561) -->
                                            <field name="container_type_id" required="1"
                                                   options="{'no_create': True,'no_create_edit': True}"
                                            />
                                            <field name="quantity" required="1" />
                                            <field name="action" readonly="1"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Common Fees" invisible="not has_fees">
                            <field name="fee_ids">
                                <list editable="bottom">
                                    <field name="fee_type_id"/>
                                    <field name="amount"/>
                                    <field name="note" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="freight_purchase_booking_list_view" model="ir.ui.view">
        <field name="name">freight.purchase.booking.list</field>
        <field name="model">freight.purchase.booking</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Booking List">
                <field name="code" string="Code" />
                <field name="shipping_line_id" />
                <field name="from_location_id" />
                <field name="to_location_id" />
                <field name="vessel_id" />
                <field name="etd" />
                <field name="teu_volume" />
                <field name="total_booking_lines" string="Lines" />
                <field name="status" />
                <field name="create_date" />
            </list>
        </field>
    </record>

    <record id="freight_purchase_booking_search_view" model="ir.ui.view">
        <field name="name">freight.purchase.booking.search</field>
        <field name="model">freight.purchase.booking</field>
        <field name="arch" type="xml">
            <search string="Booking List">
                <field name="code" />
                <field name="status" />
                <field name="vessel_id"/>
                <field name="from_location_id" />
                <field name="to_location_id" />
                <field name="shipping_line_id"/>

                <!-- Status Filters -->
                <separator string="Status"/>
                <filter string="Draft" name="filter_status_draft" domain="[('status', '=', 'draft')]"/>
                <filter string="Pending" name="filter_status_pending" domain="[('status', '=', 'pending')]"/>
                <filter string="Confirmed" name="filter_status_confirmed" domain="[('status', '=', 'confirmed')]"/>
                <filter string="Fully Assigned" name="filter_status_assigned" domain="[('status', '=', 'fully_assigned')]"/>
                <filter string="Shipped" name="filter_status_shipped" domain="[('status', '=', 'shipped')]"/>
                <filter string="Cancelled" name="filter_status_cancelled" domain="[('status', '=', 'cancelled')]"/>
                <filter string="Expired" name="filter_status_expired" domain="[('status', '=', 'expired')]"/>

                <!-- Group By -->
                <group expand="1" string="Group By">
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Vessel" name="group_by_vessel" context="{'group_by': 'vessel_id'}"/>
                    <filter string="Shipping Line" name="group_by_shipping" context="{'group_by': 'shipping_line_id'}"/>
                    <filter string="POL" name="group_by_pol" context="{'group_by': 'from_location_id'}"/>
                    <filter string="POD" name="group_by_pod" context="{'group_by': 'to_location_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="freight_purchase_booking_action" model="ir.actions.act_window">
        <field name="name">Booking List</field>
        <field name="res_model">freight.purchase.booking</field>
        <field name="search_view_id" ref="freight_purchase_booking_search_view" />
        <field name="view_id" ref="freight_purchase_booking_list_view" />
        <field name="view_mode">list,form</field>
    </record>

</odoo>