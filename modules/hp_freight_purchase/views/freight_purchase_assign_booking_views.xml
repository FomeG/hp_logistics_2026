<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_order_assign_booking_list_view" model="ir.ui.view">
        <field name="name">sale.order.assign_booking.list</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Select Sale Order" create="false" edit="false">
                <field name="name" />
                <field name="date_order" />
                <field name="partner_id" />
                <field name="user_id" />
                <field name="amount_total" />
                <button name="action_assign_booking"
                    string="Select"
                    type="object"
                    class="btn-primary"
                    icon="fa-check" />
            </list>
        </field>
    </record>

    <record id="freight_purchase_assign_booking_form_view" model="ir.ui.view">
        <field name="name">freight.purchase.booking.form</field>
        <field name="model">freight.purchase.booking</field>
        <field name="arch" type="xml">
            <form class="oe_form_configuration" create="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="booking_mode" readonly="1"/>
                            <field name="quotation_id"
                                invisible="not id and booking_mode == 'without_quotation'"
                                readonly="1" widget="many2one_new_tab" />
                            <field name="code" string="Ref Code" help="Booking Code" readonly="1"/>
                            <field name="vessel_id" widget="many2one_new_tab" readonly="1"/>
                            <field name="etd" readonly="1"/>
                            <field name="status" readonly="1"/>
                        </group>
                        <group invisible="booking_mode == 'without_quotation'" >
                            <field name="from_location_id" widget="many2one_new_tab" />
                            <field name="to_location_id" widget="many2one_new_tab" />
                            <field name="shipping_line_id" widget="many2one_new_tab"  />
                        </group>

                        <group invisible="booking_mode == 'with_quotation'">
                            <field name="quotation_shipping_line_id"
                                required="booking_mode == 'without_quotation'"
                                domain="[('partner_main_type_id.code', '=', 'shipping_line')]"
                                readonly="1"
                                widget="many2one_new_tab" />
                        </group>
                        <group>
                            <field name="teu_volume" readonly="1"/>
                            <field name="note" readonly="1"/>
                        </group>
                        <group colspan="2">
                            <field name="inventory_summary" readonly="1" widget="text"/>
                        </group>

                    </group>
                    <notebook>
                        <page string="Booking Lines">
                            <field name="line_ids" context="{'from_booking_form': True}" readonly="1">
                                <list delete="false">
                                    <field name="pod_id" string="POD"/>
                                    <field name="quotation_line_id" groups="base.group_system"/>
                                    <field name="container_type_id" string="Container"/>
                                    <field name="quantity" />
                                    <field name="price" />
                                    <field name="teu_volume" />
                                    <field name="status" />
                                    <field name="fee_line_ids" widget="many2many_tags"
                                           options="{'no_create_edit': True}"
                                           string="Fees"/>
                                    <field name="sale_order_id" />
                                    <button name="action_link_to_order"
                                        string="Link to Order"
                                        type="object"
                                        icon="fa-external-link"
                                        invisible="sale_order_id" />
                                </list>
                            </field>
                        </page>
                        <page string="Documents">
                            <field name="attachment_ids" domain="[('booking_id', '=', id)]" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="document_type"/>
                                    <field name="create_uid"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Inventory" invisible="not is_show_inventory">
                            <field name="booking_inventory_ids" context="{'from_booking_form': True}" readonly="1">
                                <list edit="0" delete="0" readonly="1" no_open="1">
                                    <field name="container_type_id"/>
                                    <field name="action" />
                                    <field name="quantity" />
                                    <field name="str_inventory_booking_line" />
                                    <field name="create_date" />
                                </list>
                            </field>
                        </page>
                        <page string="Common Fees" invisible="not has_fees" readonly="1">
                            <field name="fee_ids">
                                <list editable="bottom">
                                    <field name="fee_type_id"/>
                                    <field name="amount"/>
                                    <field name="note" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="freight_purchase_assign_booking_list_view" model="ir.ui.view">
        <field name="name">freight.purchase.booking.list</field>
        <field name="model">freight.purchase.booking</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Booking List" create="false" delete="false">
                <field name="quotation_id" groups="base.group_system"/>
                <field name="code" string="Code" />
                <field name="shipping_line_id" />
                <field name="from_location_id" />
                <field name="to_location_id" />
                <field name="vessel_id" />
                <field name="etd" />
                <field name="teu_volume" />
                <field name="total_booking_lines" string="Lines" />
                <field name="status" />
                <field name="create_date" />
            </list>
        </field>
    </record>

    <record id="freight_purchase_assign_booking_action" model="ir.actions.act_window">
        <field name="name">Booking List</field>
        <field name="res_model">freight.purchase.booking</field>
        <field name="search_view_id" ref="hp_freight_purchase.freight_purchase_booking_search_view" />
        <field name="view_id" ref="hp_freight_purchase.freight_purchase_assign_booking_list_view" />
        <field name="view_mode">list,form</field>
        <field name="context"
            eval="{
                'form_view_ref': 'hp_freight_purchase.freight_purchase_assign_booking_form_view',
            }" />
    </record>

</odoo>