<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_order_assign_booking_list_view" model="ir.ui.view">
        <field name="name">sale.order.assign_booking.list</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Select Sale Order" create="false" edit="false">
                <field name="name" />
                <field name="partner_id" string="Client" />
                <field name="from_location_id" />
                <field name="to_location_id" />
                <field name="user_id" />
                <field name="container_type_id" string="Container Type"/>
                <field name="etd" />
                <button name="action_assign_booking"
                    string="Provide Booking"
                    type="object"
                    class="btn-primary"
                    icon="fa-external-link" />
            </list>
        </field>
    </record>

    <record id="sale_order_assign_booking_search_view" model="ir.ui.view">
        <field name="name">sale.order.assign_booking.search</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="etd" />
                <field name="partner_id" />
                <field name="user_id" />
                <field name="from_location_id" />
                <field name="to_location_id" />
            </search>
        </field>
    </record>

    <record id="assign_booking_line_list_view" model="ir.ui.view">
        <field name="name">freight.purchase.booking.line.list</field>
        <field name="model">freight.purchase.booking.line</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0" multi_edit="0">
                <field name="booking_id" />
                <field name="from_location_id" string="From"/>
                <field name="to_location_id" string="To" />
                <field name="container_type_id" string="Container"/>
                <field name="quantity" />
                <field name="status" />
                <button name="action_link_to_order"
                    string="Select"
                    type="object"
                    class="btn-success"
                    icon="fa-check" />
            </list>
        </field>
    </record>

    <record id="freight_purchase_assign_booking_action" model="ir.actions.act_window">
        <field name="name">Provide Booking Sale Order</field>
        <field name="res_model">sale.order</field>
        <field name="search_view_id" ref="hp_freight_purchase.sale_order_assign_booking_search_view" />
        <field name="view_id" ref="hp_freight_purchase.sale_order_assign_booking_list_view" />
        <field name="view_mode">list</field>
        <field name="domain">[
            ('state', '=', 'request_booking'),
            ('booking_line_id', '=', False),
            ('from_location_id', '!=', False),
            ('to_location_id', '!=', False),
            ('etd', '!=', False),
        ]</field>
    </record>
</odoo>