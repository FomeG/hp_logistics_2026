<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="freight_purchase_fee_form_view" model="ir.ui.view">
        <field name="name">freight.purchase.fee.form</field>
        <field name="model">freight.purchase.fee</field>
        <field name="arch" type="xml">
            <form string="Fee">
                <sheet>
                    <group>
                        <field name="shipping_line_id" required="1" />
                        <field name="fee_type_id" required="1" />
                        <field name="date_from" />
                        <field name="date_to" />
                        <field name="note" />
                        <field name="line_ids" invisible="not id">
                            <list disable_parent_selection="true" editable="bottom">
                                <field name="container_type_id" string="Container" />
                                <field name="amount" />
                            </list>
                        </field>
                        <field name="quotations" readonly="1" invisible="not id">
                            <list>
                                <field name="name" string="Name" />
                                <field name="route_id" />
                                <field name="shipping_line_id" />
                                <field name="available_from" />
                                <field name="available_to" />
                                <field name="is_active" />
                                <field name="create_date" />
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="freight_purchase_fee_list_view" model="ir.ui.view">
        <field name="name">freight.purchase.fee.list</field>
        <field name="model">freight.purchase.fee</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="List Fee">
                <field name="shipping_line_id" />
                <field name="fee_type_id" />
                <field name="total_quotation" />
                <field name="create_date" />
            </list>
        </field>
    </record>

    <record id="freight_purchase_fee_search_view" model="ir.ui.view">
        <field name="name">freight.purchase.fee.search</field>
        <field name="model">freight.purchase.fee</field>
        <field name="arch" type="xml">
            <search string="List Fee">
                <field name="shipping_line_id" />
                <field name="fee_type_id" />

                <separator string="Quick Filters"/>
                <!-- Date to within 1 week -->
                <filter string="Ending Within 1 Week" name="filter_date_to_week"
                        domain="[('date_to', '&lt;=', (context_today() + relativedelta(days=7)).strftime('%%Y-%%m-%%d'))]"/>

                <!-- Fee Type Filter -->
                <separator string="Fee Type"/>
                <filter string="D Fees" name="filter_fee_type_doc"
                        domain="[('fee_type_id.type', '=', 'd')]"/>
                <filter string="L Fees" name="filter_fee_type_handling"
                        domain="[('fee_type_id.type', '=', 'l')]"/>
                <filter string="L/D Fees" name="filter_fee_type_ld"
                        domain="[('fee_type_id.type', '=', 'l/d')]"/>

                <separator string="Quotation Link"/>
                <filter string="With Quotations" name="filter_with_quotation" domain="[('quotations', '!=', False)]"/>
                <filter string="Without Quotations" name="filter_without_quotation" domain="[('quotations', '=', False)]"/>

                <!-- Group By -->
                <separator string="Group By"/>
                <group expand="1" string="Group By">
                    <filter string="Shipping Line" name="group_by_shipping_line" context="{'group_by': 'shipping_line_id'}"/>
                    <filter string="Fee Type" name="group_by_fee_type" context="{'group_by': 'fee_type_id'}"/>
                    <filter string="Date To" name="group_by_date_to" context="{'group_by': 'date_to'}"/>
                    <filter string="Created Date" name="group_by_create_date" context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="freight_purchase_fee_action" model="ir.actions.act_window">
        <field name="name">Freight Purchase Fee</field>
        <field name="res_model">freight.purchase.fee</field>
        <field name="search_view_id" ref="freight_purchase_fee_search_view" />
        <field name="view_id" ref="freight_purchase_fee_list_view" />
        <field name="view_mode">list,form</field>
    </record>

</odoo>