<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit Sea Freight Request Form to add Assign button for DOPR -->
    <record id="view_sea_freight_request_form_inherit" model="ir.ui.view">
        <field name="name">sea.freight.request.form.inherit.freight.purchase</field>
        <field name="model">freight.purchase.sea.freight.request</field>
        <field name="inherit_id" ref="hp_sale.view_sea_freight_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_assign_pricing_member"
                        type="object"
                        string="Assign"
                        class="btn-secondary"
                        groups="hp_freight_purchase.group_hp_freight_purchase_lead"
                        invisible="state != 'open'"
                        />
            </xpath>
        </field>    
    </record>
</odoo>
