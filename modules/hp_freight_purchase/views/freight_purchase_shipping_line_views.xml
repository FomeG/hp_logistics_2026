<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Add custom section for shipping line -->
    <record id="freight_purchase_shipping_line_form_view" model="ir.ui.view">
        <field name="name">freight.purchase.shipping.line.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority" eval="37"/>
        <field name="arch" type="xml">
            <!-- Add custom section for shipping line -->
            <xpath expr="//form/sheet" position="replace">
                <sheet>
                    <group>
                        <field name="name" string="Shipping Line Name" placeholder="e.g. Global Shipping Co." class="oe_form_field" required="1"/>
                        <field name="email" string="Shipping Line Email" widget="email" placeholder="e.g. contact@shippingline.com" class="oe_form_field" required="1"/>
                        <field name="is_shipping_line" value="1" invisible="1" />
                        <notebook invisible="not id">
                            <page string="Quotations" invisible="not quotation_ids">
                                <field name="quotation_ids"
                                       context="{'list_view_ref': 'hp_freight_purchase.freight_purchase_quotation_short_list_view'}"
                                       readonly="1"
                                />
                            </page>
                            <page string="Bookings" invisible="not booking_ids">
                                <field name="booking_ids"
                                       context="{'list_view_ref': 'hp_freight_purchase.freight_purchase_booking_short_list_view'}"
                                       options="{'no_create': True, 'no_edit': True}" readonly="1"
                                />
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </xpath>
        </field>
    </record>

    <!-- Quotation List Short View -->
    <record id="freight_purchase_quotation_short_list_view" model="ir.ui.view">
        <field name="name">freight.purchase.quotation.list</field>
        <field name="model">freight.purchase.quotation</field>
        <field name="arch" type="xml">
            <list>
                <field name="route_id" />
                <field name="available_from" string="From"/>
                <field name="available_to" string="Until" />
                <field name="str_fees" />
                <field name="is_active" string="Active" />
                <field name="create_date" options="{'format': 'MM/dd/yyyy HH:mm:ss'}"/>
            </list>
        </field>
    </record>

    <!-- Booking List Short View -->
    <record id="freight_purchase_booking_short_list_view" model="ir.ui.view">
        <field name="name">freight.purchase.booking.list</field>
        <field name="model">freight.purchase.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="code" string="Code"/>
                <field name="quotation_id" groups="base.group_system"/>
                <field name="vessel_id"/>
                <field name="route_id" />
                <field name="etd" />
                <field name="teu_volume" />
                <field name="status" />
                <field name="create_date" options="{'format': 'MM/dd/yyyy HH:mm:ss'}"/>
            </list>
        </field>
    </record>
    
    <record id="freight_purchase_shipping_line_list_view" model="ir.ui.view">
        <field name="name">freight.purchase.shipping.line.list</field>
        <field name="model">res.partner</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Shipping Lines">
                <field name="name" string="Shipping Line Name"/>
                <field name="email" string="Shipping Line Email"/>
                <field name="total_bookings" />
                <field name="total_quotations" />
                <field name="create_date" />
            </list>
        </field>
    </record>

    <record id="freight_purchase_shipping_line_search_view" model="ir.ui.view">
        <field name="name">freight.purchase.shipping.line.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Shipping Lines">
                <field name="name" string="Shipping Line Name"/>
                <field name="email" string="Shipping Line Email"/>

                <!-- Filters: Quotations -->
                <separator string="Quotations"/>
                <filter string="With Quotations" name="filter_has_quotations"
                        domain="[('quotation_ids', '!=', False)]"/>
                <filter string="Without Quotations" name="filter_no_quotations"
                        domain="[('quotation_ids', '=', False)]"/>

                <!-- Filters: Bookings -->
                <separator string="Bookings"/>
                <filter string="With Bookings" name="filter_has_bookings"
                        domain="[('booking_ids', '!=', False)]"/>
                <filter string="Without Bookings" name="filter_no_bookings"
                        domain="[('booking_ids', '=', False)]"/>

                <!-- Group By -->
                <separator string="Group By"/>
                <group expand="1" string="Group By">
                    <filter string="Created Date" name="group_by_created"
                            context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="freight_purchase_shipping_line_action" model="ir.actions.act_window">
        <field name="name">Shipping Lines</field>
        <field name="view_mode">list,form</field>
        <field name="res_model">res.partner</field>
        <field name="domain">[('is_shipping_line', '=', True)]</field>
        <field name="context">{'default_is_shipping_line': True}</field>
        <field name="search_view_id" ref="freight_purchase_shipping_line_search_view"/>
        <field name="views" eval="[
            (ref('freight_purchase_shipping_line_list_view'), 'list'),
            (ref('freight_purchase_shipping_line_form_view'), 'form'),
        ]"/>
    </record>

</odoo>
