<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="freight_purchase_fee_type_form_view" model="ir.ui.view">
        <field name="name">freight.purchase.fee.type.form</field>
        <field name="model">freight.purchase.fee.type</field>
        <field name="arch" type="xml">
            <form string="Fee Type">
                <sheet>
                    <group>
                        <field name="name" required="1" />
                        <field name="direction" />
                        <field name="is_common" help="Check if the fee applied directly to quotation"/>
                        <field name="amount" invisible="not is_common" required="is_common" />
                        <field name="active" invisible="not id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="freight_purchase_fee_type_list_view" model="ir.ui.view">
        <field name="name">freight.purchase.fee.type.list</field>
        <field name="model">freight.purchase.fee.type</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Fee Type List">
                <field name="name" />
                <field name="direction" />
                <field name="is_common" />
                <field name="amount" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="freight_purchase_fee_type_search_view" model="ir.ui.view">
        <field name="name">freight.purchase.fee.type.search</field>
        <field name="model">freight.purchase.fee.type</field>
        <field name="arch" type="xml">
            <search string="Fee Type Search">
                <field name="name" />
                <field name="direction" />
                <field name="is_common" />
                <field name="amount" />
                <field name="active" />
                <separator string="Active Status"/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="filter_inactive" domain="[('active', '=', False)]"/>

                <separator string="Group By"/>
                <group expand="1" string="Group By">
                    <filter string="Active Status" name="group_by_active" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="freight_purchase_fee_type_action" model="ir.actions.act_window">
        <field name="name">Freight Purchase Fee Type</field>
        <field name="res_model">freight.purchase.fee.type</field>
        <field name="search_view_id" ref="freight_purchase_fee_type_search_view" />
        <field name="view_id" ref="freight_purchase_fee_type_list_view" />
        <field name="view_mode">list,form</field>
    </record>

</odoo>
