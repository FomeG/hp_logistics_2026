<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Inherit Region Form View - Add Freight Purchase specific fields -->
    <record id="freight_purchase_region_form_view" model="ir.ui.view">
        <field name="name">freight.purchase.region.form.inherit</field>
        <field name="model">region</field>
        <field name="inherit_id" ref="hp_components.region_form_view"/>
        <field name="arch" type="xml">
            <!-- Add employee_ids field after parent_id -->
            <field name="parent_id" position="after">
                <field name="employee_ids" invisible="1"/>
            </field>

            <!-- Replace Countries page with enhanced version -->
            <xpath expr="//notebook/page[1]" position="after">
                <page string="Countries">
                    <field name="country_ids"
                           context="{'form_view_ref': 'hp_freight_purchase.view_country_with_ports_form'}"
                           widget="many2many">
                        <list>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="port_ids" widget="many2many_tags"/>
                        </list>
                    </field>
                </page>
            </xpath>

            <!-- Hide original Countries page -->
            <xpath expr="//notebook/page[2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Add Employees page -->
            <xpath expr="//notebook/page[1]" position="after">
                <page string="Employees" name="employees"
                      groups="hp_freight_purchase.group_hp_freight_purchase_member,hp_freight_purchase.group_hp_freight_purchase_lead,hp_freight_purchase.group_hp_freight_purchase_director,hp_freight_purchase.group_hp_freight_purchase_administrator">
                    <field name="employee_ids"
                           domain="[('department_id.department_type_id.code', '=', 'pricing')]">
                        <list create="0" delete="0" edit="0" multi_edit="0">
                            <field name="name" />
                            <field name="work_phone" />
                            <field name="work_email" />
                            <field name="address_id" />
                            <field name="job_id" />
                            <field name="active" />
                        </list>
                    </field>
                </page>
            </xpath>

            <!-- Add Teams page after Countries -->
            <xpath expr="//notebook/page[1]" position="after">
                <page string="Teams">
                    <field name="team_ids" widget="many2many">
                        <list string="Teams">
                            <field name="name"/>
                            <field name="department_id"/>
                            <field name="user_ids" widget="many2many_tags"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Inherit Region List View - Add Freight Purchase specific fields -->
    <record id="freight_purchase_region_list_view" model="ir.ui.view">
        <field name="name">freight.purchase.region.list.inherit</field>
        <field name="model">region</field>
        <field name="inherit_id" ref="hp_components.region_list_view"/>
        <field name="arch" type="xml">
            <!-- Remove parent_id from list -->
            <field name="parent_id" position="replace"/>
            <!-- Add employee_string and port_string after is_active -->
            <field name="is_active" position="after">
                <field name="employee_string" optional="show"
                       groups="hp_freight_purchase.group_hp_freight_purchase_member,hp_freight_purchase.group_hp_freight_purchase_lead,hp_freight_purchase.group_hp_freight_purchase_director,hp_freight_purchase.group_hp_freight_purchase_administrator"/>
                <field name="port_string" optional="show"
                       groups="hp_freight_purchase.group_hp_freight_purchase_member,hp_freight_purchase.group_hp_freight_purchase_lead,hp_freight_purchase.group_hp_freight_purchase_director,hp_freight_purchase.group_hp_freight_purchase_administrator"/>
            </field>
        </field>
    </record>

    <record id="freight_purchase_region_search_view" model="ir.ui.view">
        <field name="name">freight.purchase.region.search.inherit</field>
        <field name="model">region</field>
        <field name="inherit_id" ref="hp_components.region_search_view"/>
        <field name="arch" type="xml">
            <!-- Add Employee Filters after Countries filters -->
            <filter name="filter_without_countries" position="after">
                <separator string="Employees"/>
                <filter string="Has Employees" name="filter_with_employees" domain="[('employee_ids', '!=', False)]"/>
                <filter string="No Employees" name="filter_without_employees" domain="[('employee_ids', '=', False)]"/>
            </filter>

            <!-- Add Port Filters -->
            <filter name="filter_without_employees" position="after">
                <separator string="Ports"/>
                <filter string="Has Ports" name="filter_with_ports" domain="[('ports', '!=', False)]"/>
                <filter string="No Ports" name="filter_without_ports" domain="[('ports', '=', False)]"/>
            </filter>

            <!-- Add Group By options -->
            <filter name="group_by_active" position="after">
                <filter string="Employees" name="group_by_employees" context="{'group_by': 'employee_string'}"/>
                <filter string="Ports" name="group_by_ports" context="{'group_by': 'port_string'}"/>
            </filter>
        </field>
    </record>

    <record id="freight_purchase_region_action" model="ir.actions.act_window">
        <field name="name">Freight Purchase Region</field>
        <field name="res_model">region</field>
        <field name="search_view_id" ref="freight_purchase_region_search_view" />
        <field name="view_id" ref="freight_purchase_region_list_view" />
        <field name="view_mode">list,form</field>
    </record>

</odoo>