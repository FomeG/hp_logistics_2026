<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="freight_purchase_region_form_view" model="ir.ui.view">
        <field name="name">freight.purchase.region.form</field>
        <field name="model">freight.purchase.region</field>
        <field name="arch" type="xml">
            <form string="Region">
                <sheet>
                    <group>
                        <field name="name" required="1" />
                        <field name="is_active" required="1" invisible="not id" />
                    </group>
                    <notebook>
                        <page string="Employees">
                            <field name="employee_ids"
                                domain="[('department_id.department_type', '=', 'pricing')]">
                                <list create="0" delete="0" edit="0" multi_edit="0">
                                    <field name="name" />
                                    <field name="work_phone" />
                                    <field name="work_email" />
                                    <field name="address_id" />
                                    <field name="job_id" />
                                    <field name="active" />
                                </list>
                            </field>
                        </page>
                        <page string="Ports">
                            <field name="ports">
                                <list>
                                    <field name="name" />
                                    <field name="is_pod" />
                                    <field name="is_active" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="freight_purchase_region_list_view" model="ir.ui.view">
        <field name="name">freight.purchase.region.list</field>
        <field name="model">freight.purchase.region</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="List Regions">
                <field name="code" />
                <field name="name" />
                <field name="is_active" />
                <field name="employee_string" />
                <field name="port_string" />
                <field name="create_date" groups="base.group_system" />
            </list>
        </field>
    </record>

    <record id="freight_purchase_region_search_view" model="ir.ui.view">
        <field name="name">freight.purchase.region.search</field>
        <field name="model">freight.purchase.region</field>
        <field name="arch" type="xml">
            <search string="List Regions">
                <field name="code" />
                <field name="name" />
                <field name="is_active" />

                <!-- Active Filters -->
                <separator string="Status"/>
                <filter string="Active" name="filter_active" domain="[('is_active', '=', True)]"/>
                <filter string="Inactive" name="filter_inactive" domain="[('is_active', '=', False)]"/>

                <!-- Employee Filters -->
                <separator string="Employees"/>
                <filter string="Has Employees" name="filter_with_employees" domain="[('employee_ids', '!=', False)]"/>
                <filter string="No Employees" name="filter_without_employees" domain="[('employee_ids', '=', False)]"/>

                <!-- Port Filters -->
                <separator string="Ports"/>
                <filter string="Has Ports" name="filter_with_ports" domain="[('ports', '!=', False)]"/>
                <filter string="No Ports" name="filter_without_ports" domain="[('ports', '=', False)]"/>

                <!-- Group By -->
                <separator string="Group By"/>
                <group expand="1" string="Group By">
                    <filter string="Active" name="group_by_active" context="{'group_by': 'is_active'}"/>
                    <filter string="Employees" name="group_by_employees" context="{'group_by': 'employee_string'}"/>
                    <filter string="Ports" name="group_by_ports" context="{'group_by': 'port_string'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="freight_purchase_region_action" model="ir.actions.act_window">
        <field name="name">Freight Purchase Region</field>
        <field name="res_model">freight.purchase.region</field>
        <field name="search_view_id" ref="freight_purchase_region_search_view" />
        <field name="view_id" ref="freight_purchase_region_list_view" />
        <field name="view_mode">list,form</field>
    </record>

</odoo>