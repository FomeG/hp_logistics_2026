<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="freight_purchase_vessel_form_view" model="ir.ui.view">
        <field name="name">freight.purchase.vessel.form</field>
        <field name="model">freight.purchase.vessel</field>
        <field name="arch" type="xml">
            <form string="Vessel">
                <sheet>
                    <group>
                        <field name="name" required="1" />
                        <field name="is_active" required="1" invisible="not id" />
                        <field name="booking_ids" readonly="1" invisible="not id">
                            <list>
                                <field name="name" />
                                <!-- comment #561
                                <field name="quotation_id" />
                                -->
                                <field name="from_location_id" />
                                <field name="to_location_id" />
                                <field name="shipping_line_id" />
                                <field name="etd" />
                                <field name="teu_volume" />
                                <field name="status" />
                                <field name="create_date" />
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="freight_purchase_vessel_list_view" model="ir.ui.view">
        <field name="name">freight.purchase.vessel.list</field>
        <field name="model">freight.purchase.vessel</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="List Vessels">
                <field name="code" />
                <field name="name" />
                <field name="total_bookings" />
                <field name="is_active" />
                <field name="create_date" />
            </list>
        </field>
    </record>

    <record id="freight_purchase_vessel_search_view" model="ir.ui.view">
        <field name="name">freight.purchase.vessel.search</field>
        <field name="model">freight.purchase.vessel</field>
        <field name="arch" type="xml">
            <search string="List Vessels">
                <field name="code" />
                <field name="name" />
                <field name="is_active" />

                <!-- Filters: Active -->
                <separator string="Status"/>
                <filter string="Active" name="filter_active" domain="[('is_active', '=', True)]"/>
                <filter string="Inactive" name="filter_inactive" domain="[('is_active', '=', False)]"/>

                <!-- Filters: Bookings -->
                <separator string="Bookings"/>
                <filter string="With Bookings" name="filter_with_bookings" domain="[('booking_ids', '!=', False)]"/>
                <filter string="Without Bookings" name="filter_without_bookings" domain="[('booking_ids', '=', False)]"/>

                <!-- Group By -->
                <separator string="Group By"/>
                <group expand="1" string="Group By">
                    <filter string="Active Status" name="group_by_active" context="{'group_by': 'is_active'}"/>
                    <filter string="Created Date" name="group_by_created" context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="freight_purchase_vessel_action" model="ir.actions.act_window">
        <field name="name">Freight Purchase Vessel</field>
        <field name="res_model">freight.purchase.vessel</field>
        <field name="search_view_id" ref="freight_purchase_vessel_search_view" />
        <field name="view_id" ref="freight_purchase_vessel_list_view" />
        <field name="view_mode">list,form</field>
    </record>

</odoo>