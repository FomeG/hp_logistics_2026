<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Sale Order view to add booking_line_id visibility logic -->
    <record id="sale_order_form_booking_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.booking.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Add booking_line_id field for visibility conditions -->
            <xpath expr="//field[@name='state']" position="after">
                <field name="booking_line_id" invisible="1"/>
            </xpath>

            <!-- Override Confirm button to require booking_line_id -->
            <!-- <xpath expr="//button[@id='btn_confirm_sale']" position="attributes"> -->
            <xpath expr="//button[@name='action_update_state'][contains(@context, &quot;'new_state': 'sale'&quot;)]" position="attributes">
                <attribute name="invisible">state != 'request_booking' or not booking_line_id</attribute>
            </xpath>
        </field>
    </record>
</odoo>
