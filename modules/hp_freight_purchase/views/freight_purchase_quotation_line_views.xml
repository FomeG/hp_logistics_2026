<odoo>

    <record id="freight_purchase_quotation_line_form_view" model="ir.ui.view">
        <field name="name">freight.purchase.quotation.line.form</field>
        <field name="model">freight.purchase.quotation.line</field>
        <field name="arch" type="xml">
            <form>
<!--                <sheet>-->
                    <group col="2">
                        <field name="quotation_id"/>
                        <field name="container_type_id"/>
                        <field name="cost"/>
                        <field name="price"/>
                    </group>
<!--                </sheet>-->
            </form>
        </field>
    </record>

    <record id="freight_purchase_quotation_line_list_view" model="ir.ui.view">
        <field name="name">freight.purchase.quotation.line.list</field>
        <field name="model">freight.purchase.quotation.line</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Quotation Lines">
                <field name="quotation_id"/>
                <field name="container_type_id"/>
                <field name="cost"/>
                <field name="price"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="freight_purchase_quotation_line_search_view" model="ir.ui.view">
        <field name="name">freight.purchase.quotation.line.search</field>
        <field name="model">freight.purchase.quotation.line</field>
        <field name="arch" type="xml">
            <search string="Quotation Line Search">
                <field name="quotation_id"/>
                <field name="container_type_id"/>
                <field name="cost"/>
                <field name="price"/>
                <field name="create_date"/>

                <group expand="1" string="Group By">
                    <filter name="group_by_quotation" string="Quotation" context="{'group_by': 'quotation_id'}"/>
                    <filter name="group_by_container" string="Container Type" context="{'group_by': 'container_type_id'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="freight_purchase_quotation_line_action" model="ir.actions.act_window">
        <field name="name">Quotation Lines</field>
        <field name="res_model">freight.purchase.quotation.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="freight_purchase_quotation_line_list_view"/>
    </record>

</odoo>
