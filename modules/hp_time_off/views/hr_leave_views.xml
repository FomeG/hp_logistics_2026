<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hr_leave_tree_inherit_request_refuse" model="ir.ui.view">
        <field name="name">hr.leave.tree.inherit.request.refuse</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="request_refuse"/>
            </xpath>
        </field>
    </record>

    <record id="hr_leave_view_form_inherit_custom_action" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherit.custom.action</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button 
                    name="action_request_refuse"
                    string="Request Refuse"
                    type="object"
                    class="btn-secondary"
                    invisible="request_refuse or state not in ('validate', 'validate1') or create_uid != uid"/>
            </xpath>

            <xpath expr="//div[@class='alert alert-info' and @role='alert']" position="after">
                <div class="alert alert-warning" role="alert" invisible="not request_refuse">
                    <span>
                        The employee has requested to refuse this approved time off.
                    </span>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_hr_holidays_filter_inherit_request_refuse" model="ir.ui.view">
        <field name="name">hr.holidays.filter.inherit.request.refuse</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.view_hr_holidays_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Request Refuse"
                        name="request_refuse_true"
                        domain="[('request_refuse', '=', True)]"
                        help="Show requests that have been marked as Request Refuse"/>
            </xpath>

             <xpath expr="//filter[@name='waiting_for_me']" position="attributes">
                <attribute name="domain">[
                    '|',
                    ('request_refuse', '=', True),
                    '&amp;',
                        ('state','in',['confirm']),
                        '|',
                        ('employee_id.user_id', '!=', uid),
                        '&amp;',
                        ('employee_id.user_id', '=', uid),
                        ('employee_id.leave_manager_id', '=', uid)
                ]</attribute>
            </xpath>

            <xpath expr="//filter[@name='waiting_for_me_manager']" position="attributes">
                <attribute name="domain">[
                    '|',
                    ('request_refuse', '=', True),
                    '&amp;',
                        ('state','in',['confirm','validate1']),
                        '|',
                            ('employee_id.user_id', '!=', uid),
                            '|',
                                '&amp;',
                                    ('state','=','confirm'),
                                    ('holiday_status_id.leave_validation_type','=','hr'),
                                ('state','=','validate1')
                ]</attribute>
            </xpath>
        </field>
    </record>
</odoo>