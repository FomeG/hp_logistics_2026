<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Branch -->
        <record id="branch_dn" model="hr.branch">
            <field name="name">Đà Nẵng</field>
            <field name="branch_prefix">DN</field>
        </record>
        
        <!-- Department -->
        <record id="dep_sales_dn" model="hr.department">
            <field name="name">Sales DN</field>
            <field name="color" eval="5"/>
            <field name="branch_id" ref="branch_dn" />
            <field name="department_type_id" ref="hp_components.department_type_sale" />
        </record>
        <record id="user_dos_dn" model="res.users">
            <field name="name">DOS DN</field>
            <field name="login">dos_dn@test.com</field>
            <field name="password">123456</field>
            <field name="groups_id" eval="[ (4, ref('sales_team.group_sale_salesman_all_leads')), (4, ref('hr_holidays.group_hr_holidays_user')) ]"/>
        </record>
        <record id="emp_dos_dn" model="hr.employee">
            <field name="name">DOS DN</field>
            <field name="job_title">Sale Director DN</field>
            <field name="user_id" ref="user_dos_dn"/>
            <field name="work_email">dos_dn@test.com</field>
            <field name="department_id" ref="dep_sales_dn" />
            <field name="work_shift_id" ref="hp_employee.hr_work_shift_flexible" />
        </record>
        <record id="dep_sales_dn" model="hr.department">
            <field name="manager_id" ref="emp_dos_dn" />
        </record>

        <!-- Employee -->
        <record id="user_sm1_dn" model="res.users">
            <field name="name">Sale member 1 DN</field>
            <field name="login">sm1_dn@test.com</field>
            <field name="password">123456</field>
            <field name="groups_id" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>
        <record id="emp_sm1_dn" model="hr.employee">
            <field name="name">Sale member 1 DN</field>
            <field name="job_title">Sale</field>
            <field name="user_id" ref="user_sm1_dn"/>
            <field name="parent_id" ref="emp_dos_dn"/>
            <field name="coach_id" ref="emp_dos_dn"/>
            <field name="work_email">sm1_dn@test.com</field>
            <field name="department_id" ref="dep_sales_dn" />
            <field name="work_shift_id" ref="hp_employee.hr_work_shift_fixed" />
        </record>
    </data>
</odoo>