<odoo>
    <!-- Tree view -->
    <record id="view_cs_job_tree" model="ir.ui.view">
        <field name="name">cs.job.tree</field>
        <field name="model">cs.job</field>
        <field name="arch" type="xml">
            <list>
                   <header>
<button name="action_print_HBL_bill" string="Print HBL Bill"
        type="object" class="btn-primary"/>

</header>

                <field name="job_number"/>
                <field name="job_date"/>
                <field name="service_type"/>
                <field name="shipping_line_id"/>
                <field name="vessel"/>
                <field name="voyage"/>
                <field name="port_loading"/>
                <field name="port_discharge"/>
                <field name="eta"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_cs_job_form" model="ir.ui.view">
        <field name="name">cs.job.form</field>
        <field name="model">cs.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_print_HBL_bill" string="Print HBL Bill"
                            type="object" class="btn-primary"/>
                    <button name="action_print_debit" string="Print Debit"
                            type="object" class="btn-primary"/>
                </header>

                <sheet>
    <!-- Nhóm 2 cột -->
                    <group>
    <group string="Job information" >
        <field name="job_number"/>
        <field name="job_date"/>
        <field name="shipping_line_id"/>
    </group>

    <!-- Nhóm nhiều cột -->
    <group>
        <field name="vessel"/>
        <field name="voyage"/>
        <field name="service_type"/>
        <field name="department_code"/>
        <field name="mbl_number"/>
        <field name="hbl_number"/>
        <field name="master_bl_date"/>
        <field name="date_of_master_bl_date"/>
    </group>

    <group>
        <field name="booking_id" options="{'no_create': True, 'no_create_edit': True}"/>
        <field name="booking_line_id"/>
        <field name="port_loading"/>
        <field name="port_discharge"/>
        <field name="port_transit"/>
        <field name="pre_carriage_by"/>
        <field name="commodity"/>
    </group>

    <group>
        <field name="etd"/>
        <field name="eta"/>
        <field name="salesman_id"/>
        <field name="customer_id"/>
        <field name="quantity"/>
<!--        <field name="company_account"/>-->
<!--        <field name="personal_account"/>-->

    </group></group>
                    <notebook>
    <page string="Job Details">
        <field name="detail_ids">
            <list editable="bottom">
                <field name="shipper_id"/>
                <field name="consignee_id"/>
                <field name="notify_party_id"/>
                <field name="transport_type"/>
                <field name="freight_charge"/>
                <field name="currency_id"/>
                <field name="status"/>
                <field name="place_of_receipt"/>
                <field name="place_of_issue"/>
                <field name="prepaid_at"/>
            </list>
        </field>
    </page>
</notebook>

</sheet>


            </form>
        </field>
    </record>

    <!-- Action mở menu -->
    <record id="action_cs_job" model="ir.actions.act_window">
        <field name="name">Jobs</field>
        <field name="res_model">cs.job</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>
