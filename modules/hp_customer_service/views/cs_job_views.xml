    <!-- Form view -->
    <record id="view_cs_job_form" model="ir.ui.view">
        <field name="name">cs.job.form</field>
        <field name="model">cs.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_print_HBL_bill" string="Print HBL Bill"
                            type="object" class="btn-primary"/>
                    <button name="action_print_debit" string="Print Debit"
                            type="object" class="btn-primary"/>
                </header>

                <sheet>
    <!-- Nhóm 2 cột -->
                    <group>
                        <group string="Job Information">
                            <field name="booking_id"/>
                            <field name="cs_order_id"/>
                            <field name="booking_line_id"/>
                            <field name="container_type_id"/>
                            <field name="quantity"/>
                            <field name="container_summary"/>
                        </group>
                <!--    <group string="Job information" >-->
                <!--        <field name="job_number"/>-->
                <!--        <field name="job_date"/>-->
                <!--        <field name="shipping_line_id"/>-->
