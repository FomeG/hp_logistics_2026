<odoo>
    <!-- Tree view -->
    <record id="view_cs_job_tree" model="ir.ui.view">
        <field name="name">cs.job.tree</field>
        <field name="model">cs.job</field>
        <field name="arch" type="xml">
            <list>
                <field name="job_number"/>
                <field name="job_date"/>
                <field name="service_type"/>
                <field name="department"/>
                <field name="shipping_lines"/>
                <field name="vessel"/>
                <field name="voyage"/>
                <field name="port_loading"/>
                <field name="port_discharge"/>
                <field name="eta"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_cs_job_form" model="ir.ui.view">
        <field name="name">cs.job.form</field>
        <field name="model">cs.job</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
    <!-- Nhóm 2 cột -->
                    <group>
    <group string="Job information" >
        <field name="job_number"/>
        <field name="job_date"/>
        <field name="job_number_reference"/>
        <field name="shipping_lines"/>
    </group>

    <!-- Nhóm nhiều cột -->
    <group>
        <field name="vessel"/>
        <field name="voyage"/>
        <field name="service_type"/>
        <field name="department"/>
        <field name="master_bl_date"/>
        <field name="date_of_master_bl_date"/>
    </group>

    <group>
        <field name="port_loading"/>
        <field name="port_discharge"/>
        <field name="port_transit"/>
        <field name="pre_carriage_by"/>
        <field name="commodity"/>
    </group>

    <group>
        <field name="etd"/>
        <field name="eta"/>
        <field name="staff_sales"/>
        <field name="staff_customs"/>
    </group></group><notebook>
    <page string="Job Details">
        <field name="detail_ids">
            <list editable="bottom">
                <field name="shipper_id"/>
                <field name="consignee_id"/>
                <field name="notify_party_id"/>
                <field name="transport_type"/>
                <field name="freight_charge"/>
                <field name="currency_id"/>
                <field name="status"/>
                <field name="place_of_receipt"/>
                <field name="place_of_issue"/>
                <field name="prepaid_at"/>
            </list>
        </field>
    </page>
</notebook>

</sheet>


            </form>
        </field>
    </record>

    <!-- Action mở menu -->
    <record id="action_cs_job" model="ir.actions.act_window">
        <field name="name">Jobs</field>
        <field name="res_model">cs.job</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>
