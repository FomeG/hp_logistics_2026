                        </group>
                        <!-- Ports -->
                        <group string="Ports">
                            <field name="port_transit"/>
                            <field name="port_delivery"/>
                            <field name="port_receipt"/>
                            <field name="pre_carriage_by"/>
                            <field name="commodity"/>
                        </group>
                        <!-- Dates -->
                        <group string="Dates">
                            <field name="etd"/>
                            <field name="mother_etd"/>
                            <field name="eta"/>
                        </group>

                        <!-- People -->
                        <group string="People">
                            <field name="salesman_id"/>
                            <field name="customer_id"/>
                        </group>
