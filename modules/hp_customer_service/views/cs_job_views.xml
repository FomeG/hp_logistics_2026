                <field name="container_type_id"/>
                <field name="quantity"/>
                <field name="container_summary"/>
                <field name="master_bl_date"/>
                <field name="mbl_number"/>
                <field name="hbl_number"/>
                <field name="commodity"/>
                <field name="booking_number"/>
                <field name="booking_party"/>
                <field name="bill_type"/>
