                        <!-- Nhóm nhiều cột -->
                        <!-- Shipment info -->
                        <group string="Shipment Info">
                            <field name="vessel_transit"/>
                            <field name="master_bl_date"/>
                            <field name="mbl_number"/>
                            <field name="hbl_number"/>
                            <field name="date_of_master_bl_date"/>
                        </group>
