<!--                    &lt;!&ndash;        <field name="personal_account"/>&ndash;&gt;-->
<!--                        </group>-->
                    </group>
                    <notebook>
                        <page string="Job Details">
                            <field name="detail_ids">
                                <list editable="bottom">
                                    <field name="shipper_id"/>
                                    <field name="consignee_id"/>
                                    <field name="notify_party_id"/>
                                    <field name="transport_type"/>
                                    <field name="freight_charge"/>
                                    <field name="currency_id"/>
                                    <field name="status"/>
                                    <field name="place_of_receipt"/>
                                    <field name="place_of_issue"/>
                                    <field name="prepaid_at"/>
                                </list>
                            </field>
                        </page>
                        <page string="Container Details">
                            <field name="container_ids">
                                <list editable="bottom">
                                    <field name="container_number"/>
                                    <field name="container_type_id"/>
                                    <field name="seal_number"/>
                                    <field name="gross_weight"/>
                                    <field name="net_weight"/>
                                    <field name="description"/>
                                    <field name="package_type"/>
                                    <field name="uom_id"/>
                                    <field name="quantity"/>
