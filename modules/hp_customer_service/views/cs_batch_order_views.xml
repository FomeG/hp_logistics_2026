<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cs_batch_order_list" model="ir.ui.view">
        <field name="name">cs.batch.order.list</field>
        <field name="model">cs.batch.order</field>
        <field name="arch" type="xml">
            <list string="Batch Orders">
                <field name="name"/>
                <field name="client_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_cs_batch_order_form" model="ir.ui.view">
        <field name="name">cs.batch.order.form</field>
        <field name="model">cs.batch.order</field>
        <field name="arch" type="xml">
            <form string="Batch Order">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="client_id"/>
                    </group>
                    <notebook>
                        <page string="CS Orders" name="cs_orders">
                            <field name="cs_order_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="order_name"/>
                                    <field name="state" widget="badge"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cs_batch_order_search" model="ir.ui.view">
        <field name="name">cs.batch.order.search</field>
        <field name="model">cs.batch.order</field>
        <field name="arch" type="xml">
            <search string="Search Batch Orders">
                <field name="name"/>
                <field name="client_id"/>

                <group expand="0" string="Group By">
                    <filter string="Client" name="group_client" context="{'group_by': 'client_id'}"/>
                    <filter string="Create Date" name="group_create_date" context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cs_batch_order" model="ir.actions.act_window">
        <field name="name">Batch Orders</field>
        <field name="res_model">cs.batch.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cs_batch_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Batch Order
            </p>
            <p>
                Batch Orders group multiple CS Orders for monthly billing purposes.
            </p>
        </field>
    </record>
</odoo>
