<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cs_booking_list" model="ir.ui.view">
        <field name="name">cs.booking.list</field>
        <field name="model">cs.booking</field>
        <field name="arch" type="xml">
            <list string="Bookings">
                <field name="cs_order_id"/>
                <field name="Booking_code"/>
                <field name="shipping_line_id"/>
                <field name="vessel_id"/>
                <field name="pol_id"/>
                <field name="pod_id"/>
                <field name="etd"/>
                <field name="eta"/>
            </list>
        </field>
    </record>

    <record id="view_cs_booking_form" model="ir.ui.view">
        <field name="name">cs.booking.form</field>
        <field name="model">cs.booking</field>
        <field name="arch" type="xml">
            <form string="Booking">
                <sheet>
                    <group>
                        <group>
                            <field name="cs_order_id"/>
                            <field name="Booking_code"/>
                            <field name="shipping_line_id"/>
                            <field name="vessel_id"/>
                            <field name="voyage"/>
                        </group>
                        <group>
                            <field name="pol_id"/>
                            <field name="pod_id"/>
                            <field name="etd"/>
                            <field name="eta"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cs_booking" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">cs.booking</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>