<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shipping Document List View -->
    <record id="view_cs_shipping_document_list" model="ir.ui.view">
        <field name="name">cs.shipping.document.list</field>
        <field name="model">cs.shipping.document</field>
        <field name="arch" type="xml">
            <list string="Shipping Documents"
                  decoration-muted="state=='draft'"
                  decoration-info="state=='confirmed'"
                  decoration-success="state=='delivered'"
                  decoration-danger="state=='cancelled'">
                <field name="document_number" decoration-bf="1"/>
                <field name="instruction_type" widget="badge" decoration-info="instruction_type == 'arrival_notice'" decoration-warning="instruction_type == 'delivery_order'"/>
                <field name="cs_order_id"/>
                <field name="consignee_id"/>
                <field name="vessel_name"/>
                <field name="voyage"/>
                <field name="issue_date"/>
                <field name="eta"/>
                <field name="state" widget="badge"
                       decoration-muted="state=='draft'"
                       decoration-info="state=='confirmed'"
                       decoration-success="state=='delivered'"
                       decoration-danger="state=='cancelled'"/>
                <button name="action_export_an_excel" string="Excel AN" type="object" icon="fa-file-excel-o" invisible="instruction_type != 'arrival_notice'"/>
                <button name="action_export_do_word" string="Word DO" type="object" icon="fa-file-word-o" invisible="instruction_type != 'delivery_order'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_cs_shipping_document_form" model="ir.ui.view">
        <field name="name">cs.shipping.document.form</field>
        <field name="model">cs.shipping.document</field>
        <field name="arch" type="xml">
            <form string="Shipping Document">
                <header>
                    <!-- Nút PDF Arrival Notice -->
                    <button name="action_print_arrival_notice_pdf"
                            string="Print AN (PDF)"
                            type="object"
                            class="btn-secondary"
                            icon="fa-print"
                            invisible="instruction_type != 'arrival_notice'"/>

                    <!-- Nút PDF Delivery Order -->
                    <button name="action_print_delivery_order_pdf"
                            string="Print DO (PDF)"
                            type="object"
                            class="btn-secondary"
                            icon="fa-print"
                            invisible="instruction_type != 'delivery_order'"/>
                    <!-- Nút Xuất Excel cho Arrival Notice -->
                    <button name="action_export_an_excel"
                            string="Export AN (Excel)"
                            type="object"
                            class="btn-success"
                            icon="fa-file-excel-o"
                            invisible="instruction_type != 'arrival_notice'"/>

                    <!-- Nút Xuất Word cho Delivery Order -->
                    <button name="action_export_do_word"
                            string="Export DO (Word)"
                            type="object"
                            class="btn-primary"
                            icon="fa-file-word-o"
                            invisible="instruction_type != 'delivery_order'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,delivered"/>
                </header>
                <sheet>
                    <group>
                        <div class="oe_title">
                            <label for="document_number" class="oe_edit_only"/>
                            <h1>
                                <field name="document_number"/>
                            </h1>
                            <label for="instruction_type"/>
                            <field name="instruction_type" widget="radio" options="{'horizontal': true}"/>
                        </div>
                        <group string="General &amp; Vessel Info">
                            <field name="cs_order_id"
                                   options="{'no_create': True, 'no_open': False}"/>
                            <field name="booking_id" readonly="1"/>
                            <field name="issue_date"/>
                            <separator string="Vessel Details"/>
                            <field name="vessel_name"/>
                            <field name="voyage"/>
                            <field name="bl_number"/>
                            <field name="mbl_number" invisible="instruction_type != 'delivery_order'"/>
                            <field name="hbl_number" invisible="instruction_type != 'delivery_order'"/>
                            <field name="etd"/>
                            <field name="eta"/>
                            <field name="cs_shipping_instruction_id" invisible="1"/>
                            <field name="cs_bill_lading_id" invisible="1"/>
                            <field name="cs_task_id" invisible="1"/>
                        </group>
                        <group string="Parties &amp; Locations">
                            <field name="consignee_id"
                                   options="{'no_create': True}"/>
                            <field name="shipper_id"
                                   options="{'no_create': True}"
                                   invisible="instruction_type == 'delivery_order'"/>
                            <field name="notify_party_id"
                                   options="{'no_create': True}"
                                   invisible="instruction_type == 'delivery_order'"/>
                            <separator string="Location Information"/>
                            <field name="pol_id"/>
                            <field name="pod_id"/>
                            <field name="place_of_receipt" invisible="instruction_type == 'delivery_order'"/>
                            <field name="place_of_delivery" invisible="instruction_type == 'delivery_order'"/>

                            <separator string="Contact / Pickup Info" invisible="instruction_type != 'delivery_order'"/>
                            <field name="contact_name" invisible="instruction_type != 'delivery_order'"/>
                            <field name="contact_phone" widget="phone" invisible="instruction_type != 'delivery_order'"/>
                            <field name="contact_tax_code" invisible="instruction_type != 'delivery_order'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Container List" name="containers">
                            <field name="container_line_ids"
                                   context="{
                                       'default_shipping_document_id': id,
                                       'default_cs_order_id': cs_order_id
                                   }">
                                <list editable="bottom">
                                    <field name="container_type_id"/>
                                    <field name="container_number"/>
                                    <field name="seal_number"/>
                                    <field name="packages"/>
                                    <field name="goods_description"/>
                                    <field name="measurement"/>
                                    <field name="gross_weight" sum="Total Gross"/>
                                    <field name="net_weight" sum="Total Net"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="container_type_id"/>
                                            <field name="container_number"/>
                                            <field name="seal_number"/>
                                            <field name="packages"/>
                                        </group>
                                        <group>
                                            <field name="measurement"/>
                                            <field name="gross_weight"/>
                                            <field name="net_weight"/>
                                        </group>
                                    </group>
                                    <group>
                                        <field name="goods_description"/>
                                    </group>
                                    <group>
                                        <field name="note"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_cs_shipping_document_search" model="ir.ui.view">
        <field name="name">cs.shipping.document.search</field>
        <field name="model">cs.shipping.document</field>
        <field name="arch" type="xml">
            <search string="Search Shipping Documents">
<!--                <field name="name"/>-->
                <field name="document_number"/>
                <field name="cs_order_id"/>
                <field name="consignee_id"/>
                <field name="shipper_id"/>
                <field name="vessel_name"/>
                <field name="bl_number"/>

                <separator/>
                <filter string="Draft" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter string="Delivered" name="delivered"
                        domain="[('state', '=', 'delivered')]"/>
                <filter string="Cancelled" name="cancelled"
                        domain="[('state', '=', 'cancelled')]"/>

                <separator/>
                <filter string="Delivery Order" name="type_do"
                        domain="[('instruction_type', '=', 'delivery_order')]"/>
                <filter string="Arrival Notice" name="type_an"
                        domain="[('instruction_type', '=', 'arrival_notice')]"/>

                <separator/>
                <filter string="Issue Date" name="filter_issue_date"
                        date="issue_date"/>

                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type"
                            context="{'group_by': 'instruction_type'}"/>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="CS Order" name="group_cs_order"
                            context="{'group_by': 'cs_order_id'}"/>
                    <filter string="Consignee" name="group_consignee"
                            context="{'group_by': 'consignee_id'}"/>
                    <filter string="Issue Date" name="group_issue_date"
                            context="{'group_by': 'issue_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cs_shipping_document" model="ir.actions.act_window">
        <field name="name">Shipping Documents</field>
        <field name="res_model">cs.shipping.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cs_shipping_document_search"/>
        <field name="context">{'search_default_group_type': 1}</field>
    </record>
</odoo>