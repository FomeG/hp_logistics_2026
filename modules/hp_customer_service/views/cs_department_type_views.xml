<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Action mở tree view -->
    <record id="action_cs_department_type" model="ir.actions.act_window">
        <field name="name">Department Types</field>
        <field name="res_model">cs.department.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Tree view -->
    <record id="view_cs_department_type_tree" model="ir.ui.view">
        <field name="name">cs.department.type.list</field>
        <field name="model">cs.department.type</field>
        <field name="arch" type="xml">
            <list string="Department Types">
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_cs_department_type_form" model="ir.ui.view">
        <field name="name">cs.department.type.form</field>
        <field name="model">cs.department.type</field>
        <field name="arch" type="xml">
            <form string="Department Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
