<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cs_task_list" model="ir.ui.view">
        <field name="name">cs.task.list</field>
        <field name="model">cs.task</field>
        <field name="arch" type="xml">
            <list string="CS Tasks">
                <field name="name"/>
                <field name="cs_order_id"/>
                <field name="booking_id"/>
            </list>
        </field>
    </record>

    <record id="view_cs_task_form" model="ir.ui.view">
        <field name="name">cs.task.form</field>
        <field name="model">cs.task</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="string">CS Task</attribute>
            </xpath>
             <!-- Remove project task specific buttons -->
<!--            <xpath expr="//button[@name='action_open_share_project_wizard']" position="replace"/>-->
<!--            <xpath expr="//button[@name='action_view_tasks']" position="replace"/>-->
<!--            <xpath expr="//button[@name='project_update_all_action']" position="replace"/>-->
<!--            <xpath expr="//button[@name='action_customer_preview']" position="replace"/>-->
            <xpath expr="//div[@name='button_box']" position="replace">
                <div class="oe_button_box" name="button_box">
                    <!-- add your custom buttons here -->
                </div>
            </xpath>
            <xpath expr="//sheet/group[1]" position="before">
                <group name="cs_task_info">
                    <field name="cs_order_id"/>
                    <field name="booking_id"/>
                    <!-- <field name="cs_task_id" invisible="1"/> -->
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_cs_task_search" model="ir.ui.view">
        <field name="name">cs.task.search</field>
        <field name="model">cs.task</field>
        <field name="arch" type="xml">
            <search string="Search CS Tasks">
                <field name="name"/>
                <field name="cs_order_id"/>

                <filter string="My Tasks" name="my_tasks" domain="[('user_ids', 'in', [uid])]"/>

                <group expand="0" string="Group By">
                    <filter string="CS Order" name="group_cs_order" context="{'group_by': 'cs_order_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cs_task" model="ir.actions.act_window">
        <field name="name">CS Tasks</field>
        <field name="res_model">cs.task</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cs_task_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new CS Task
            </p>
        </field>
    </record>

</odoo>