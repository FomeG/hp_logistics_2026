<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cs_pre_alert_list" model="ir.ui.view">
        <field name="name">cs.pre.alert.list</field>
        <field name="model">cs.pre.alert</field>
        <field name="arch" type="xml">
            <list string="Pre Alerts">
                <field name="cs_order_id"/>
                <field name="agent_id"/>
                <field name="receiver_email"/>
                <field name="state" widget="badge"/>
                <field name="is_auto_send"/>
                <field name="sent_date"/>
            </list>
        </field>
    </record>

    <record id="view_cs_pre_alert_form" model="ir.ui.view">
        <field name="name">cs.pre.alert.form</field>
        <field name="model">cs.pre.alert</field>
        <field name="arch" type="xml">
            <form string="Pre Alert">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="cs_order_id"/>
                            <field name="booking_id"/>
                            <field name="agent_id"/>
                            <field name="receiver_email" widget="email"/>
                        </group>
                        <group>
                            <field name="is_auto_send"/>
                            <field name="sent_date"/>
                            <!-- <field name="cs_task_id"/> -->
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cs_pre_alert" model="ir.actions.act_window">
        <field name="name">Pre Alerts</field>
        <field name="res_model">cs.pre.alert</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>