<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record model="ir.module.category" id="module_category_hp_customer_service">
            <field name="name">HP Customer Service</field>
            <field name="description">HP Customer Service Department</field>
            <field name="sequence">7</field>
        </record>

        <!-- CS Member -->
        <record id="group_hp_customer_service_member" model="res.groups">
            <field name="name">Member</field>
            <field name="category_id" ref="module_category_hp_customer_service"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">CS Member can create and manage jobs in their department</field>
        </record>

        <!-- CS Leader -->
        <record id="group_hp_customer_service_leader" model="res.groups">
            <field name="name">Leader</field>
            <field name="category_id" ref="module_category_hp_customer_service"/>
            <field name="implied_ids" eval="[(4, ref('group_hp_customer_service_member'))]"/>
            <field name="comment">CS Leader can manage all jobs across departments</field>
            <field name="users" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
        </record>
    </data>
</odoo>