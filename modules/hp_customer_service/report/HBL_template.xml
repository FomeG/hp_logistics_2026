<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_HBL_bill">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="job">
                <div style="padding:20px; font-family:Arial, Helvetica, sans-serif; font-size:12px;">

                    <!-- Header -->
                    <div style="display:flex; justify-content:space-between; align-items:flex-start; border-bottom:1px solid #000; padding-bottom:10px;">
                        <div>
                            <h3 style="margin:0;">HPS LOGISTICS SERVICE</h3>
                        </div>
                        <div style="text-align:right;">
                            <h1 style="color:red; margin:0; font-size:24px;">Bill of Lading</h1>
                            <p><b>Booking No.:</b> <t t-esc="job.booking_number or '250075682'"/></p>
                            <p><b>B/L No.:</b> <t t-esc="job.job_number or 'HNOSE25093792'"/></p>
                            <p>For the carrier or his authorised agent</p>
                        </div>
                    </div>

                    <!-- Main Info -->
                    <div style="margin-top:20px; display:grid; grid-template-columns:1fr 1fr; gap:20px;">
                        <div>
                            <p><b>Shipper / Exporter:</b></p>
                            <p><t t-esc="job.booking_party or 'AN TRUONG SON PRODUCTION COMPANY LIMITED, LANG CHE VILLAGE, CHO MOI COMMUNE, THAI NGUYEN PROVINCE, VIET NAM'"/></p>
                        </div>
                        <div>
                            <p><b>Consignee / Order:</b></p>
                            <p><t t-esc="job.department or 'TO THE ORDER OF BUSAN BANK'"/></p>
                        </div>
                        <div>
                            <p><b>Notify Party:</b></p>
                            <p><t t-esc="job.commodity or 'SH TIMBER CO., LTD, 59, GADAL 1-RO, GANGSEO-GU, BUSAN, SOUTH KOREA'"/></p>
                        </div>
                        <div>
                            <p><b>Received by the Carrier:</b></p>
                            <p>Received by the Carrier the Goods as specified above in apparent external good order and conditions unless otherwise stated, to be transported to such place as agreed, authorised or permitted herein and subject to all the terms and conditions appearing on the front and reverse side of this Bill of Lading to which the merchant agrees by accepting this Bill of Lading in any local privileges and customs notwithstanding.</p>
                        </div>
                    </div>

                    <!-- Vessel and Ports Info -->
                    <div style="margin-top:20px;">
                        <table style="width:100%; border-collapse:collapse;">
                            <tr>
                                <td><b>Pre-carriage vessel and Voy. No.</b></td>
                                <td><t t-esc="job.pre_carriage_vessel or ''"/> | <t t-esc="job.pre_carriage_voy or ''"/></td>
                                <td><b>Place of receipt (*)</b></td>
                                <td><t t-esc="job.port_receipt or 'HAI PHONG PORT, VIETNAM'"/></td>
                            </tr>
                            <tr>
                                <td><b>Ocean vessel and Voy. No.</b></td>
                                <td><t t-esc="job.vessel or 'MAERSK NARVIK 536N'"/> | <t t-esc="job.voyage or ''"/></td>
                                <td><b>Port of loading</b></td>
                                <td><t t-esc="job.port_loading or 'HAI PHONG PORT, VIETNAM'"/></td>
                            </tr>
                            <tr>
                                <td><b>Port of discharge</b></td>
                                <td><t t-esc="job.port_discharge or 'BUSAN, SOUTH KOREA'"/></td>
                                <td><b>Place of delivery (*)</b></td>
                                <td><t t-esc="job.port_delivery or 'BUSAN, SOUTH KOREA'"/></td>
                            </tr>
                        </table>
                    </div>

                    <!-- Container / Details -->
                    <div style="margin-top:20px;">
                        <h4>Container Information</h4>
                        <table style="width:100%; border-collapse:collapse;" border="1">
                            <thead style="background:#eee;">
                                <tr>
                                    <th>Container No</th>
                                    <th>Description</th>
                                    <th>Weight (KGS)</th>
                                    <th>Volume (CBM)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="job.detail_ids" t-as="line">
                                    <tr>
                                        <td><t t-esc="line.container_no"/></td>
                                        <td><t t-esc="line.description"/></td>
                                        <td><t t-esc="line.weight"/></td>
                                        <td><t t-esc="line.volume"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <!-- Footer -->
                    <div style="margin-top:20px; text-align:right;">
                        <p><b>In Witness whereof:</b> One original Bill of Lading has been signed. If not otherwise stated above, the same being accomplished the other(s), if any, to be void, if required by the carrier one (1) original Bill of Lading must be surrendered duly endorsed in exchange for the Goods or Delivery Order.</p>
                        <p><b>Jurisdiction:</b> All disputes relating to goods carried under this bill are to be dealt with in accordance with the jurisdiction clause, clause ..... on the reverse side of this bill.</p>
                        <p><b>Forwarding Agent - References:</b></p>
                        <p>UNIVERSAL SEA and AIR CO., LTD, 63, JUNGANG-DAERO, JUNG-GU, BUSAN, KOREA</p>
                        <p>EMAIL: MSCHOI@UNIVSA.COM; JWYOO@UNIVSA.COM</p>
                    </div>

                    <div style="margin-top:20px;">
                        <p><b>Issued at:</b> Hanoi</p>
                        <p><b>Date:</b> <t t-esc="job.job_date or 'September 11, 2025'"/></p>
                        <p><b>As Agent for the Carrier:</b> <t t-esc="job.carrier or 'MAERSK'"/></p>
                    </div>
                </div>
