            <p><b>Tên ngân hàng:</b> Vietcombank Sở giao dịch</p>
        </td>
    </tr>
</table>

<!-- Chữ ký -->
<table style="width:100%; margin-top:30px; font-size:12px; border:none;">
    <tr>
        <td style="width:50%; text-align:center; font-weight:bold;">
            ĐẠI DIỆN CÔNG TY TNHH CHÈ PHÚ HÒA
        </td>
        <td style="width:50%; text-align:center; font-weight:bold;">
            ĐẠI DIỆN CÔNG TY HP
        </td>
    </tr>
</table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
