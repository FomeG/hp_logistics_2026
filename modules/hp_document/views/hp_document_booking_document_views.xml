<odoo>
    <!-- add documents into booking page-->
    <record id="view_freight_booking_form_inherit_docs" model="ir.ui.view">
        <field name="name">freight.purchase.booking.form.inherit.documents</field>
        <field name="model">freight.purchase.booking</field>
        <field name="inherit_id" ref="hp_freight_purchase.freight_purchase_booking_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Documents">
                    <field name="attachment_ids" domain="[('booking_id', '=', id)]">
                        <list>
                            <field name="name"/>
                            <field name="document_type"/>
                            <field name="create_uid"/>
                            <field name="create_date"/>
                        </list>
                        <form string="Document">
                            <sheet>
                                <group>
                                    <field name="name"/>
                                    <field name="document_type" required="True"/>
                                    <field name="booking_id"/>
                                    <field name="create_uid" readonly="1" invisible="not id"/>
                                    <field name="create_date" readonly="1" invisible="not id"/>
                                </group>
                                <group>
                                    <field name="datas" filename="name"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- all documents related to booking -->
    <record id="view_hp_document_booking_list_view" model="ir.ui.view">
        <field name="name">ir.attachment.hp.document.booking.list</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="document_type"/>
                <field name="booking_id"/>
                <field name="create_uid"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_upload_file_list_view" model="ir.ui.view">
        <field name="name">ir.attachment.hp.document.upload.file.list</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="department"/>
                <field name="create_uid"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Action to open the booking document list -->
    <record id="action_hp_document_booking" model="ir.actions.act_window">
        <field name="name">All Documents</field>
        <field name="res_model">ir.attachment</field>
        <field name="view_mode">list</field>
        <field name="domain">[('booking_id', '!=', False)]</field>
        <field name="view_id" ref="view_hp_document_booking_list_view"/>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No documents yet. Upload booking files, invoices, BL drafts, etc.
            </p>
        </field>
    </record>

    <record id="action_hp_document_upload" model="ir.actions.act_window">
        <field name="name">All Documents</field>
        <field name="res_model">ir.attachment</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_upload_file_list_view"/>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No documents yet. Upload booking files, invoices, BL drafts, etc.
            </p>
        </field>
    </record>

    <menuitem id="hp_document_booking_menu"
              name="Documents"
              parent="hp_freight_purchase.menu_purchase_root"
              sequence="40"
              action="action_hp_document_booking"/>

    <menuitem id="menu_document_root"
            name="Documents"
            groups=""
            sequence="99"
    />
    <menuitem id="menu_listing_view"
              name="Listing"
              parent="menu_document_root"
              action="action_hp_document_upload"
              sequence="1"
    />
    <menuitem id="menu_show_all_files_view"
              name="Show All Files"
              action="action_hp_document_upload"
              parent="menu_listing_view"
              sequence="1"
    />
</odoo>
