<odoo>
    <record id="view_department_list" model="ir.ui.view">
        <field name="name">department.list</field>
        <field name="model">hp.department</field>
        <field name="arch" type="xml">
            <list editable="top" default_order="id desc">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="action_hp_department" model="ir.actions.act_window">
        <field name="name">Department</field>
        <field name="res_model">hp.department</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_department_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No documents yet. Upload booking files, invoices, BL drafts, etc.
            </p>
        </field>
    </record>
    <menuitem id="menu_department_view"
              name="Department"
              parent="menu_document_root"
              sequence="2"
              action="action_hp_department"
    />
</odoo>
