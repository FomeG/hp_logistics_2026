<odoo>
    <record id="view_upload_file_list_view" model="ir.ui.view">
        <field name="name">ir.attachment.hp.document.upload.file.list</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="department"/>
                <field name="create_uid"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_upload_file_form_view_inherit" model="ir.ui.view">
        <field name="name">ir.attachment.hp.document.upload.file.form.inherit</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mimetype']" position="after">
                <field name="document_type"/>
            </xpath>
        </field>
    </record>

    <record id="view_upload_file_search" model="ir.ui.view">
        <field name="name">upload.file.search</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_search"/>
        <field name="arch" type="xml">
        <field name="type" position="after">
            <field name="res_model" string="Model"/>
        </field>
        <filter name="creation_month" position="after">
            <filter name="res_model" context="{'group_by':'res_model'}"/>
        </filter>
        </field>
    </record>


    <record id="action_hp_document_upload" model="ir.actions.act_window">
        <field name="name">All Files Uploaded</field>
        <field name="res_model">ir.attachment</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_upload_file_list_view"/>
        <field name="context">{'create': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No documents yet. Upload booking files, invoices, BL drafts, etc.
            </p>
        </field>
    </record>

    <menuitem id="menu_document_root"
            name="Documents"
            groups=""
            sequence="99"
    />
    <menuitem id="menu_listing_view"
              name="Listing"
              parent="menu_document_root"
              action="action_hp_document_upload"
              sequence="1"
    />
    <menuitem id="menu_show_all_files_view"
              name="Show All Files"
              action="action_hp_document_upload"
              parent="menu_listing_view"
              sequence="1"
    />
</odoo>