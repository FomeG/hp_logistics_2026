<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="hp_document_file_preview_modal">
        <div class="modal o_modal_full o_file_preview_modal" tabindex="-1" role="dialog" style="display:block;">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title o_file_preview_modal_title"/>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="$('.modal.o_file_preview_modal').remove();">
                            <span aria-hidden="true">×</span>
                        </button>
                    </div>
                    <div class="modal-body o_file_preview_content" style="text-align:center;">
                        <!-- File content will be injected here by JS -->
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>