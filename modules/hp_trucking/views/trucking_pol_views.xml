<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="trucking_pol_form_view" model="ir.ui.view">
        <field name="name">trucking.pol.form</field>
        <field name="model">trucking.pol</field>
        <field name="arch" type="xml">
            <form class="oe_form_configuration">
                <sheet>
                    <div class="oe_title">
                        <label for="pol_name" string="Place Of Loading"/>
                        <h1><field name="pol_name" placeholder="e.g. HCM"/></h1>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="trucking_pol_list_view" model="ir.ui.view">
        <field name="name">trucking.pol.list</field>
        <field name="model">trucking.pol</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Place Of Loading">
                <field name="pol_name" string="Place Of Loading"/>
            </list>
        </field>
    </record>

    <record id="trucking_pol_search_view" model="ir.ui.view">
        <field name="name">trucking.pol.search</field>
        <field name="model">trucking.pol</field>
        <field name="arch" type="xml">
            <search string="Place Of Loading">
                <field name="pol_name" string="Place Of Loading"/>
            </search>
        </field>
    </record>

    <record id="trucking_pol_action_form" model="ir.actions.act_window">
        <field name="name">Place Of Loading</field>
        <field name="res_model">trucking.pol</field>
        <field name="search_view_id" ref="trucking_pol_search_view"/>
        <field name="view_id" ref="trucking_pol_list_view"/>
    </record>

</odoo>
