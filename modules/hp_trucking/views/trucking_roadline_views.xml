<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="trucking_roadline_list_view" model="ir.ui.view">
        <field name="name">trucking.roadline.list</field>
        <field name="model">trucking.roadline</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Roadline List">
                <field name="roadline_name" string="Roadline"/>
                <field name="pol_id" string="Port of Loading"/>
                <field name="pod_id" string="Port of Discharge"/>
            </list>
        </field>
    </record>

    <record id="trucking_roadline_search_view" model="ir.ui.view">
        <field name="name">trucking.roadline.search</field>
        <field name="model">trucking.roadline</field>
        <field name="arch" type="xml">
            <search string="Roadline List">
                <field name="roadline_name" string="Roadline"/>
                <field name="pol_id" string="Port of Loading"/>
                <field name="pod_id" string="Port of Discharge"/>
            </search>
        </field>
    </record>

    <record id="trucking_roadline_action_form" model="ir.actions.act_window">
        <field name="name">Roadline List</field>
        <field name="res_model">trucking.roadline</field>
        <field name="search_view_id" ref="trucking_roadline_search_view"/>
        <field name="view_id" ref="trucking_roadline_list_view"/>
    </record>

</odoo>
