<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="trucking_pod_form_view" model="ir.ui.view">
        <field name="name">trucking.pod.form</field>
        <field name="model">trucking.pod</field>
        <field name="arch" type="xml">
            <form class="oe_form_configuration">
                <sheet>
                    <div class="oe_title">
                        <label for="pod_name" string="Place Of Discharge"/>
                        <h1><field name="pod_name" placeholder="e.g. Ha Noi"/></h1>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="trucking_pod_list_view" model="ir.ui.view">
        <field name="name">trucking.pod.list</field>
        <field name="model">trucking.pod</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Place Of Discharge">
                <field name="pod_name" string="Place Of Discharge"/>
            </list>
        </field>
    </record>

    <record id="trucking_pod_search_view" model="ir.ui.view">
        <field name="name">trucking.pod.search</field>
        <field name="model">trucking.pod</field>
        <field name="arch" type="xml">
            <search string="Place Of Discharge">
                <field name="pod_name" string="Place Of Discharge"/>
            </search>
        </field>
    </record>

    <record id="trucking_pod_action_form" model="ir.actions.act_window">
        <field name="name">Place Of Discharge</field>
        <field name="res_model">trucking.pod</field>
        <field name="search_view_id" ref="trucking_pod_search_view"/>
        <field name="view_id" ref="trucking_pod_list_view"/>
    </record>

</odoo>
