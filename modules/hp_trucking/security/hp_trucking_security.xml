<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record model="ir.module.category" id="module_category_hp_trucking">
            <field name="name">Trucking Department</field>
            <field name="description">trucking Department</field>
            <field name="sequence">5</field>
        </record>

        <!-- trucking teams -->
        <record id="group_hp_trucking_member" model="res.groups">
            <field name="name">Trucking Member</field>
            <field name="category_id" ref="module_category_hp_trucking"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_hp_trucking_lead" model="res.groups">
            <field name="name">Trucking Lead</field>
            <field name="category_id" ref="module_category_hp_trucking"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Director -->
        <record id="group_hp_trucking_director" model="res.groups">
            <field name="name">Trucking Director</field>
            <field name="category_id" ref="module_category_hp_trucking"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Administrator -->
        <record id="group_hp_trucking_administrator" model="res.groups">
            <field name="name">Trucking Administrator</field>
            <field name="category_id" ref="module_category_hp_trucking"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Rules for trucking member -->
        <record id="rule_trucking_lead_director_admin_access" model="ir.rule">
            <field name="name">Admin, CEO, leader to access All trucking Products</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="groups" eval="[
                (4, ref('group_hp_trucking_lead')),
                (4, ref('group_hp_trucking_director')),
                (4, ref('group_hp_trucking_administrator'))
            ]"/>
            <field name="domain_force">[('type', '=', 'trucking')]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>


        <record id="rule_trucking_member_region_access" model="ir.rule">
            <field name="name">Trucking Member Access By Region</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="groups" eval="[(4, ref('group_hp_trucking_member'))]"/>
            <field name="domain_force">
                [
                    ('type', '=', 'trucking'),
                    ('sealine_id.pod_id.region_id', '=', user.region_id.id)
                ]
            </field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Rules for other users than trucking -->
        <record id="rule_product_general_access" model="ir.rule">
            <field name="name">Product General Access</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('type', '!=', 'trucking')]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>